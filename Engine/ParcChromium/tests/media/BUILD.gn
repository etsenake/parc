# Installed at //media/parc_tests so media_unittests can link Parc's owned
# regression suites without exposing media internals to another layer.

assert(is_mac)

source_set("media_tests") {
  visibility = [ "//media:*" ]
  testonly = true
  sources = [
    "audio_renderer_impl_test.cc",
    "audio_toolbox_amr_test.cc",
    "box_definitions_test.cc",
    "chunk_demuxer_test.cc",
    "ffmpeg_demuxer_test.cc",
    "mp2t_stream_parser_test.cc",
    "mp4_stream_parser_test.cc",
    "pipeline_impl_test.cc",
    "renderer_controller_test.cc",
    "stream_parser_factory_test.cc",
    "video_decoder_config_mojom_traits_test.cc",
    "video_renderer_impl_test.cc",
    "source_buffer_state_test.cc",
    "source_buffer_stream_test.cc",
  ]

  configs += [ "//media:media_config" ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//media",
    "//media:test_support",
    "//media/mojo/mojom",
    "//media/mojo/mojom:remoting",
    "//media/remoting:media_remoting_tests",
    "//media/remoting:remoting_sender",
    "//mojo/public/cpp/bindings",
    "//ui/gfx",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

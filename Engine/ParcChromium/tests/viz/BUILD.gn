    "//components/viz/test:test_support",
    "//gpu/command_buffer/client",
    "//gpu/command_buffer/client:raster_interface",
    "//gpu/ipc:gl_in_process_context",
    "//gpu/ipc/service",
    "//media",
    "//media:test_support",
    "//services/viz/public/mojom",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/display/types",
    "//ui/gfx:test_support",
    "//ui/gfx/animation/keyframe",
    "//ui/gl",

# Copyright 2026 Parc contributors.
# Parc's engine framework, built directly on Chromium's chrome/ layer. Bundle
# name, identifier and Versions/A layout are unchanged from the CEF engine:
# code signing, the Keychain and installed copies depend on them.

import("//build/apple/tweak_info_plist.gni")
import("//build/buildflag_header.gni")
import("//build/config/mac/rules.gni")
import("//chrome/version.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//parc/features.gni")
import("//third_party/icu/config.gni")
import("//tools/v8_context_snapshot/v8_context_snapshot.gni")
import("//ui/gl/features.gni")
import("//v8/gni/v8.gni")

assert(is_mac)

_framework_name = "Chromium Embedded Framework"

buildflag_header("buildflags") {
  header = "features.h"
  flags = [ "ENABLE_PARC=$enable_parc" ]
}

mojom("mojom") {
  sources = [ "common/mojom/parc_theme.mojom" ]
  generate_js = false
  public_deps = [
    "//mojo/public/mojom/base",
    "//third_party/blink/public/mojom/tokens",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/website_theme_agent.cc",
    "renderer/website_theme_agent.h",
  ]
  deps = [
    ":mojom",
    "//base",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
  ]
}


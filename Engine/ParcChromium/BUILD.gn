assert(is_mac)

_framework_name = "Chromium Embedded Framework"

buildflag_header("buildflags") {
  header = "features.h"
  flags = [ "ENABLE_PARC=$enable_parc" ]
}

mojom("mojom") {
  sources = [ "common/mojom/parc_theme.mojom" ]
  generate_js = false
  public_deps = [
    "//mojo/public/mojom/base",
    "//third_party/blink/public/mojom/tokens",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/error_page_history.cc",
    "renderer/error_page_history.h",
    "renderer/website_theme_agent.cc",
    "renderer/website_theme_agent.h",
  ]
  deps = [
    ":mojom",
    "//base",
    "//content/public/common",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
  ]
}

action("internal_extension_manifest") {
  script = "generate_internal_extension.py"
  sources = [ "internal_extension/manifest.json" ]
  outputs = [ "$target_gen_dir/internal_extension_manifest.h" ]
  args = [ rebase_path(sources[0], root_build_dir),
           rebase_path(outputs[0], root_build_dir) ]
}

_error_pages_source = "$target_gen_dir/error_pages.cc"

action("error_pages") {
  script = "generate_error_pages.py"
  inputs = [
    "error_pages/art/barricade.svg",
    "error_pages/art/blocked-page.svg",
    "error_pages/art/lock-badge.svg",
    "error_pages/art/plane.svg",
    "error_pages/art/plug.svg",
    "error_pages/art/signpost.svg",
    "error_pages/art/snail.svg",
    "error_pages/display-font.woff.b64",
    "error_pages/interstitial.css",
    "error_pages/interstitial.js",
    "error_pages/neterror.css",
    "error_pages/neterror.html",
    "error_pages/neterror.js",
    "error_pages/webapp.css",
  ]
  outputs = [ _error_pages_source ]
  args = [
    "--source",
    rebase_path("error_pages", root_build_dir),
    "--output",
    rebase_path(_error_pages_source, root_build_dir),
  ]
}

_product_name_header = "$root_gen_dir/parc/product_name_strings.h"
_product_name_source = "$root_gen_dir/parc/product_name_strings.cc"
_product_name_grit_python_inputs =
    filter_exclude(read_file("//tools/grit/grit.pydeps", "list lines"), [ "#*" ])

action("product_name_strings") {
  script = "generate_product_name_strings.py"
  inputs = _product_name_grit_python_inputs + [
    "//tools/grit/grit.pydeps",
    grit_resource_id_file,
    grit_predetermined_resource_ids_file,
  ]
  outputs = [
    _product_name_header,
    _product_name_source,
  ]
  depfile = "$target_gen_dir/product_name_strings.d"
  args = [
    "--source-root",
    rebase_path("//", root_build_dir),
    "--header",
    rebase_path(_product_name_header, root_build_dir),
    "--source",
    rebase_path(_product_name_source, root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
    "--branding",
    rebase_path("//tools/grit/grit/parc_branding.py", root_build_dir),
    "--resource-ids",
    rebase_path(grit_resource_id_file, root_build_dir),
    "--predetermined-ids",
    rebase_path(grit_predetermined_resource_ids_file, root_build_dir),
  ]
  foreach(locale, platform_pak_locales) {
    args += [
      "--locale",
      locale,
    ]
  }
  deps = [ grit_resource_id_target ]
}

bundle_data("internal_extension_resources") {
  sources = [ "internal_extension/manifest.json", "internal_extension/background.js" ]
  outputs = [ "{{bundle_resources_dir}}/parc_internal_extension/{{source_file_part}}" ]
}

source_set("page_preferences") {
  sources = [ "page_preferences.cc", "page_preferences.h" ]
  deps = [ "//base", "//content/public/browser", "//third_party/blink/public/common" ]
}

source_set("page_preferences_tests") {
  testonly = true
  sources = [ "page_preferences_unittest.cc" ]
  deps = [ ":page_preferences", "//content/public/browser", "//content/public/common", "//content/test:test_support", "//parc/tests/parc_native_private_sessions:unit_tests", "//testing/gtest", "//third_party/blink/public/common" ]
}


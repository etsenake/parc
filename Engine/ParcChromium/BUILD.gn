tweak_info_plist("parc_framework_plist") {
  info_plist = "framework-Info.plist"
  args = [
    "--breakpad=0",
    "--keystone=0",
    "--scm=1",
    "--version",
    chrome_version_full,
    "--branding",
    _framework_name,
  ]
}

bundle_data("parc_framework_resources") {
  sources = [ "//ui/gl/resources/angle-metal/gpu_shader_cache.bin" ]
  public_deps = []
  if (icu_use_data_file) {
    sources += [ "$root_out_dir/icudtl.dat" ]
    public_deps += [ "//third_party/icu:icudata" ]
  }
  if (v8_use_external_startup_data) {
    public_deps += [ "//v8" ]
    if (use_v8_context_snapshot) {
      sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
      public_deps += [ "//tools/v8_context_snapshot" ]
    }
    if (!use_v8_context_snapshot || include_both_v8_snapshots) {
      sources += [ "$root_out_dir/snapshot_blob.bin" ]
    }
  }
  outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
}

bundle_data("parc_framework_swiftshader_binaries") {
  sources = [
    "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
    "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
  ]
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  public_deps = [ "//ui/gl:swiftshader_vk_library_copy" ]
}

bundle_data("parc_framework_vulkan_binaries") {
  sources = [ "$root_out_dir/vulkan_intermediates/libvulkan.dylib" ]
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  public_deps = [ "//ui/gl:vulkan_loader_library_copy" ]
}

if (!use_static_angle) {
  bundle_data("parc_framework_angle_binaries") {
    sources = [
      "$root_out_dir/egl_intermediates/libEGL.dylib",
      "$root_out_dir/egl_intermediates/libGLESv2.dylib",
    ]
    outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
    public_deps = [ "//ui/gl:angle_library_copy" ]
  }
}

bundle_data("parc_framework_aperitif_library") {
  sources = [ "$root_out_dir/libaperitif.dylib" ]
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  public_deps = [ "//content/public/app:aperitif" ]
}

mac_framework_bundle("parc_framework") {
  output_name = _framework_name
  framework_version = "A"
  framework_contents = [
    "Libraries",
    "Resources",
  ]
  info_plist_target = ":parc_framework_plist"

  deps = [
    ":internal_extension_resources",
    ":browser",
    ":parc_framework_aperitif_library",
    ":parc_framework_resources",
    ":parc_framework_swiftshader_binaries",
    ":parc_framework_vulkan_binaries",
  ]
  if (!use_static_angle) {
    deps += [ ":parc_framework_angle_binaries" ]
  }

  ldflags = [
    "-Wl,-install_name,@executable_path/../Frameworks/$output_name.framework/$output_name",
    "-compatibility_version",
    chrome_dylib_version,
    "-current_version",
    chrome_dylib_version,
  ]
  if (is_component_build) {
    ldflags += [
      "-rpath",
      "@loader_path/../../../../../..",
    ]
  } else {
    ldflags += [ "-Wcrl,installnametool,-change,@executable_path/../Frameworks/$chrome_product_full_name Framework.framework/Versions/$chrome_version_full/Libraries/libaperitif.dylib,@loader_path/Libraries/libaperitif.dylib" ]
  }
}

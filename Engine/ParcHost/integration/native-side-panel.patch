+
+std::shared_ptr<ExtensionViewHost>
+ExtensionSidePanelCoordinator::AcquireNativeHost(base::OnceClosure close) {
+  auto* browser = GetBrowser();
+  auto* ui = browser ? SidePanelUI::From(browser) : nullptr;
+  if (!ui || !ui->UsesNativeExtensionContent() || !close || !GetEntry() ||
+      host_ || !delegate_)
+    return nullptr;
+  auto weak = weak_factory_.GetWeakPtr();
+  auto host = delegate_->CreateHost(side_panel_url_);
+  if (!weak || !host)
+    return nullptr;
+  host_ = std::move(host);
+  native_request_close_ = std::move(close);
+  scoped_host_observation_.Observe(host_.get());
+  host_->SetCloseHandler(base::BindOnce(
+      &ExtensionSidePanelCoordinator::HandleCloseExtensionSidePanel,
+      weak_factory_.GetWeakPtr()));
+  return host_;
+}
+
+void ExtensionSidePanelCoordinator::ReleaseNativeHost(
+    ExtensionViewHost* expected) {
+  if (host_.get() != expected)
+    return;
+  native_request_close_.Reset();
+  scoped_host_observation_.Reset();
+  auto retiring_host = std::move(host_);
+  const bool was_active = std::exchange(is_panel_active_, false);
+  if (was_active)
+    OnClosed();
+}

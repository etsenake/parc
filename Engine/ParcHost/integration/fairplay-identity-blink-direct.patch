+void CrossThreadMediaSourceAttachment::ParcNotifyEndedWithError(
+    MediaSourceTracer* /* tracer */,
+    bool network_error) {
+  attachment_state_lock_.AssertAcquired();
+
+  // Must only occur while attachment is "alive".
+  VerifyCalledWhileContextsAliveForDebugging();
+
+  // Called only by the MSE API on worker thread.
+  DCHECK(!IsMainThread());
+  DCHECK(worker_runner_->BelongsToCurrentThread());
+  DCHECK(main_runner_);
+
+  // As WebKit's MediaSource::ensureWeakOnHTMLMediaElementContext from a
+  // worker, the element's failure steps run in a main thread task, and the
+  // detach they start returns to the worker in another.
+  PostCrossThreadTask(
+      *main_runner_, FROM_HERE,
+      CrossThreadBindOnce(
+          &CrossThreadMediaSourceAttachment::
+              ParcNotifyEndedWithErrorOnMainThread,
+          blink::RetainedRef(this), network_error));
+}
+
+void CrossThreadMediaSourceAttachment::ParcNotifyEndedWithErrorOnMainThread(
+    bool network_error) {
+  HTMLMediaElement* element = nullptr;
+  {
+    base::AutoLock lock(attachment_state_lock_);
+    DCHECK(IsMainThread());
+    DCHECK(main_runner_->BelongsToCurrentThread());
+
+    // The element may have begun detachment, or its context may have been
+    // destroyed, while this task was queued.
+    if (have_ever_started_closing_ || media_element_context_destroyed_) {
+      return;
+    }
+    DCHECK(attached_element_);
+    element = attached_element_.Get();
+  }
+
+  // Outside the lock: the failure steps call OnElementError() and Close().
+  element->ParcMediaSourceEndedWithError(network_error);
 }

+// As WebKit's Document::contextDocument (DOMImplementation::createHTMLDocument,
+// a template's content): a document without a frame runs in the window that
+// made it, and an element there keeps its player in that window's frame.
+Document* ParcContextDocument(Document& document) {
+  if (document.GetFrame()) {
+    return &document;
+  }
+  auto* window = DynamicTo<LocalDOMWindow>(document.GetExecutionContext());
+  return window && window->GetFrame() ? window->document() : nullptr;
+}
+
+// The Parc operations of `player`, or null without a player or without them.

+
+void PictureInPictureControllerImpl::OnTextTrackDisplayChanged() {
+  // Paints after the cue boxes are laid out, once however many cues changed.
+  if (captions_update_pending_ || !picture_in_picture_session_.is_bound()) {
+    return;
+  }
+  captions_update_pending_ = true;
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kMediaElementEvent)
+      ->PostTask(FROM_HERE,
+                 BindOnce(&PictureInPictureControllerImpl::UpdateCaptions,
+                          WrapWeakPersistent(this)));
+}
+
+void PictureInPictureControllerImpl::UpdateCaptions() {
+  captions_update_pending_ = false;
+  LocalFrame* frame = GetSupplementable()->GetFrame();
+  if (!frame || !frame->GetPage() || !picture_in_picture_element_ || !picture_in_picture_window_ ||
+      !picture_in_picture_session_.is_bound()) {
+    return;
+  }
+  gfx::RectF bounds;
+  SkBitmap captions =
+      picture_in_picture_element_->PaintTextTracksForPictureInPicture(
+          gfx::SizeF(picture_in_picture_window_->width(),
+                     picture_in_picture_window_->height()),
+          frame->GetPage()
+              ->GetChromeClient()
+              .GetScreenInfo(*frame)
+              .device_scale_factor,
+          bounds);
+  // Pages that draw their own captions get them shown too.
+  if (captions.drawsNothing() && page_captions_) {
+    captions = page_captions_->Paint(
+        gfx::SizeF(picture_in_picture_window_->width(),
+                   picture_in_picture_window_->height()),
+        frame->GetPage()
+            ->GetChromeClient()
+            .GetScreenInfo(*frame)
+            .device_scale_factor,
+        bounds);
+  }
+  if (captions.drawsNothing() && !showing_captions_) {
+    return;
+  }
+  showing_captions_ = !captions.drawsNothing();
+  picture_in_picture_session_->UpdateCaptions(captions, bounds);
+}
+
+void PictureInPictureControllerImpl::PageCaptionsTimerFired(TimerBase*) {
+  if (!GetSupplementable()->IsActive()) {
+    page_captions_timer_.Stop();
+    return;
+  }
+  if (page_captions_ && page_captions_->Update()) {
+    OnTextTrackDisplayChanged();
+  }
 }

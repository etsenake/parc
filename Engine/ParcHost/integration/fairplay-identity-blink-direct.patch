+ScriptPromise<MediaCapabilitiesDecodingInfo>
+MediaCapabilities::ParcSafariDecodingInfo(
+    ScriptState* script_state,
+    const MediaDecodingConfiguration* config,
+    ExceptionState& exception_state) {
+  auto* resolver = MakeGarbageCollected<
+      ScriptPromiseResolver<MediaCapabilitiesDecodingInfo>>(
+      script_state, exception_state.GetContext());
+  auto promise = resolver->Promise();
+  if (parc_video_toolbox_facts_) {
+    OnParcVideoToolboxFacts(resolver, config,
+                            parc_video_toolbox_facts_.Clone());
+    return promise;
+  }
+  ParcBindVideoToolbox(ExecutionContext::From(script_state));
+  // Answered without the facts if the browser can't give them.
+  parc_video_toolbox_->GetFacts(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      BindOnce(&MediaCapabilities::OnParcVideoToolboxFacts,
+               WrapPersistent(this), WrapPersistent(resolver),
+               WrapPersistent(config)),
+      media::mojom::blink::ParcVideoToolboxDecodingFactsPtr()));
+  return promise;
+}
+
+void MediaCapabilities::OnParcVideoToolboxFacts(
+    ScriptPromiseResolver<MediaCapabilitiesDecodingInfo>* resolver,
+    const MediaDecodingConfiguration* config,
+    media::mojom::blink::ParcVideoToolboxDecodingFactsPtr facts) {
+  if (facts && !parc_video_toolbox_facts_) {
+    parc_video_toolbox_facts_ = facts.Clone();
+  }
+  ExecutionContext* execution_context = resolver->GetExecutionContext();
+  if (!execution_context || execution_context->IsContextDestroyed()) {
+    return;
+  }
+  const std::optional<ParcDecodingAnswer> answer =
+      ParcSafariAnswer(config, facts.get());
+  // WebKit: with spatialRendering, `supported` then follows
+  // SpatialAudioPlaybackHelper, judged against the audio output device.
+  if (answer && config->hasAudio() &&
+      config->audio()->hasSpatialRendering() &&
+      config->audio()->spatialRendering()) {
+    ParcBindVideoToolbox(execution_context);
+    parc_video_toolbox_->GetSpatialAudioSources(
+        config->hasVideo(),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            BindOnce(&MediaCapabilities::OnParcSpatialAudioSources,
+                     WrapPersistent(this), WrapPersistent(resolver),
+                     WrapPersistent(config), answer->smooth,
+                     answer->power_efficient),
+            Vector<uint32_t>()));
+    return;
+  }
+  auto* info = MediaCapabilitiesDecodingInfo::Create();
+  info->setSupported(answer && answer->supported);
+  info->setSmooth(answer && answer->smooth);
+  info->setPowerEfficient(answer && answer->power_efficient);
+  resolver->Resolve(
+      ParcFinishDecodingInfo(info, execution_context, config, nullptr));
+}
+
+void MediaCapabilities::OnParcSpatialAudioSources(
+    ScriptPromiseResolver<MediaCapabilitiesDecodingInfo>* resolver,
+    const MediaDecodingConfiguration* config,
+    bool smooth,
+    bool power_efficient,
+    const Vector<uint32_t>& sources) {
+  ExecutionContext* execution_context = resolver->GetExecutionContext();
+  if (!execution_context || execution_context->IsContextDestroyed()) {
+    return;
+  }
+  // WebKit's AudioConfiguration channels, read with String::toDouble: leading
+  // spaces skipped, the number before any trailing junk, 0 without one.
+  const String channels =
+      config->audio()->hasChannels() ? config->audio()->channels() : String();
+  size_t parsed_length = 0;
+  const double channel_count =
+      channels.empty()
+          ? 0
+          : (channels.Is8Bit()
+                 ? CharactersToDouble(channels.Span8(), parsed_length)
+                 : CharactersToDouble(channels.Span16(), parsed_length));
+  auto* info = MediaCapabilitiesDecodingInfo::Create();
+  info->setSupported(IsParcSafariSpatialAudioSupported(
+      sources, channel_count));
+  info->setSmooth(smooth);
+  info->setPowerEfficient(power_efficient);
+  resolver->Resolve(
+      ParcFinishDecodingInfo(info, execution_context, config, nullptr));
+}
+
+void MediaCapabilities::ParcBindVideoToolbox(
+    ExecutionContext* execution_context) {
+  if (parc_video_toolbox_.is_bound()) {
+    return;
+  }
+  execution_context->GetBrowserInterfaceBroker().GetInterface(
+      parc_video_toolbox_.BindNewPipeAndPassReceiver(
+          execution_context->GetTaskRunner(TaskType::kMediaElementEvent)));
+}

+void HTMLMediaElement::ParcBeginAutoplay() {
+  SetPaused(false);
+  SetShowPosterFlag(false);
+  GetCueTimeline().InvokeTimeMarchesOn();
+  ScheduleNamedEvent(event_type_names::kPlay);
+  ParcScheduleNotifyPlayingAfterSeek();
+  can_autoplay_ = false;
+}
+
+DispatchEventResult HTMLMediaElement::DispatchEventInternal(Event& event) {
+  // WebKit's dispatchEvent: a gesture-unlocked element's ended briefly lets
+  // the document's other media play as if under that gesture.
+  if (event.type() == event_type_names::kEnded &&
+      parc_had_media_user_gesture_ && PresentsParcSafariIdentity()) {
+    AutoplayPolicy::ParcNoteUserActivatedMediaEnded(GetDocument());
+  }
+  return HTMLElement::DispatchEventInternal(event);
+}

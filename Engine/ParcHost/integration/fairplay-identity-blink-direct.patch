+void HTMLMediaElement::RequestHandlePlaybackControlsAction(
+    media_session::mojom::blink::PlaybackControlsAction action,
+    base::TimeDelta seek_time) {
+  using Action = media_session::mojom::blink::PlaybackControlsAction;
+  if (!PresentsParcSafariIdentity()) {
+    switch (action) {
+      case Action::kSeekTo: RequestSeekTo(seek_time); break;
+      case Action::kPauseForDragging: RequestPause(true); break;
+      case Action::kResumeForDragging: RequestPlay(true); break;
+      case Action::kBeginScrubbing:
+      case Action::kEndScrubbing: break;
+    }
+    return;
+  }
+  switch (action) {
+    case Action::kSeekTo:
+      setCurrentTime(seek_time.InSecondsF());
+      break;
+    case Action::kBeginScrubbing:
+    case Action::kPauseForDragging:
+      if (parc_scrubbing_playback_controls_)
+        return;
+      if (!paused_) {

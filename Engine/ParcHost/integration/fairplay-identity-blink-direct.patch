+bool HTMLMediaElement::ParcHasPlaybackTargetAvailabilityListeners() const {
+  return HasEventListeners(
+      event_type_names::kWebkitplaybacktargetavailabilitychanged);
+}
+
+// isWirelessPlaybackTargetDisabledChanged: listeners hear the change, the
+// last "available" taken back with one "not-available".
+void HTMLMediaElement::ParcWirelessPlaybackTargetDisabledChanged() {
+  if (!PresentsParcSafariIdentity()) {
+    return;
+  }
+  ParcOpenIfDeferredOpen();
+  const bool disabled = ParcWirelessPlaybackTargetDisabled();
+  if (disabled == parc_wireless_playback_target_disabled_) {
+    return;
+  }
+  parc_wireless_playback_target_disabled_ = disabled;
+  if (ParcHasPlaybackTargetAvailabilityListeners() &&
+      (!disabled || parc_last_availability_event_)) {
+    ParcEnqueuePlaybackTargetAvailabilityEvent(/*only_when_changed=*/false);
+  }
+  if (auto* parc = ParcExtension(web_media_player_.get())) {
+    parc->ParcSetWirelessVideoPlaybackDisabled(disabled);
+  }
+  ParcReportPlaybackTargetState();
+  ParcRemoteAvailabilityChanged();
+}
+
+void HTMLMediaElement::ParcEnqueuePlaybackTargetAvailabilityEvent(
+    bool only_when_changed) {
+  const bool has_targets =
+      !parc_wireless_playback_target_disabled_ && parc_has_playback_targets_;
+  if (only_when_changed && has_targets == parc_last_availability_event_) {
+    return;
+  }
+  parc_last_availability_event_ = has_targets;
+  auto* window = DynamicTo<LocalDOMWindow>(GetExecutionContext());
+  if (Event* event = window ? CreateParcPlaybackTargetAvailabilityEvent(
+                                  *window, has_targets)
+                            : nullptr) {
+    event->SetTarget(this);
+    ScheduleEvent(event);
+  }
+}

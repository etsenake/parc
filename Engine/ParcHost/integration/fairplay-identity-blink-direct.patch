+      }
+      UpdatePlayState(WebMediaPlayer::PauseReason::kPauseRequestedInternally);
+      break;
+    case Action::kEndScrubbing:
+    case Action::kResumeForDragging:
+      parc_scrubbing_playback_controls_ = false;
+      UpdatePlayState();
+      break;
+  }

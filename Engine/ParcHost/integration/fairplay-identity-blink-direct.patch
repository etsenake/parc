+// Parc: WebKit purges a ManagedMediaSource's SourceBuffers as memory pressure
+// rises (MemoryRelease::releaseNoncriticalMemory, then
+// HTMLMediaElement::purgeBufferedDataIfPossible and MediaSource::
+// memoryPressure), after the operation in progress, and not again until
+// playback has moved on (the PurgeResources buffering policy it sets lasts
+// until playback resumes). The script reports the change as bufferedchange,
+// and its streaming policy then asks for the data again.
+void SourceBuffer::ParcOnMemoryPressure(base::MemoryPressureLevel level) {
+  const bool rose = level > parc_memory_pressure_level_;
+  parc_memory_pressure_level_ = level;
+  if (rose) {
+    ParcPurge();
+  }
+}
+
+void SourceBuffer::ParcPurge() {
+  if (IsRemoved()) {
+    parc_purge_pending_ = false;
+    return;
+  }
+  if (updating_) {
+    // Runs as the append or removal completes (ParcRunPendingPurge()).
+    parc_purge_pending_ = true;
+    return;
+  }
+  parc_purge_pending_ = false;
+  source_->RunUnlessElementGoneOrClosingUs(
+      blink::BindOnce(&SourceBuffer::ParcPurge_Locked, WrapPersistent(this)));
+}
+
+void SourceBuffer::ParcPurge_Locked(
+    MediaSourceAttachmentSupplement::ExclusiveKey /* passkey */) {
+  ParcPurgeNow();
+}
+
+// Parc: a purge that waited for an append or removal runs as it completes,
+// after its update and updateend are queued, so a page that appends again
+// from updateend can't hold it off. The caller holds the attachment lock.
+void SourceBuffer::ParcRunPendingPurge() {
+  if (parc_purge_pending_) {
+    parc_purge_pending_ = false;
+    ParcPurgeNow();
+  }
+}
+
+void SourceBuffer::ParcPurgeNow() {
+  DCHECK(source_);
+  source_->AssertAttachmentsMutexHeldIfCrossThreadForDebugging();
+  if (source_->IsClosed()) {
+    return;
+  }
+  const double media_time = GetMediaTime();
+  if (std::isnan(media_time) || media_time == parc_purged_media_time_) {
+    return;
+  }
+  parc_purged_media_time_ = media_time;
+  web_source_buffer_->ParcPurgeForMemoryPressure(
+      media_time, source_->activeSourceBuffers()->Contains(this));
+  // A worker's source tells the media element's thread its new ranges.
+  source_->SendUpdatedInfoToMainThreadCache();
+  ScheduleEvent(AtomicString(kParcPurgedEvent));
+}
+
+void SourceBuffer::ParcStopMemoryPressure() {
+  parc_memory_pressure_listener_.reset();
+  parc_purge_pending_ = false;
 }

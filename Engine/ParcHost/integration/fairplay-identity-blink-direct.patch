+bool HTMLMediaElement::ParcPlaysToPlaybackTargets() const {
+  return PresentsParcSafariIdentity() && ParcSupportsPlaybackTarget();
+}
+
+// Only the native HLS player and a clear file's native route play to a
+// target. A Media Source element can't, but checkPlaybackTargetCompatibility
+// switches it to its <source> alternative.
+bool HTMLMediaElement::ParcSupportsPlaybackTarget() const {
+  return web_media_player_ &&
+         (ParcPlayerSupportsPlaybackTarget(web_media_player_.get()) ||
+          (GetLoadType() == WebMediaPlayer::kLoadTypeMediaSource &&
+           !parc_failed_to_play_to_wireless_target_ &&
+           ParcHasWirelessPlaybackTargetAlternative()));
+}
+
+// A <source> child with a URL that isn't blob:, while the element loads
+// from its <source> children. WebKit also asks isSafeToLoadURL, whose
+// Content Security Policy check would report here each time this is asked.
+bool HTMLMediaElement::ParcHasWirelessPlaybackTargetAlternative() const {
+  if (load_state_ != kLoadingFromSourceElement) {
+    return false;
+  }
+  for (HTMLSourceElement& source :
+       Traversal<HTMLSourceElement>::ChildrenOf(*this)) {
+    const KURL url = source.GetNonEmptyURLAttribute(html_names::kSrcAttr);
+    if (url.IsValid() && !url.ProtocolIs("blob")) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HTMLMediaElement::ParcDeferredMediaSourceOpenCanProgress() const {
+  return ParcWirelessPlaybackTargetDisabled() ||
+         ParcHasWirelessPlaybackTargetAlternative();
+}
+
+void HTMLMediaElement::ParcOpenIfDeferredOpen() {
+  if (parc_deferred_web_media_source_ && media_source_attachment_ &&
+      ParcDeferredMediaSourceOpenCanProgress()) {
+    media_source_attachment_->CompleteAttachingToMediaElement(
+        media_source_tracer_, std::move(parc_deferred_web_media_source_));
+  }
+}
+
+// checkPlaybackTargetCompatibility: an element playing to the target whose
+// player can't goes on to its next <source>, else stops playing to it.
+void HTMLMediaElement::ParcCheckPlaybackTargetCompatibility(TimerBase*) {
+  if (!parc_playing_to_wireless_target_ || !web_media_player_ ||
+      ParcPlayerSupportsPlaybackTarget(web_media_player_.get())) {
+    return;
+  }
+  if (!parc_remote_playback_time_ && load_state_ == kLoadingFromSourceElement &&
+      HavePotentialSourceChild()) {
+    parc_remote_playback_time_ = currentTime();
+    ScheduleNextSourceChild();
+    return;
+  }
+  parc_remote_playback_time_.reset();
+  parc_failed_to_play_to_wireless_target_ = true;
+  ParcPlaybackTargetIsWirelessChanged(false);
+}
+
+void HTMLMediaElement::ParcRemoteAvailabilityChanged() {
+  if (auto* remote = RemotePlaybackController::From(*this)) {
+    remote->GetParcExtension().ParcAirPlayAvailabilityChanged();
+  }
+}
+
+void HTMLMediaElement::ParcApplyPlaybackTargetToPlayer() {
+  if (!web_media_player_) {
+    return;
+  }
+  if (auto* parc = web_media_player_->GetParcExtension()) {
+    parc->ParcSetWirelessVideoPlaybackDisabled(
+        parc_wireless_playback_target_disabled_);
+    parc->ParcSetPlaybackTarget(parc_playback_target_id_.Utf8(),
+                                parc_should_play_to_playback_target_);
+  }
+  // WebKit's Media Source player reports it plays to the target once told
+  // to, though it can't (MediaPlayerPrivateMediaSourceAVFObjC::
+  // setShouldPlayToPlaybackTarget), until the compatibility check.
+  if (GetLoadType() == WebMediaPlayer::kLoadTypeMediaSource &&
+      parc_should_play_to_playback_target_ != parc_player_should_play_) {
+    parc_player_should_play_ = parc_should_play_to_playback_target_;
+    ParcPlaybackTargetIsWirelessChanged(parc_player_should_play_);
+  }
+}
+
+void HTMLMediaElement::ParcReportPlaybackTargetState() {
+  if (!media_player_observer_remote_set_) {
+    return;
+  }
+  // MediaElementSession's RequiresPlaybackTargetMonitoring, and the native
+  // HLS player too, so the browser's own controls can offer AirPlay.
+  const bool supports_target =
+      !parc_wireless_playback_target_disabled_ && ParcSupportsPlaybackTarget();
+  const bool requires_monitoring =
+      !parc_wireless_playback_target_disabled_ &&
+      (ParcHasPlaybackTargetAvailabilityListeners() || supports_target);
+  for (auto& observer : media_player_observer_remote_set_->Value()) {
+    // The Mini Player shows a Media Source element connecting, not
+    // connected, until its alternative plays on the device.
+    observer->OnParcPlaybackTargetStateChanged(
+        requires_monitoring, supports_target,
+        parc_should_play_to_playback_target_,
+        parc_playing_to_wireless_target_ &&
+            ParcPlayerSupportsPlaybackTarget(web_media_player_.get()));
+  }
+}
+
+void HTMLMediaElement::ParcPlaybackTargetIsWirelessChanged(bool wireless) {
+  parc_player_wireless_ = wireless;
+  // A file the native route couldn't open no longer supports a target.
+  if (!wireless) {
+    ParcReportPlaybackTargetState();
+    ParcRemoteAvailabilityChanged();
+  }
+  ParcUpdatePlayingToWirelessTarget();
+}
+
+void HTMLMediaElement::ParcUpdatePlayingToWirelessTarget() {
+  GetDocument()
+      .GetTaskRunner(TaskType::kMediaElementEvent)
+      ->PostTask(FROM_HERE,
+                 BindOnce(&HTMLMediaElement::ParcDidChangePlayingToWirelessTarget,
+                          WrapWeakPersistent(this)));
+}
+
+// The value as it stands when the task runs, as setIsPlayingToWirelessTarget
+// takes it: the current player's own report, while the element plays to the
+// target.
+void HTMLMediaElement::ParcDidChangePlayingToWirelessTarget() {
+  const bool wireless = parc_player_wireless_ &&
+                        parc_should_play_to_playback_target_ &&
+                        web_media_player_;
+  if (!GetExecutionContext() || GetExecutionContext()->IsContextDestroyed() ||
+      wireless == parc_playing_to_wireless_target_) {
+    return;
+  }
+  parc_playing_to_wireless_target_ = wireless;
+  if (auto* remote = RemotePlaybackController::From(*this)) {
+    remote->GetParcExtension().ParcPlayingToRemoteTargetChanged(wireless);
+  }
+  ParcReportPlaybackTargetState();
+  ParcPlayingToWirelessTargetChanged();
+  parc_check_playback_target_compatibility_timer_.StartOneShot(
+      base::Milliseconds(500), FROM_HERE);
+  DispatchEvent(*Event::CreateCancelable(
+      event_type_names::kWebkitcurrentplaybacktargetiswirelesschanged));
+}

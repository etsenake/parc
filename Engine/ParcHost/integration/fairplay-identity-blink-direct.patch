+  }
+  cast_text_message_->setInnerText(
+      StrCat({String(u"This video is playing on \u201C"),
+              device_name.empty() ? String("Apple TV") : device_name,
+              String(u"\u201D.")}));
+  if (IsVisible()) {
+    return;
+  }
+  ParcSetAirPlay(true);
+  StartShowing();

+void HTMLMediaElement::AddedEventListener(
+    const AtomicString& event_type,
+    RegisteredEventListener& registered_listener) {
+  HTMLElement::AddedEventListener(event_type, registered_listener);
+  if (event_type != event_type_names::kWebkitplaybacktargetavailabilitychanged ||
+      !PresentsParcSafariIdentity() ||
+      parc_wireless_playback_target_disabled_) {
+    return;
+  }
+  ParcReportPlaybackTargetState();
+  // "Ensure the event listener gets at least one event."
+  ParcEnqueuePlaybackTargetAvailabilityEvent(/*only_when_changed=*/false);
+}
+
+void HTMLMediaElement::RemovedEventListener(
+    const AtomicString& event_type,
+    const RegisteredEventListener& registered_listener) {
+  HTMLElement::RemovedEventListener(event_type, registered_listener);
+  if (event_type == event_type_names::kWebkitplaybacktargetavailabilitychanged &&
+      PresentsParcSafariIdentity() &&
+      !ParcHasPlaybackTargetAvailabilityListeners()) {
+    ParcReportPlaybackTargetState();
+  }
+}

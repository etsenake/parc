+  // player reports audio.
+  if ((IsA<HTMLVideoElement>(element_.Get()) && !has_audio) ||
+      !element_->EffectiveMediaVolume()) {
+    return true;
+  }
+  return ParcProcessingUserGestureForMedia(document);
+}

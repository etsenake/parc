+bool AutoplayPolicy::ParcPlaybackPermitted(bool audio_reported,
+                                            bool for_autoplay) const {
+  const Document& document = element_->GetDocument();
+  if (document.IsMediaDocument() && document.IsInMainFrame())
+    return true;
+  const bool gesture = ParcProcessingUserGestureForMedia(document);
+  const bool has_audio = audio_reported || element_->HasAudio();
+  const bool stream =
+      element_->GetLoadType() == WebMediaPlayer::kLoadTypeMediaStream;
+  const bool playing_audio = ParcMediaElement::DocumentIsPlayingAudio(document);
+  // WebKit checks startingAudiblePlaybackWhileHiddenRequiresUserGesture
+  // before per-element and site autoplay grants; admitted playback continues.
+  if (element_->paused() && document.hidden() && !gesture && !stream &&
+      element_->EffectiveMediaVolume() &&
+      (!IsA<HTMLVideoElement>(element_.Get()) ||
+       element_->getReadyState() < HTMLMediaElement::kHaveMetadata ||
+       has_audio) && !playing_audio && !ParcWithinBackgroundGrace() &&
+      !(for_autoplay && parc_hidden_autoplay_granted_)) {
+    return false;
+  }
+  if (GetAutoplayPolicyForDocument(document) == Type::kNoUserGestureRequired ||
+      DocumentHasForceAllowFlag(document) ||
+      DocumentHasUserExceptionFlag(document)) {
+    return true;
+  }
+  if (parc_created_during_media_gesture_ ||
+      ParcMediaElement::From(*element_).HadMediaUserGesture()) {
+    return true;
+  }

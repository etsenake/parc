+      const std::optional<ParcDoViParameters> parameters = ParcParseDoVi(ascii);
+      const bool extended_mse =
+          config->type() == V8MediaDecodingType::Enum::kMediaSource &&
+          parameters && (parameters->profile == 10 || parameters->profile == 20);

+// WebKit's scheduleTimeupdateEvent: a timeupdate only when the current time
+// differs from the last one's, and a periodic one only 250ms after the last.
+void HTMLMediaElement::ParcScheduleTimeupdateEvent(bool periodic_event,
+                                                   bool parc_unconditional) {
+  if (parc_unconditional) {
+    ScheduleNamedEvent(event_type_names::kTimeupdate);
+    return;
+  }
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeDelta since_last = now - parc_last_timeupdate_clock_;
+  if (periodic_event && since_last < kMaxTimeupdateEventFrequency) {
+    // Fire when the interval is up, then repeat from there.
+    playback_progress_timer_.Stop();
+    playback_progress_timer_.StartOneShot(kMaxTimeupdateEventFrequency -
+                                          since_last);
+    parc_progress_timer_resumes_repeating_ = true;
+    return;
+  }
+
+  const double media_time = CurrentPlaybackPosition();
+  if (media_time == last_time_update_event_media_time_) {
+    return;
+  }
+  Event* event = Event::CreateCancelable(event_type_names::kTimeupdate);
+  event->SetTarget(this);
+  ScheduleEvent(event);
+  if (periodic_event) {
+    parc_periodic_timeupdate_ = event;
+  }
+  parc_last_timeupdate_clock_ = now;
+  last_time_update_event_media_time_ = media_time;
+}
+
+void HTMLMediaElement::ParcScheduleCueTimeupdate() {
+  if (!PresentsParcSafariIdentity() || seeking_) {
+    return;
+  }
+  // WebKit's finishSeek runs the cue update in a task after its timeupdate
+  // and seeked.
+  if (parc_finishing_seek_) {
+    parc_cue_timeupdate_after_seek_ = true;
+    return;
+  }
+  ScheduleTimeupdateEvent(true);
+}

+// WebKit's mediaSourceWasDetached(), which runs userCancelledLoad(). A
+// pending ParcMediaSourceLoaded() counts as loaded: it arrives on another
+// task queue than this notification.
+void HTMLMediaElement::ParcMediaSourceWasDetached() {
+  if (!PresentsParcSafariIdentity() || network_state_ == kNetworkEmpty ||
+      parc_completely_loaded_ || parc_media_source_ended_task_.IsActive()) {
+    return;

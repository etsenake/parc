+// MediaElementSession::showPlaybackTargetPicker: nothing before
+// HAVE_METADATA. Safari on macOS needs no gesture for it (its gesture rule
+// applies only where playback needs one); the browser shows the list only for
+// the selected page of the key window. It opens at the last mouse position,
+// as Document::showPlaybackTargetPicker places it.
+void HTMLMediaElement::webkitShowPlaybackTargetPicker() {
+  LocalFrame* frame = GetDocument().GetFrame();
+  if (!frame || ready_state_ < kHaveMetadata) {
+    return;
+  }
+  gfx::PointF position =
+      frame->GetEventHandler().LastKnownMousePositionInRootFrame();
+  if (frame->LocalFrameRoot().IsOutermostMainFrame()) {
+    position =
+        frame->GetPage()->GetVisualViewport().RootFrameToViewport(position);
+  }
+  if (FrameWidget* widget = frame->GetWidgetForLocalRoot()) {
+    position =
+        widget->BlinkSpaceToDIPs(gfx::RectF(position, gfx::SizeF())).origin();
+  }
+  const gfx::Point dips = gfx::ToFlooredPoint(position);
+  for (auto& observer : media_player_observer_remote_set_->Value()) {
+    observer->OnParcShowPlaybackTargetPicker(dips);
+  }
+}

+  if (config->hasAudio()) {
+    const AudioConfiguration* audio = config->audio();
+    String mime_type;
+    String codec;
+    if (!ParseContentType(audio->contentType(), &mime_type, &codec) ||
+        !ParcSafariTypeSupported(config, audio->contentType(), mime_type,
+                                 codec)) {

+// WebKit's mediaPlayerTimeChanged for a time the player reports outside a
+// seek; the end comes through TimeChanged().
+void HTMLMediaElement::ParcPlayerTimeChanged() {
+  if (!PresentsParcSafariIdentity() || !web_media_player_ || seeking_) {
+    return;
+  }
+  if (!IsShowPosterFlagSet()) {
+    GetCueTimeline().InvokeTimeMarchesOn();
+  }
+  SetOfficialPlaybackPosition(CurrentPlaybackPosition());
+  ScheduleTimeupdateEvent(false);
+}

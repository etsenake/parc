+// The script returns nothing when the context already has the interface (a
+// document taking over its window's context keeps the first hook).
+void HTMLMediaElement::SetParcPlaybackTargetEventHook(
+    ScriptState* script_state,
+    v8::Local<v8::Value> hook) {
+  if (hook.IsEmpty() || !hook->IsFunction()) {
+    return;
+  }
+  v8::Local<v8::Context> context = script_state->GetContext();
+  std::ignore = context->Global()->SetPrivate(
+      context, ParcPlaybackTargetEventHookKey(script_state->GetIsolate()),
+      hook);
+}

+ParcMediaPlayerClient* HTMLMediaElement::ParcClient() {
+  return this;
+}
+
+bool HTMLMediaElement::PresentsParcSafariIdentity() const {
+  // As for ParcSupportsType: a document without a window of its own answers
+  // for the window that created it.
+  ExecutionContext* context = GetDocument().GetExecutionContext();
+  return context && IsParcSafariIdentityUserAgent(context->UserAgent());
+}
+
+bool HTMLMediaElement::ParcPreparesToPlay() const {
+  // Only the native HLS route asks, under Safari's identity, where the
+  // effective preload follows WebKit's rules.
+  return EffectivePreloadType() == WebMediaPlayer::kPreloadAuto;
+}
+
+void HTMLMediaElement::ParcPrepareToPlay() {
+  if (parc_has_ever_prepared_to_play_ || !GetDocument().GetFrame()) {
+    return;
+  }
+  parc_has_ever_prepared_to_play_ = true;
+  // WebKit's player->prepareToPlay(): the player's preload becomes auto, and
+  // a load deferred at preload none starts.
+  SetPlayerPreload();
+}
+
+void HTMLMediaElement::ParcPrepareToPlayIfCouldPlay() {
+  // WebKit's potentiallyPlaying holds once readyState has reached
+  // HAVE_FUTURE_DATA on this load, a stall since included.
+  ParcNoteFutureDataAsWebKit();
+  if (CouldPlayIfEnoughData() && !parc_had_future_data_as_webkit_) {
+    ParcPrepareToPlay();
+  }
+}
+
+void HTMLMediaElement::ParcNoteFutureDataAsWebKit() {
+  // Sampled as readyState and the preload change, since WebKit's player
+  // keeps the data it has when its preload is lowered.
+  if (!parc_had_future_data_as_webkit_ &&
+      parc_ready_state_maximum_ >= kHaveFutureData &&
+      PresentsParcSafariIdentity()) {
+    parc_had_future_data_as_webkit_ =
+        ParcHasFutureDataAsWebKit(parc_ready_state_maximum_);
+  }
+}
+
+bool HTMLMediaElement::ParcHasFutureDataAsWebKit(ReadyState state) const {
+  // WebKit's AVFoundation player has data past metadata only once its
+  // preload is auto (it has no item before), or for a Media Source, a media
+  // stream or a live stream; Chromium's may at a lower preload.
+  if (state < kHaveFutureData) {
+    return false;
+  }
+  return EffectivePreloadType() == WebMediaPlayer::kPreloadAuto ||
+         GetLoadType() != WebMediaPlayer::kLoadTypeURL ||
+         duration() == std::numeric_limits<double>::infinity();
+}
+
+void HTMLMediaElement::ParcVideoLayerSize(gfx::SizeF* size,
+                                          float* scale) const {
+  // WebKit's initial video layer size is the element's content box
+  // (mediaPlayerContentBoxRect). Layout here is in physical pixels (zoom for
+  // device scale), so the display's scale divides it back to points.
+  if (!IsHTMLVideoElement()) {
+    return;
+  }
+  LocalFrame* frame = GetDocument().GetFrame();
+  auto* box = DynamicTo<LayoutBox>(GetLayoutObject());
+  if (!frame || !frame->GetPage() || !box) {
+    return;
+  }
+  const float device_scale = frame->GetPage()
+                                 ->GetChromeClient()
+                                 .GetScreenInfo(*frame)
+                                 .device_scale_factor;
+  const PhysicalSize content = box->PhysicalContentBoxRect().size;
+  if (!(device_scale > 0) || content.IsEmpty()) {
+    return;
+  }
+  *size = gfx::SizeF(content.width.ToFloat() / device_scale,
+                     content.height.ToFloat() / device_scale);
+  *scale = device_scale;
+}

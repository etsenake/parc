+
+void MediaRemotingInterstitial::ParcShowAirPlay(const String& device_name,
+                                                const String& glyph) {
+  if (IsVisible() && !parc_airplay_) {
+    return;
+  }
+  if (glyph.IsNull()) {
+    cast_icon_->RemoveInlineStyleProperty(CSSPropertyID::kBackgroundImage);
+  } else {
+    cast_icon_->SetInlineStyleProperty(CSSPropertyID::kBackgroundImage, glyph);
+  }
+  cast_text_message_->setInnerText(
+      StrCat({String(u"This video is playing on \u201C"),
+              device_name.empty() ? String("Apple TV") : device_name,
+              String(u"\u201D.")}));
+  if (IsVisible()) {
+    return;
+  }
+  ParcSetAirPlay(true);
+  StartShowing();
+}
+
+void MediaRemotingInterstitial::ParcSetAirPlay(bool airplay) {
+  parc_airplay_ = airplay;
+  if (!airplay) {
+    removeAttribute(html_names::kClassAttr);
+    return;
+  }
+  setAttribute(html_names::kClassAttr, AtomicString("parc-airplay"));
+  background_image_->SetInlineStyleProperty(CSSPropertyID::kDisplay,
+                                            CSSValueID::kNone);
+  if (!parc_airplay_title_) {
+    parc_airplay_title_ = MakeGarbageCollected<HTMLDivElement>(GetDocument());
+    parc_airplay_title_->SetShadowPseudoId(
+        AtomicString("-internal-parc-airplay-placard-title"));
+    parc_airplay_title_->setInnerText("AirPlay");
+    InsertBefore(parc_airplay_title_, cast_text_message_);
+  }
+}

+bool HTMLMediaElement::ParcDocumentIsPlayingAudio(const Document& document) {
+  auto it = DocumentToElementSetMap().find(const_cast<Document*>(&document));
+  if (it == DocumentToElementSetMap().end())
+    return false;
+  for (const auto& element : *it->value) {
+    if (!element->paused() && element->HasAudio() &&
+        element->EffectiveMediaVolume() && element->playing_)
+      return true;
+  }
+  return false;
+}
+
+void HTMLMediaElement::ParcNoteMediaUserGesture() {
+  if (AutoplayPolicy::ParcProcessingUserGestureForMedia(GetDocument())) {
+    parc_had_media_user_gesture_ = true;
+  }
+}
+
+void HTMLMediaElement::ParcPauseIfPlaybackNotPermitted(
+    bool reject_as_not_allowed, bool audio_reported) {
+  if (paused_ || !PresentsParcSafariIdentity() ||
+      autoplay_policy_->ParcPlaybackPermitted(audio_reported)) {
+    return;
+  }
+  if (reject_as_not_allowed) {

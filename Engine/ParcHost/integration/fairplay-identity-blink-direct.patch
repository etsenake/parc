+
+video::-internal-parc-airplay-placard-title {
+    display: none;
+}
+
+video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-parc-airplay-placard-title" i],
+video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-media-interstitial-message" i] {
+    display: none;
+    position: static;
+    max-width: 382px;
+    padding: 0 10px;
+    text-align: center;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    color: inherit;
+    font-family: inherit;
+}
+
+video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-parc-airplay-placard-title" i] {
+    font-size: 20px;
+    white-space: nowrap;
+}
+
+video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-media-interstitial-message" i] {
+    font-size: 13px;
+    display: none;
+    -webkit-box-orient: vertical;
+    -webkit-line-clamp: 2;
+}
+
+@container (min-height: 40px) {
+    video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-parc-airplay-placard-title" i] {
+        display: block;
+    }
+}
+
+@container (min-height: 100px) {
+    video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-media-interstitial-message" i] {
+        display: -webkit-box;
+    }
+}
+
+@container (min-width: 170px) and (min-height: 170px) {
+    video::-internal-media-interstitial.parc-airplay div[pseudo="-internal-media-remoting-cast-icon" i] {
+        display: block;
+    }
+}

+    parc_scrubbing_remotely_ = true;
+    parc_was_playing_before_seeking_ = !paused_;
+    if (parc_was_playing_before_seeking_) {
+      PauseInternal(WebMediaPlayer::PauseReason::kPauseRequestedByUser);
+    }
+  }

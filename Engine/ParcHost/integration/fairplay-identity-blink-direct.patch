+// setWirelessPlaybackTarget and setShouldPlayToPlaybackTarget.
+void HTMLMediaElement::ParcSetPlaybackTarget(const String& output_context_id,
+                                             const String& device_name,
+                                             bool should_play,
+                                             uint32_t tint_argb,
+                                             uint32_t tint_on_light_argb) {
+  if (!PresentsParcSafariIdentity()) {
+    return;
+  }
+  // The placard shows the device's name in the tint; the button the tint.
+  const bool tint_changed =
+      tint_argb != parc_playback_target_tint_ ||
+      tint_on_light_argb != parc_playback_target_tint_on_light_;
+  const bool placard_changed =
+      tint_changed || device_name != parc_playback_target_device_name_;
+  const bool target_changed =
+      output_context_id != parc_playback_target_id_ ||
+      (should_play && !output_context_id.empty()) !=
+          parc_should_play_to_playback_target_;
+  parc_playback_target_id_ = output_context_id;
+  parc_playback_target_device_name_ = device_name;
+  parc_playback_target_tint_ = tint_argb;
+  parc_playback_target_tint_on_light_ = tint_on_light_argb;
+  parc_should_play_to_playback_target_ =
+      should_play && !output_context_id.empty();
+  // A new tint alone (the Space changed) leaves the player as it plays.
+  if (target_changed || !tint_changed) {
+    ParcApplyPlaybackTargetToPlayer();
+  }
+  if (!parc_should_play_to_playback_target_ &&
+      parc_playing_to_wireless_target_) {
+    ParcUpdatePlayingToWirelessTarget();
+  }
+  ParcReportPlaybackTargetState();
+  if (placard_changed && parc_playing_to_wireless_target_ &&
+      parc_should_play_to_playback_target_) {
+    ParcPlayingToWirelessTargetChanged();
+  }
+  if (tint_changed && media_controls_) {
+    media_controls_->ParcAirPlayTintChanged();
+  }
+  if (auto* remote = RemotePlaybackController::From(*this)) {
+    remote->GetParcExtension().ParcShouldPlayToRemoteTargetChanged(
+        parc_should_play_to_playback_target_);
+  }
+}

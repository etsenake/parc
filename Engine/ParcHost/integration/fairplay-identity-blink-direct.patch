+void MediaKeySystemAccessInitializer::ParcAskAVFoundation() {
+  parc_asked_ = true;
+  ExecutionContext* context = GetExecutionContext();
+  context->GetBrowserInterfaceBroker().GetInterface(
+      parc_avfoundation_.BindNewPipeAndPassReceiver(
+          context->GetTaskRunner(TaskType::kMediaElementEvent)));
+  // Answers that never come refuse what they were for.
+  parc_avfoundation_.set_disconnect_handler(
+      BindOnce(&MediaKeySystemAccessInitializer::ParcApplyAnswers,
+               WrapWeakPersistent(this)));
+  for (const ParcAVFoundationCheck& check : parc_checks_) {
+    if (parc_answers_.Contains(check.content_type)) {
+      continue;
+    }
+    parc_answers_.Set(check.content_type, false);
+    ++parc_pending_;
+    parc_avfoundation_->IsPlayableExtendedMIMEType(
+        check.content_type,
+        BindOnce(&MediaKeySystemAccessInitializer::ParcOnAnswer,
+                 WrapWeakPersistent(this), check.content_type));
+  }

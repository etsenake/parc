+// MediaElementSession::externalOutputDeviceAvailableDidChange, then
+// wirelessRoutesAvailableDidChange.
+void HTMLMediaElement::ParcSetPlaybackTargetAvailability(bool available) {
+  if (!PresentsParcSafariIdentity() ||
+      available == parc_has_playback_targets_) {
+    return;
+  }
+  parc_has_playback_targets_ = available;
+  if (!parc_wireless_playback_target_disabled_) {
+    ParcEnqueuePlaybackTargetAvailabilityEvent(/*only_when_changed=*/true);
+  }
+  ParcRemoteAvailabilityChanged();
+}

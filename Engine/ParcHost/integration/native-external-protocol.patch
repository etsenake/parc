+bool PictureInPictureOcclusionTracker::IsNativeRectangleOccluded(
+    const gfx::Rect& bounds) const {
+  for (const auto& [token, data] : native_windows_) {
+    if (data.window && data.visible && data.bounds.Intersects(bounds)) {
+      return true;
+    }
+  }
+  for (const auto& [widget, data] : observed_widget_data_) {
+    if (data.is_picture_in_picture_widget && widget->IsVisible() &&
+        widget->GetWindowBoundsInScreen().Intersects(bounds)) {
+      return true;
+    }
+  }
+  return false;
+}
+base::CallbackListSubscription
+PictureInPictureOcclusionTracker::ObserveNativeOccluderChanges(
+    base::RepeatingClosure callback) {
+  return native_observers_.Add(std::move(callback));
 }
 

+  return l10n_util::GetStringFUTF16(IDS_EXTERNAL_PROTOCOL_OK_BUTTON_TEXT,
+                                    program_name);
+}
+std::u16string NativeExternalProtocolDialogRequest::CancelLabel() const {
+  return l10n_util::GetStringUTF16(IDS_EXTERNAL_PROTOCOL_CANCEL_BUTTON_TEXT);
+}
+std::u16string NativeExternalProtocolDialogRequest::RememberLabel() const {
+  if (!MayRemember()) {
+    return {};
+  }
+  return l10n_util::GetStringFUTF16(
+      IDS_EXTERNAL_PROTOCOL_CHECKBOX_PER_ORIGIN_TEXT,
+      url_formatter::FormatOriginForSecurityDisplay(
+          *initiating_origin,
+          url_formatter::SchemeDisplay::OMIT_CRYPTOGRAPHIC));
+}
+void NativeExternalProtocolDialogRequest::Cancel() {
+  if (decided_) {
+    return;
+  }
+  decided_ = true;
+  ExternalProtocolHandler::RecordHandleStateMetrics(
+      false, ExternalProtocolHandler::BLOCK);
+}
+void NativeExternalProtocolDialogRequest::Accept(
+    bool remember,
+    base::RepeatingCallback<bool()> can_authorize) {
+  if (decided_) {
+    return;
+  }
+  decided_ = true;
+  auto valid = [&] {
+    if (!can_authorize || !can_authorize.Run() || !contents_) {
+      return false;
+    }
+    auto* frame = initiator_document.AsRenderFrameHostIfValid();
+    return frame && content::WebContents::FromRenderFrameHost(frame)
+                            ->GetOutermostWebContents() == contents_.get();
+  };
+  if (!valid()) {
+    ExternalProtocolHandler::RecordHandleStateMetrics(
+        false, ExternalProtocolHandler::BLOCK);
+    return;
+  }
+  remember = remember && MayRemember();
+  ExternalProtocolHandler::RecordHandleStateMetrics(
+      remember, ExternalProtocolHandler::DONT_BLOCK);
+  if (remember) {
+    ExternalProtocolHandler::SetBlockState(
+        url.GetScheme(), *initiating_origin,
+        ExternalProtocolHandler::DONT_BLOCK,
+        Profile::FromBrowserContext(contents_->GetBrowserContext()));
+  }
+  if (valid()) {
+    ExternalProtocolHandler::LaunchUrlWithoutSecurityCheck(url, contents_.get(),
+                                                           initiator_document);
+  }
+}

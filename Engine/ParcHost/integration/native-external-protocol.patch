+uint64_t PictureInPictureOcclusionTracker::RegisterNativePictureInPictureWindow(
+    gfx::NativeWindow window) {
+  CHECK(window);
+  CHECK_NE(++next_native_token_, 0u);
+  native_windows_.emplace(next_native_token_,
+                          NativeWindowData{window, {}, false});
+  return next_native_token_;
+}
+void PictureInPictureOcclusionTracker::UpdateNativePictureInPictureWindow(
+    uint64_t token,
+    const gfx::Rect& bounds,
+    bool visible) {
+  auto it = native_windows_.find(token);
+  if (it == native_windows_.end()) {
+    return;
+  }
+  if (it->second.bounds == bounds && it->second.visible == visible) {
+    return;
+  }
+  it->second.bounds = bounds;
+  it->second.visible = visible;
+  UpdateAllObserverStates();
+}
+void PictureInPictureOcclusionTracker::RemoveNativePictureInPictureWindow(
+    uint64_t token) {
+  if (native_windows_.erase(token)) {
+    UpdateAllObserverStates();
+  }
+}

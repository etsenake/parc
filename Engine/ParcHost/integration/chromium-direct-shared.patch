+      frame != GetPrimaryMainFrame() ||
+      WebContents::FromRenderFrameHost(frame) != this ||
+      !params.is_renderer_initiated || !params.initiator_frame_token ||
+      frame->GetGlobalFrameToken() != GlobalRenderFrameHostToken(
+          params.initiator_process_id, *params.initiator_frame_token)) return;
+  observers_.NotifyObservers(&WebContentsObserver::DidOpenRequestedURL,
+      created, frame, params.url, params.referrer, params.disposition,
+      params.transition, params.started_from_context_menu,
+      params.is_renderer_initiated);
+}

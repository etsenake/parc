 void ManagePasswordsUIController::ShowBubble() {
+  native_password_presentation_unavailable_ = false;
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_CEF)
+  if (parc::UsesNativePasswordPrompt(web_contents()) &&
+      (GetState() == password_manager::ui::PENDING_PASSWORD_STATE ||
+       GetState() == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE)) {
+    native_password_presentation_unavailable_ =
+        !parc::ShowNativePasswordPrompt(web_contents(), user_action_);
+    return;
+  }
+#endif

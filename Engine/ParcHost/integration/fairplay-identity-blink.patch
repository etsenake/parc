+bool HTMLMediaElement::PresentsParcSafariIdentity() const {
+  // As for ParcSupportsType: a document without a window of its own answers
+  // for the window that created it.
+  ExecutionContext* context = GetDocument().GetExecutionContext();
+  return context && IsParcSafariIdentityUserAgent(context->UserAgent());
+}

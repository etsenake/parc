+void CrossThreadMediaSourceAttachment::ParcNotifyEndOfStream(
+    MediaSourceTracer* /* tracer */) {
+  attachment_state_lock_.AssertAcquired();
+  VerifyCalledWhileContextsAliveForDebugging();
+  DCHECK(!IsMainThread());
+  DCHECK(worker_runner_->BelongsToCurrentThread());
+
+  PostCrossThreadTask(
+      *main_runner_, FROM_HERE,
+      CrossThreadBindOnce(
+          &CrossThreadMediaSourceAttachment::ParcEndOfStreamOnMainThread,
+          blink::RetainedRef(this)));

+      if (source == kParcWebKitPresentationScript) {
+        v8::Local<v8::Value> install = result.GetSuccessValueOrEmpty();
+        if (!install.IsEmpty() && install->IsFunction()) {
+          CallParcPresentationScript(script_state, install.As<v8::Function>());
+        }
+      }
+    }
+  }

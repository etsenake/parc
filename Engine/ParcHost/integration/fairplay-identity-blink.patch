+// Parc: WebKit's MediaPlayer::supportsType(...) == IsSupported for one
+// track of a Safari-identity query. Media Source: Chromium's Media Source
+// parsers; a file: what canPlayType calls "probably". Dolby Vision profile 5,
+// which FairPlay plays encrypted, counts in MP4 as Safari counts it, as
+// Parc's Safari-identity canPlayType and isTypeSupported already do.
+bool ParcSafariTypeSupported(const MediaDecodingConfiguration* config,
+                             const String& content_type,
+                             const String& mime_type,
+                             const String& codec) {
+  if (mime_type == "video/mp4" &&
+      (codec.starts_with("dvh1.") || codec.starts_with("dvhe."))) {
+    const std::optional<ParcDoViParameters> parameters =
+        codec.ContainsOnlyAsciiOrEmpty()
+            ? ParcParseDoVi(codec.Ascii())
+            : std::nullopt;
+    if (parameters && parameters->profile == 5) {
+      return true;
+    }
+  }
+  if (config->type() == V8MediaDecodingType::Enum::kMediaSource) {
+    return CheckMseSupport(mime_type, codec);
+  }
+  return HTMLMediaElement::GetSupportsType(ContentType(content_type)) ==
+         MIMETypeRegistry::kSupported;
+}

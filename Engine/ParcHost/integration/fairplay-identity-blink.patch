+void HTMLMediaElement::setCurrentTimeForBindings(
+    double time,
+    ExceptionState& exception_state) {
+  if (PresentsParcSafariIdentity()) {
+    // WebKit's setCurrentTimeForBindings clamps to [0, DBL_MAX]: +Infinity

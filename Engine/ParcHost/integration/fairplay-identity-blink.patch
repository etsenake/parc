+  // The player's start time is zero in WebKit on macOS.
+  double time = std::max(std::min(seek.time, duration()), 0.0);
+  time = web_media_player_->MediaTimeForTimeValue(time);
+
+  // A precise seek to the current position needs no seek of the player,
+  // unless a fast seek is still with it or an open Media Source must flush.
+  WebTimeRanges seekable_ranges = SeekableInternal();
+  const bool precise = !seek.tolerance_before;
+  bool no_seek_required = seekable_ranges.empty() ||
+                          (time == seek.now && precise &&
+                           !parc_fast_seek_with_player_ && !show_poster_flag_);
+  if (media_source_attachment_ && !seekable_ranges.empty()) {
+    no_seek_required = false;
+  }
+  if (no_seek_required) {
+    if (time == seek.now) {
+      ScheduleNamedEvent(event_type_names::kSeeking);
+      ScheduleTimeupdateEvent(false);
+      ScheduleNamedEvent(event_type_names::kSeeked);
+    }
+    ParcClearSeeking();
+    return;
+  }
+  // PlatformTimeRanges::nearest: a tie goes to the earliest range.
+  time = seekable_ranges.Nearest(time,
+                                 -std::numeric_limits<double>::infinity());

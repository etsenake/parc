+
+void HTMLMediaElement::ParcAddInbandTextCues(
+    const std::string& key,
+    const std::vector<media::ParcInbandTextCue>& cues) {
+  if (ParcInbandTextTrack* track = FindParcInbandTextTrack(key)) {
+    track->AddCues(cues);
+  }
+}
+
+void HTMLMediaElement::ParcAddInbandDataCues(
+    const std::string& key,
+    const std::vector<media::ParcInbandDataCue>& cues) {
+  if (ParcInbandTextTrack* track = FindParcInbandTextTrack(key)) {
+    track->AddDataCues(cues);
+  }
+}
+
+ParcInbandTextTrack* HTMLMediaElement::FindParcInbandTextTrack(
+    const std::string& key) {
+  if (!text_tracks_) {
+    return nullptr;
+  }
+  for (const auto& track : text_tracks_->InbandTracks()) {
+    auto* inband = To<ParcInbandTextTrack>(track.Get());
+    if (inband->Key() == key) {
+      return inband;
+    }
+  }
+  return nullptr;
+}
+
+void HTMLMediaElement::RemoveParcInbandTextTrack(ParcInbandTextTrack* track) {
+  // As DidRemoveTrackElement; the track's cues leave the timeline with it.
+  GetDocument().GetStyleEngine().RemoveTextTrack(track);
+  text_tracks_->Remove(track);
+  wtf_size_t index = text_tracks_when_resource_selection_began_.Find(track);
+  if (index != kNotFound) {
+    text_tracks_when_resource_selection_began_.EraseAt(index);
+  }
+}

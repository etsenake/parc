+// WebKit's HTMLMediaElement::handleSeekToPlaybackPosition on macOS: a seek
+// from the system's media controls runs as a page's, and the first of a scrub
+// pauses playing media until a seek finishes (finishSeek).
+void HTMLMediaElement::ParcHandleSeekToPlaybackPosition(double position) {
+  {
+    base::AutoReset<bool> from_page(&parc_seek_from_page_, true);
+    Seek(position);
+  }
+  ReportCurrentTimeToMediaSource();
+  parc_remote_scrub_end_timer_.StartOneShot(base::Milliseconds(500),
+                                            FROM_HERE);
+
+  if (!parc_scrubbing_remotely_) {
+    parc_scrubbing_remotely_ = true;
+    parc_was_playing_before_seeking_ = !paused_;
+    if (parc_was_playing_before_seeking_) {
+      PauseInternal(WebMediaPlayer::PauseReason::kPauseRequestedByUser);
+    }
+  }
+}

+    }
+  }
+  for (const String& key : gone) {
+    audioTracks().RemoveTrack(parc_inband_audio_tracks_.Take(key).Get());
+  }
+  for (const media::ParcInbandAudioTrack& info : tracks) {
+    const String key = String::FromUtf8(info.key);

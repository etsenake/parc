+// WebKit's HTMLMediaElement::seekTask.
+void HTMLMediaElement::ParcSeekTask() {
+  const ParcPendingSeek seek = *parc_pending_seek_;
+  parc_pending_seek_.reset();
+  if (!web_media_player_ || ready_state_ == kHaveNothing) {
+    ParcClearSeeking();
+    return;
+  }

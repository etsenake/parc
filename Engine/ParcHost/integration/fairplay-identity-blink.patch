+// Parc: AC-3 and E-AC-3 answer yes only under Safari's identity
+// (parc_safari_identity.h). A document without a window of its own answers
+// for the window that created it.
+bool ParcHidesSafariOnlyAudio(const Document& document, const String& type) {
+  if (!IsParcSafariOnlyAudioCodecs(ContentType(type).Parameter("codecs"))) {
+    return false;
+  }
+  ExecutionContext* context = document.GetExecutionContext();
+  return !context || !IsParcSafariIdentityUserAgent(context->UserAgent());
+}

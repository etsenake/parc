+      }
+      // Profile 5 is HEVC Main10, so HDR fields don't refuse it.
+      if (!std::ranges::contains(*facts->dolby_vision_profiles,
+                          parameters->profile) ||
+          !std::ranges::contains(*facts->dolby_vision_levels, parameters->level)) {
+        return std::nullopt;
+      }
+      answer.smooth = true;
+      answer.power_efficient = facts->dolby_vision_hardware;
+    } else {

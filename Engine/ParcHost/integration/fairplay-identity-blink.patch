+
+void CrossThreadMediaSourceAttachment::ParcEndOfStreamOnMainThread() {
+  DCHECK(IsMainThread());
+  HTMLMediaElement* element;
+  {
+    base::AutoLock lock(attachment_state_lock_);
+    if (have_ever_started_closing_ || media_element_context_destroyed_) {
+      return;
+    }
+    element = attached_element_.Get();
+  }
+  // Outside the lock: the element's network state change can read buffered
+  // through this attachment.
+  element->ParcMediaSourceEnded();
+}

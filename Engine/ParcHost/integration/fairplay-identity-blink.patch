+// couldn't be had, which WebKit reads as VideoToolbox lacking them). Dolby
+// Vision answers for profile 5 only, the profile Parc's FairPlay offers.
+std::optional<ParcDecodingAnswer> ParcSafariAnswer(
+    const MediaDecodingConfiguration* config,
+    const media::mojom::blink::ParcVideoToolboxDecodingFacts* facts) {
+  ParcDecodingAnswer answer;
+  if (config->hasVideo()) {
+    const VideoConfiguration* video = config->video();
+    String mime_type;
+    String codecs;
+    if (!ParseContentType(video->contentType(), &mime_type, &codecs) ||

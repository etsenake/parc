+bool HTMLMediaElement::ParcPreparesToPlay() const {
+  // WebKit: load() prepares to play (HTMLMediaElement::load), autoplay sets
+  // the player's preload to auto (maybeUpdatePlayerPreload), and the preload
+  // attribute is auto unless it is "none" or "metadata", missing included
+  // (parseAttribute; macOS lets media data load automatically, so no
+  // AutoPreloadingNotPermitted restriction lowers it). Chromium's own
+  // default, metadata, and its cellular override don't apply.
+  if (ignore_preload_none_ || Autoplay()) {
+    return true;
+  }
+  const AtomicString& preload = FastGetAttribute(html_names::kPreloadAttr);
+  return !EqualIgnoringAsciiCase(preload, keywords::kNone) &&
+         !EqualIgnoringAsciiCase(preload, "metadata");

+// WebKit (HTMLMediaElement::postConnectionSteps and loadResource): the first
+// of these sets m_explicitlyMuted and m_muted from the attribute, without a
+// volumechange; from then on the attribute no longer changes muted. Without
+// MediaElementMutedDefaultState other pages never read muted_is_default_
+// while it is false, so clearing it there only spares muted() the identity
+// check.
+void HTMLMediaElement::ParcLatchMutedAttribute() {
+  if (!muted_is_default_) {
+    return;
+  }
+  if (PresentsParcSafariIdentity()) {
+    muted_is_default_ = false;
+    muted_ = FastHasAttribute(html_names::kMutedAttr);
+  } else if (!RuntimeEnabledFeatures::MediaElementMutedDefaultStateEnabled()) {
+    muted_is_default_ = false;
+  }

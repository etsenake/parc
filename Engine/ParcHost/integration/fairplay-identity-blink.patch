+      media::ParseAudioCodecString("audio/mp4", codec.Ascii());
+  return parsed && (parsed->codec == media::AudioCodec::kAAC ||
+                    parsed->codec == media::AudioCodec::kAC3 ||
+                    parsed->codec == media::AudioCodec::kEAC3 ||

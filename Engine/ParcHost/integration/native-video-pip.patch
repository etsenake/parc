+
+SkBitmap TextTrackContainer::PaintForPictureInPicture(
+    const gfx::SizeF& window_size,
+    float device_scale_factor,
+    gfx::RectF& bounds) {
+  LocalFrame* frame = GetDocument().GetFrame();
+  if (!frame || !frame->View() || !HasChildren() || window_size.IsEmpty()) {
+    return SkBitmap();
+  }
+  // Throttling applies only inside a frame update, so this also brings a
+  // throttled frame (say a cross-origin player scrolled away) up to date.
+  if (!frame->View()->UpdateAllLifecyclePhasesExceptPaint(
+          DocumentUpdateReason::kOverlay) ||
+      GetDocument().Lifecycle().GetState() !=
+          DocumentLifecycle::kPrePaintClean) {
+    return SkBitmap();
+  }
+  const LayoutBox* container = GetLayoutBox();
+  const auto* video = DynamicTo<LayoutVideo>(media_element_->GetLayoutObject());
+  if (!container || !container->HasLayer() || !video) {
+    return SkBitmap();
+  }
+
+  gfx::RectF cues;
+  for (const Element& child : ElementTraversal::ChildrenOf(*this)) {
+    if (const LayoutObject* object = child.GetLayoutObject()) {
+      cues.Union(
+          gfx::RectF(object->AbsoluteBoundingBoxRectIncludingDescendants()));
+    }
+  }
+  cues.Intersect(gfx::RectF(container->AbsoluteBoundingBoxRect()));
+  const gfx::RectF video_rect(
+      video->LocalToAbsoluteRect(video->ReplacedContentRect()));
+  if (cues.IsEmpty() || video_rect.IsEmpty()) {
+    return SkBitmap();
+  }
+
+  // The window shows the video frame, so cues keep their place and size
+  // relative to it, as WebKit lays them out over the window's video layer.
+  // Cues in the element's letterbox move inside the window.
+  const float scale = std::min(window_size.width() / video_rect.width(),
+                               window_size.height() / video_rect.height());
+  const gfx::Vector2dF letterbox(
+      (window_size.width() - video_rect.width() * scale) / 2,
+      (window_size.height() - video_rect.height() * scale) / 2);
+  gfx::RectF placed((cues.x() - video_rect.x()) * scale + letterbox.x(),
+                    (cues.y() - video_rect.y()) * scale + letterbox.y(),
+                    cues.width() * scale, cues.height() * scale);
+  const float fit = std::min({1.f, window_size.width() / placed.width(),
+                              window_size.height() / placed.height()});
+  placed.ClampToCenteredSize(gfx::ScaleSize(placed.size(), fit));
+  placed.set_origin(gfx::PointF(
+      std::clamp(placed.x(), 0.f,
+                 std::max(0.f, window_size.width() - placed.width())),
+      std::clamp(placed.y(), 0.f,
+                 std::max(0.f, window_size.height() - placed.height()))));
+  const float pixels = scale * fit * device_scale_factor;
+  const gfx::Size size = gfx::ToCeiledSize(gfx::ScaleSize(cues.size(), pixels));
+  constexpr int kMaxDimension = 8192;
+  SkBitmap bitmap;
+  if (size.IsEmpty() || size.width() > kMaxDimension ||
+      size.height() > kMaxDimension ||
+      !bitmap.tryAllocN32Pixels(size.width(), size.height())) {
+    return SkBitmap();
+  }
+  bitmap.eraseColor(SK_ColorTRANSPARENT);
+
+  // contain: paint makes the container a stacking context, so its layer
+  // paints exactly the cues. Painting follows DraggedNodeImageBuilder.
+  PaintLayer& layer = *container->Layer();
+  gfx::RectF local = container->AbsoluteToLocalQuad(gfx::QuadF(cues))
+                         .BoundingBox();
+  if (local.IsEmpty()) {
+    return SkBitmap();
+  }
+  local.Offset(gfx::Vector2dF(container->FirstFragment().PaintOffset()));
+  OverriddenCullRectScope cull_rect_scope(
+      layer, CullRect(gfx::ToEnclosingRect(local)), /*disable_expansion=*/true);
+  PaintRecordBuilder builder;
+  GetDocument().Lifecycle().AdvanceTo(DocumentLifecycle::kInPaint);
+  PaintLayerPainter(layer).Paint(builder.Context(),
+                                 PaintFlag::kOmitCompositingInfo);
+  GetDocument().Lifecycle().AdvanceTo(DocumentLifecycle::kPaintClean);
+  // `local` is the cue area in the layer's space, which a transform on the
+  // player scales against the absolute `cues` the bitmap is sized from.
+  cc::SkiaPaintCanvas canvas(bitmap);
+  canvas.scale(size.width() / local.width(), size.height() / local.height());
+  canvas.translate(-local.x(), -local.y());
+  builder.EndRecording(
+      canvas, container->FirstFragment().LocalBorderBoxProperties().Unalias());
+
+  bounds = gfx::ScaleRect(placed, 1 / window_size.width(),
+                          1 / window_size.height());
+  return bitmap;
 }
 

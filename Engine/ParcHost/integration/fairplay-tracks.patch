+void VTTCue::ApplyParcGenericStyle() {
+  if (!parc_generic_style_) {
+    return;
+  }
+  const ParcGenericCueStyle& style = *parc_generic_style_;
+  // WebKit colours its cue highlight box, the span around the cue's text
+  // (Blink's background box here), with the foreground and highlight
+  // colours, and the cue's box with the background colour.
+  if (style.foreground_color) {
+    cue_background_box_->SetInlineStyleProperty(
+        CSSPropertyID::kColor, ParcCssColor(*style.foreground_color));

+namespace {
+
+String ParcCssColor(uint32_t rgba) {
+  StringBuilder builder;
+  builder.Append("rgba(");
+  builder.AppendNumber(rgba >> 24);
+  builder.Append(", ");
+  builder.AppendNumber((rgba >> 16) & 0xff);
+  builder.Append(", ");
+  builder.AppendNumber((rgba >> 8) & 0xff);
+  builder.Append(", ");
+  builder.AppendNumber((rgba & 0xff) / 255.0);
+  builder.Append(")");
+  return builder.ToString();
+}
+
+}  // namespace
+
+void VTTCue::ApplyParcGenericStyle() {
+  if (!parc_generic_style_) {
+    return;
+  }
+  const ParcGenericCueStyle& style = *parc_generic_style_;
+  // WebKit colours its cue highlight box, the span around the cue's text
+  // (Blink's background box here), with the foreground and highlight
+  // colours, and the cue's box with the background colour.
+  if (style.foreground_color) {
+    cue_background_box_->SetInlineStyleProperty(
+        CSSPropertyID::kColor, ParcCssColor(*style.foreground_color));
+  }
+  if (style.highlight_color) {
+    cue_background_box_->SetInlineStyleProperty(
+        CSSPropertyID::kBackgroundColor, ParcCssColor(*style.highlight_color));
+  }
+  if (style.background_color) {
+    display_tree_->SetInlineStyleProperty(
+        CSSPropertyID::kBackgroundColor, ParcCssColor(*style.background_color));
+  }
+  // WebKit keeps a generic cue on one line only when it says so
+  // (VTTCueBox::applyCSSProperties); Blink does it for every cue that doesn't
+  // snap to lines, which generic cues never do.
+  if (!style.prevent_line_wrapping) {
+    display_tree_->RemoveInlineStyleProperty(CSSPropertyID::kWhiteSpaceCollapse);
+    display_tree_->RemoveInlineStyleProperty(CSSPropertyID::kTextWrapMode);
+  }

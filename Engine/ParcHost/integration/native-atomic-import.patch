+
+HistoryBackend::ImportPagesResult HistoryBackend::ImportPagesWithDetails(
+    const URLRows& urls,
+    VisitSource visit_source,
+    const base::RepeatingCallback<bool()>& is_cancelled) {
+  ImportPagesResult result;
+  result.cancelled = is_cancelled.Run();
+  if (!db_ || result.cancelled)
+    return result;
+  if (urls.empty()) {
+    result.committed = true;
+    return result;
+  }
+
+  // Finish earlier ordinary history work before opening the import's atomic
+  // batch. Never roll back another writer's pending transaction on cancellation.
+  CancelScheduledCommit();
+  if (!CommitSingletonTransactionIfItExists()) {
+    BeginSingletonTransaction();
+    return result;
+  }
+  BeginSingletonTransaction();
+  if (!singleton_transaction_)
+    return result;
+  const base::Time previous_first_recorded_time = first_recorded_time_;
+  URLRows changed_urls;
+  const bool inserted =
+      AddPagesWithDetailsImpl(urls, visit_source, &result, &changed_urls);
+  result.cancelled = is_cancelled.Run();
+  if (!inserted || result.cancelled) {
+    // Transaction destruction rolls back the exact batch; no change
+    // notification has been sent for it.
+    singleton_transaction_.reset();
+    first_recorded_time_ = previous_first_recorded_time;
+    result.imported = 0;
+    if (db_)
+      BeginSingletonTransaction();
+    return result;
+  }
+  result.committed = CommitSingletonTransactionIfItExists();
+  if (!result.committed) {
+    first_recorded_time_ = previous_first_recorded_time;
+    result.imported = 0;
+  }
+  if (db_)
+    BeginSingletonTransaction();
+  if (result.committed)
+    NotifyURLsModified(changed_urls, /*is_from_expiration=*/false);
+  return result;
+}

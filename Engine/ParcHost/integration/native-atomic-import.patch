+bool WebDatabase::RunAtomicImport(base::OnceCallback<bool()> write) {
+  if (!db_.is_open())
+    return false;
+  if (db_.HasActiveTransactions()) {
+    // Never commit or roll back another active scoped caller, or a nested
+    // transaction. The legacy backend owns exactly one outer transaction.
+    if (use_scoped_transaction_ || db_.transaction_nesting() != 1)
+      return false;
+    if (!db_.CommitTransactionDeprecated()) {
+      db_.BeginTransactionDeprecated();
+      return false;
+    }
+  }
+  bool committed = false;
+  {
+    sql::Transaction transaction(&db_);
+    if (transaction.Begin() && std::move(write).Run())
+      committed = transaction.Commit();
+  }
+  if (!use_scoped_transaction_)
+    db_.BeginTransactionDeprecated();
+  return committed;
 }
 

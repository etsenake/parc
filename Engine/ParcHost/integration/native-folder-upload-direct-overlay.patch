+
+bool BubbleDialogModelHost::AcceptModel() {
+  if (!native_acceptance_validation_) {
+    return model_->OnDialogAcceptAction(DialogModelHost::GetPassKey());
+  }
+  auto weak = weak_ptr_factory_.GetWeakPtr();
+  // Copy because native validation may close/destroy this host or its model.
+  auto validation = native_acceptance_validation_;
+  const bool allowed = validation.Run();
+  if (!weak || !model_ || (GetWidget() && GetWidget()->IsClosed())) {
+    return true;
+  }
+  return allowed ? model_->OnDialogAcceptAction(DialogModelHost::GetPassKey())
+                 : model_->OnDialogCancelAction(DialogModelHost::GetPassKey());
+}

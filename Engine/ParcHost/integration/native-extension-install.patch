 void ExtensionInstallPrompt::OnInstallFailure(
     const extensions::CrxInstallError& error) {
+  if (native_) {
+    if (skip_native_post_install_ui_) return;
+    if (error.type() !=
+            extensions::CrxInstallErrorType::SANDBOXED_UNPACKER_FAILURE &&
+        (error.detail() == extensions::CrxInstallErrorDetail::USER_CANCELED ||
+         error.detail() == extensions::CrxInstallErrorDetail::USER_ABORTED)) {
+      return;
+    }
+    native_->InstallationFinished(extension_.get(), false, error.message());
+    return;
+  }
   install_ui_->OnInstallFailure(error);
 }
 

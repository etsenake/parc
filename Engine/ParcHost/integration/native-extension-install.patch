 namespace {
+
+// The existing native binding captures the original page/profile before
+// credentials or asynchronous work. Non-native browsers retain the Views UI.
+class NativeParentPermissionDialog final : public ParentPermissionDialog {
+ public:
+  NativeParentPermissionDialog(
+      std::shared_ptr<extensions::ExtensionInstallNativeBinding> binding,
+      const extensions::Extension* extension, const gfx::ImageSkia& icon,
+      DoneCallback done)
+      : binding_(std::move(binding)), extension_(extension), icon_(icon),
+        done_(std::move(done)) {}
+  ~NativeParentPermissionDialog() override { binding_->Cancel(); }
+  void ShowDialog() override {
+    if (!done_) return;
+    binding_->ShowParentApproval(extension_.get(), icon_, base::BindOnce(
+        [](DoneCallback done,
+           extensions::ExtensionInstallPromptClient::DoneCallbackPayload payload) {
+          using InstallResult = extensions::ExtensionInstallPromptClient::Result;
+          const Result result = payload.result == InstallResult::ACCEPTED
+              ? Result::kParentPermissionReceived
+              : payload.result == InstallResult::USER_CANCELED
+                  ? Result::kParentPermissionCanceled
+                  : Result::kParentPermissionFailed;
+          std::move(done).Run(result);
+        }, std::move(done_)));
+  }
+ private:
+  std::shared_ptr<extensions::ExtensionInstallNativeBinding> binding_;
+  scoped_refptr<const extensions::Extension> extension_;
+  gfx::ImageSkia icon_;
+  DoneCallback done_;
+};
 

+void BrowserDelegate::PrepareNativeDevtoolsContents(
+    content::WebContents* inspected,
+    content::WebContents& tools) {
+#if BUILDFLAG(IS_MAC)
+  if (!inspected ||
+      inspected->GetBrowserContext() != tools.GetBrowserContext()) {
+    return;
+  }
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(inspected);
+  auto* owner = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!owner || owner->IsDeleteScheduled() || !owner->cef_delegate() ||
+      !owner->cef_delegate()->IsNativeWindow()) {
+    return;
+  }
+  auto* profile = Profile::FromBrowserContext(tools.GetBrowserContext());
+  if (parc::GetNativeRoute(*profile)) {
+    parc::PrepareNativeAuxiliaryServices(tools);
+  }
+#endif
+}
+std::optional<bool> BrowserDelegate::HandleNativeDevtoolsKey(
+    content::WebContents* inspected,
+    content::WebContents* tools,
+    const input::NativeWebKeyboardEvent& event) {
+#if BUILDFLAG(IS_MAC)
+  if (tools) {
+    auto* profile = Profile::FromBrowserContext(tools->GetBrowserContext());
+    if (auto route = parc::GetNativeRoute(*profile)) {
+      return route->provider().HandleDevtoolsKey(inspected, *tools, event);
+    }
+  }
+#endif
+  return std::nullopt;
+}
+bool BrowserDelegate::HasNativeRoute(Profile& profile) {
+#if BUILDFLAG(IS_MAC)
+  return !!parc::GetNativeRoute(profile) ||
+         (profile.GetOriginalProfile() != &profile &&
+          !!parc::GetNativeRoute(*profile.GetOriginalProfile()));
+#else
+  return false;
+#endif

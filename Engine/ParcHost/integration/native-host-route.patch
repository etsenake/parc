+bool ChromeBrowserDelegate::NativeDeletionReady() const {
+  return !IsNativeWindow() || native_deletion_ == NativeDeletionState::kReady;
+}
+bool ChromeBrowserDelegate::DeferBrowserDeletion(base::OnceClosure retry) {
+#if BUILDFLAG(IS_MAC)
+  if (!IsNativeWindow() || NativeDeletionReady()) {
+    return false;
+  }
+  if (native_deletion_ == NativeDeletionState::kDraining) {
+    return true;
+  }
+  native_deletion_ = NativeDeletionState::kDraining;
+  auto browser = browser_->GetWeakPtr();
+  create_params_.native_route->provider().PrepareBrowserForDeletion(
+      *browser_,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             base::OnceClosure retry) {
+            // Never destroy the Browser on the service's final callback stack.
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](base::WeakPtr<BrowserWindowInterface> browser,
+                       base::OnceClosure retry) {
+                      if (!browser) {
+                        return;
+                      }
+                      auto* delegate = static_cast<ChromeBrowserDelegate*>(
+                          browser->cef_delegate());
+                      CHECK(delegate && delegate->native_deletion_ ==
+                                            NativeDeletionState::kDraining);
+                      delegate->native_deletion_ = NativeDeletionState::kReady;
+                      std::move(retry).Run();
+                    },
+                    browser, std::move(retry)));
+          },
+          browser, std::move(retry)));
+  return true;
+#else
+  return false;
+#endif
+}
+bool ChromeBrowserDelegate::IsNativeWindow() const {
+  return !!create_params_.native_route;
+}
+BrowserWindow* ChromeBrowserDelegate::CreateNativeBrowserWindow() {
+#if BUILDFLAG(IS_MAC)
+  CHECK(create_params_.native_route && create_params_.native_reservation);
+  return new parc::NativeBrowserWindow(
+      *browser_, create_params_.native_reservation->Bind(*browser_));
+#else
+  return nullptr;
+#endif
+}
+void ChromeBrowserDelegate::OnBrowserRegistered() {
+#if BUILDFLAG(IS_MAC)
+  if (!IsNativeWindow()) {
+    return;
+  }
+  auto reservation = std::exchange(create_params_.native_reservation, {});
+  CHECK(reservation);
+  auto* window = static_cast<parc::NativeBrowserWindow*>(browser_->GetWindow());
+  CHECK(window->AttachToNativeWindow(reservation->GetNativeWindow()));
+#endif
+}

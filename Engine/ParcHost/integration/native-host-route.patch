+// static
+void BrowserManagerService::RequestBrowserDeletion(
+    BrowserWindowInterface* browser) {
+  CHECK(browser);
+  auto* manager =
+      BrowserManagerServiceFactory::GetForProfile(browser->GetProfile());
+  // Membership is checked before invoking a native service; already removed
+  // Browsers and repeated drain requests cannot produce duplicate destruction.
+  if (!std::ranges::any_of(manager->browsers_and_subscriptions_,
+                           [browser](const BrowserAndSubscriptions& entry) {
+                             return entry.browser.get() == browser;
+                           })) {
+    return;
+  }
+#if BUILDFLAG(ENABLE_CEF)
+  if (auto* delegate = browser->cef_delegate();
+      delegate && delegate->DeferBrowserDeletion(base::BindOnce(
+                      [](base::WeakPtr<BrowserWindowInterface> browser) {
+                        if (browser) {
+                          RequestBrowserDeletion(browser.get());
+                        }
+                      },
+                      browser->GetWeakPtr()))) {
+    return;
+  }
+#endif
+  // The native ready callback is posted after engine host destruction. This
+  // function may delete manager/Profile; do not access either after this call.
+  manager->DeleteBrowser(browser);
+}

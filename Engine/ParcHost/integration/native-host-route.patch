+bool DevToolsWindow::PerformNativePageAction(
+    content::WebContents* inspected,
+    const DevToolsToggleAction& action,
+    base::RepeatingCallback<bool()> is_current) {
+  const auto inspected_owner = inspected ? inspected->GetWeakPtr() : nullptr;
+  if (!inspected_owner || !is_current || !is_current.Run() || !inspected_owner) {
+    return false;
+  }
+  auto* window = GetInstanceForInspectedWebContents(inspected);
+  if (!window) {
+    const auto initial = action.type() == DevToolsToggleAction::kShow
+                             ? DevToolsToggleAction::ShowNativePanel("elements")
+                             : action;
+    const auto weak_contents = inspected->GetWeakPtr();
+    OpenDevToolsWindow(inspected, initial,
+                      DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+    return weak_contents && GetInstanceForInspectedWebContents(weak_contents.get());
+  }
+  if (window->life_stage_ == kClosing) {
+    return false;
+  }
+  if (action.type() == DevToolsToggleAction::kShow) {
+    window->CloseWindow();
+    return true;
+  }
+  if (action.type() != DevToolsToggleAction::kShowNativePanel ||
+      window->life_stage_ != kLoadCompleted) {
+    window->ScheduleShow(action);
+    return true;
+  }
+  // Query the actual frontend, never infer selection from the last command or
+  //
+  const uint64_t generation = ++window->native_action_generation_;
+  const auto document =
+      window->main_web_contents_->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  window->bindings_->CallClientMethod(
+      "InspectorFrontendAPI", "currentPanel", {}, {}, {},
+      base::BindOnce(
+          [](base::WeakPtr<DevToolsWindow> owner, uint64_t generation,
+             content::WeakDocumentPtr document, DevToolsToggleAction action,
+             base::RepeatingCallback<bool()> is_current, base::Value result) {
+            if (!owner || owner->life_stage_ != kLoadCompleted ||
+                owner->native_action_generation_ != generation ||
+                !document.AsRenderFrameHostIfValid() || !is_current.Run() ||
+                !owner || owner->life_stage_ != kLoadCompleted ||
+                owner->native_action_generation_ != generation ||
+                !document.AsRenderFrameHostIfValid()) {
+              return;
+            }
+            // Missing/failed frontend replies perform no action. In particular,
+            // a missing query capability must not manufacture a selected panel.
+            if (!result.is_string()) {
+              return;
+            }
+            if (result.GetString() == action.native_panel()) {
+              owner->CloseWindow();
+            } else {
+              owner->ScheduleShow(action);
+            }
+          },
+          window->weak_factory_.GetWeakPtr(), generation, document, action,
+          std::move(is_current)));
+  return true;

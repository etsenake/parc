+#if BUILDFLAG(IS_MAC)
+  Profile& profile = *params.profile;
+  auto route = parc::GetNativeRoute(profile);
+  auto* supplied = static_cast<ChromeBrowserHostImpl::DelegateCreateParams*>(
+      params.cef_params.get());
+  CefBrowserCreateParams native_params;
+  if (supplied) {
+    native_params = supplied->create_params_;
+  }
+  if (native_params.native_route && native_params.native_route != route) {
+    LOG(ERROR) << "Native route does not belong to exact Browser profile";
+    return false;
+  }
+  if (!route) {
+    auto original_route = parc::GetNativeRoute(*profile.GetOriginalProfile());
+    if (original_route) {
+      original_route->provider().CreationFailed(
+          profile,
+          "This private profile has no registered native window route");
+      return false;
+    }
+    if (params.opener && params.opener->cef_delegate() &&
+        params.opener->cef_delegate()->IsNativeWindow()) {
+      LOG(ERROR)
+          << "Native opener cannot create an unregistered profile window";
+      return false;
+    }
+    return true;
+  }
+  auto weak_profile = profile.GetWeakPtr();
+  auto fail = [&](const std::string& message) {
+    if (weak_profile) {
+      route->provider().CreationFailed(*weak_profile, message);
+    }
+    return false;
+  };
+  if (params.window || native_params.window_info ||
+      native_params.browser_view || !native_params.IsChromeStyle() ||
+      native_params.IsWindowless()) {
+    return fail("Native route cannot use a Views, child, Alloy or OSR window");
+  }
+  if (profile.GetProfilePolicyConnector()->IsManaged()) {
+    return fail("Managed profile native data-protection UI is unavailable");
+  }
+  if (native_params.client && native_params.client != route->client()) {
+    return fail("Native creation requires its registered lifecycle client");
+  }
+  native_params.native_route = route;
+  native_params.client = route->client();
+  native_params.popup_with_views_hosted_opener = false;
+  native_params.popup_with_alloy_style_opener = false;
+  if (!native_params.native_reservation) {
+    parc::NativeWindowRequest request{
+        profile, params.type,
+        params.type == BrowserWindowInterface::TYPE_DEVTOOLS
+            ? parc::NativeWindowReason::kDevTools
+            : (params.type == BrowserWindowInterface::TYPE_POPUP ||
+               params.type == BrowserWindowInterface::TYPE_APP_POPUP)
+                  ? parc::NativeWindowReason::kPopup
+                  : parc::NativeWindowReason::kInternal,
+        params.opener, nullptr, params.from_user_gesture};
+    request.initial_bounds = params.initial_bounds;
+    request.initial_origin_specified =
+        params.initial_origin_specified ==
+            BrowserWindowCreateParams::ValueSpecified::kSpecified ||
+        (params.initial_origin_specified ==
+             BrowserWindowCreateParams::ValueSpecified::kUnknown &&
+         !params.initial_bounds.origin().IsOrigin());
+    request.can_resize = params.can_resize;
+    request.can_maximize = params.can_maximize;
+    request.can_fullscreen = params.can_fullscreen;
+    auto prepared = route->Prepare(request);
+    if (!prepared.has_value()) {
+      return fail(prepared.error());
+    }
+    native_params.native_reservation = std::move(*prepared);
+  }
+  if (!weak_profile ||
+      !native_params.native_reservation->CanBind(profile, params.type)) {
+    return fail("Native window reservation expired or was already consumed");
+  }
+  // Always clone: no shared CreateParams mutation can overwrite another
+  // pending creation. Only this Browser consumes this reservation.
+  params.cef_params =
+      base::MakeRefCounted<ChromeBrowserHostImpl::DelegateCreateParams>(
+          native_params);
+#endif
+  return true;
+}
 

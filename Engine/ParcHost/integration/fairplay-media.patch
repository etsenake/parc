+void MediaInterfaceProxy::CreateFairPlayHlsPlayer(
+    mojo::PendingReceiver<media::mojom::FairPlayHlsPlayer> player,
+    mojo::PendingRemote<media::mojom::FairPlayHlsPlayerClient> client,
+    mojo::PendingRemote<media::mojom::FairPlayHlsPlayerLifetime> lifetime) {
+  CHECK(thread_checker_.CalledOnValidThread(), base::NotFatalUntil::M160);
+
+  // The player lives in the same media service as the frame's FairPlay CDMs
+  // (see CreateCdm), so its SetCdm() finds them.
+  InterfaceFactory* factory = media_interface_factory_ptr_->Get();
+  if (!factory) {
+    return;
+  }
+
+  // The render process's handle, if any, is dropped: the GPU player holds the
+  // browser's, which carries the frame's audibility-bypass grant.
+  mojo::PendingRemote<media::mojom::FairPlayHlsPlayerLifetime>
+      browser_lifetime;
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<FairPlayHlsPlayerLifetimeImpl>(
+          AudibilityBypassTracker::AddGrant(&render_frame_host())),
+      browser_lifetime.InitWithNewPipeAndPassReceiver());
+  factory->CreateFairPlayHlsPlayer(std::move(player), std::move(client),
+                                   std::move(browser_lifetime));
+}

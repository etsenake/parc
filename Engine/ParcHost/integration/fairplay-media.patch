+TEST_F(ChunkDemuxerTest, ParcSafariEviction_DataAfterThePlayableSegment) {
+  ASSERT_TRUE(InitDemuxer(HAS_AUDIO));
+  demuxer_->ParcSetSafariEviction(true);

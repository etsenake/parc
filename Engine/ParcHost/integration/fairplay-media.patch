+// Parc: WebKit's PlatformTimeRanges::nearest(): |time| when a range holds it,
+// ends included, else the closest range boundary, the first found on a tie;
+// kNoTimestamp without ranges.
+base::TimeDelta ParcNearest(const Ranges<base::TimeDelta>& ranges,
+                            base::TimeDelta time) {
+  base::TimeDelta nearest = kNoTimestamp;
+  base::TimeDelta nearest_distance = base::TimeDelta::Max();
+  for (size_t i = 0; i < ranges.size(); ++i) {
+    if (time >= ranges.start(i) && time <= ranges.end(i)) {
+      return time;
+    }
+    for (const base::TimeDelta boundary : {ranges.start(i), ranges.end(i)}) {
+      if ((boundary - time).magnitude() < nearest_distance) {
+        nearest = boundary;
+        nearest_distance = (boundary - time).magnitude();
+      }
+    }
+  }
+  return nearest;
+}

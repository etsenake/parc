 )))
+
+; Parc: FairPlay Streaming playback in the media service (AVContentKeySession,
+; AVSampleBufferDisplayLayer, AVSampleBufferAudioRenderer). Rules follow
+; WebKit's GPU process profile (com.apple.WebKit.GPUProcess.sb) and Chromium's
+; audio service profile (audio.sb), which already hosts an
+; AVSampleBufferAudioRenderer. IPC shared memory for CoreAudio ("AudioIO") and
+; preference reads are already allowed above.
+(allow mach-lookup
+  ; FairPlay Streaming key daemon: SPC creation and CKC processing for
+  ; AVContentKeySession (WebKit GPUProcess.sb; also in the App Sandbox).
+  (global-name "com.apple.lskdd")
+  (global-name "com.apple.lskdd.xpc")
+  ; CoreAudio HAL for AVSampleBufferAudioRenderer output (audio.sb).
+  (global-name "com.apple.audio.audiohald")
+  (global-name "com.apple.audio.coreaudiod")
+  (global-name "com.apple.audio.AudioSession")
+  ; Needed for AVSampleBufferAudioRenderer creation (audio.sb).
+  (global-name "com.apple.coremedia.routingcontext.xpc")
+  ; Out-of-process audio converters (WebKit GPUProcess.sb) and the HAL
+  ; plug-in helper (audio.sb).
+  (xpc-service-name "com.apple.audio.AudioConverterService")
+  (xpc-service-name "com.apple.audio.SandboxHelper")
+)
+
+; CoreAudio kernel-driver user clients on Intel Macs (audio.sb).
+(allow iokit-open
+  (iokit-user-client-class "IOAudioControlUserClient")
+  (iokit-user-client-class "IOAudioEngineUserClient")
+)
+
+; HAL plug-ins and the component cache read by the CoreAudio client
+; (audio.sb, WebKit GPUProcess.sb).
+(allow file-read*
+  (path (user-homedir-path "/Library/Caches/com.apple.coreaudio.components.plist"))
+  (subpath "/Library/Audio/Plug-Ins/HAL")
+)

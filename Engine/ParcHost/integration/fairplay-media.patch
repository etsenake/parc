+// Parc: WebKit's SourceBufferPrivate::memoryPressure, which a
+// ManagedMediaSource's SourceBuffers run as memory pressure rises. An
+// inactive SourceBuffer is emptied. An active one runs evictFrames(
+// maximumBufferSize, media_time), which removes, across all its tracks,
+// everything before the earlier of 3.75 s before |media_time| and its
+// previous sync sample (findPreviousSyncSamplePresentationTime; each track's
+// removal then runs to its next keyframe, as Remove() does), and everything
+// after the point where playback from |media_time| would stall
+// (MediaSourcePrivate::nextStallTime over this SourceBuffer's intersected
+// track ranges, gaps bridged by MediaSourcePrivate::gapToleranceAtTime), or
+// after 3.75 s past it when it isn't buffered.
+void SourceBufferState::ParcPurgeForMemoryPressure(
+    base::TimeDelta media_time,
+    bool active,
+    base::TimeDelta duration,
+    const Ranges<base::TimeDelta>& buffered,
+    const Ranges<base::TimeDelta>& audio) {
+  const std::vector<ChunkDemuxerStream*> streams = ParcStreams();
+
+  if (!active) {
+    for (ChunkDemuxerStream* stream : streams) {
+      stream->ParcRemoveFrom(base::TimeDelta(), duration);
+    }
+    parc_purged_while_inactive_ = true;
+    return;
+  }
+
+  const base::TimeDelta kTimeChunk = base::Milliseconds(3750);
+
+  const base::TimeDelta front_end = std::min(
+      media_time - kTimeChunk, ParcPreviousSyncTime(media_time, streams));
+  for (ChunkDemuxerStream* stream : streams) {
+    stream->ParcRemoveBefore(front_end, duration);
+  }
+
+  const base::TimeDelta playable_end = ParcPlayableEnd(
+      media_time, ParcOwnRanges(streams, duration), buffered, audio);
+  const base::TimeDelta back_start =
+      playable_end != kNoTimestamp ? playable_end : media_time + kTimeChunk;
+  for (ChunkDemuxerStream* stream : streams) {
+    stream->ParcRemoveFrom(back_start, duration);
+  }
+}

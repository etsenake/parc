+// Parc: video streams get the audio; an audio stream gets none, as WebKit
+// leaves the track asking out and pages carry one audio track.
+void ChunkDemuxer::ParcShareMediaSourceBuffered_Locked(bool seek_was_waiting) {
+  lock_.AssertAcquired();
+  if (!parc_safari_media_source_ || duration_ == kNoTimestamp) {
+    return;
+  }
+  Ranges<base::TimeDelta> buffered;
+  Ranges<base::TimeDelta> audio;
+  ParcMediaSourceRanges_Locked(&buffered, &audio);
+  const base::TimeDelta start =
+      buffered.empty() ? kNoTimestamp : buffered.start(0);
+  for (const auto& stream : audio_streams_) {
+    stream->ParcSetMediaSourceBuffered(start, Ranges<base::TimeDelta>());
+  }
+  for (const auto& stream : video_streams_) {
+    stream->ParcSetMediaSourceBuffered(start, audio);
+  }
+  // A seek the caller's change or the new tolerance lets land completes, as
+  // one an append lets.
+  if (seek_was_waiting && !IsSeekWaitingForData_Locked() && seek_cb_) {
+    RunSeekCB_Locked(PIPELINE_OK);
+  }
+}

+// Parc: Safari's AVPlayer rewinds a file. Each window is decoded forward from
+// the keyframe at or before its end after a demuxer seek, and shown latest
+// frame first; the window before is decoded meanwhile.
+TEST_F(VideoRendererImplTest, ParcPlaysBackwardWindowByWindow) {

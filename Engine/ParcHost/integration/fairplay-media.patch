+std::unique_ptr<StreamParser> ChunkDemuxer::ParcCreateParser_Locked(
+    const std::string& content_type,
+    const std::string& codecs) {
+  lock_.AssertAcquired();
+  if (!parc_safari_init_segment_rules_) {
+    return CreateParserForTypeAndCodecs(content_type, codecs, media_log_.get());
+  }
+  std::optional<StreamParserFactory::ParcSafariType> safari_type =
+      ParcSafariMediaSourceType(content_type, codecs);
+  if (!safari_type) {
+    return nullptr;
+  }
+  std::unique_ptr<StreamParser> stream_parser = StreamParserFactory::Create(
+      safari_type->type, safari_type->codecs, media_log_.get());
+  if (!stream_parser && safari_type->codecs.empty()) {
+    stream_parser =
+        StreamParserFactory::ParcCreateWithoutCodecs(safari_type->type);
+  }
+  return stream_parser;
+}

 // static
+std::unique_ptr<StreamParser> StreamParserFactory::ParcCreateWithoutCodecs(
+    std::string_view type) {
+  if (IsTypeSupported(type, {}) != SupportsType::kMaybeSupported) {
+    return nullptr;
+  }
+  if (type == "video/webm" || type == "audio/webm") {
+    return std::make_unique<WebMStreamParser>();
+  }
+  if (type == "video/mp4" || type == "audio/mp4") {
+    // Dolby Vision as Dolby Vision, as if the codecs named it, rather than as
+    // its cross-compatible codec: no codec string says to do otherwise.
+    return std::make_unique<mp4::MP4StreamParser>(
+        std::nullopt, /*has_sbr=*/false, /*has_flac=*/true,
+        /*has_iamf=*/false, /*has_dv=*/true);
+  }
+#if BUILDFLAG(USE_PROPRIETARY_CODECS) && \
+    BUILDFLAG(ENABLE_MSE_MPEG2TS_STREAM_PARSER)
+  if (type == "video/mp2t") {
+    return std::make_unique<mp2t::Mp2tStreamParser>(std::nullopt,
+                                                    /*has_sbr=*/false);
+  }
+#endif
+  return nullptr;
+}

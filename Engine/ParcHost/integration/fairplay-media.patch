+// process's media service. Implemented by FairPlayRendererClient in the
+// render process.
+[EnableIf=is_mac]
+interface FairPlayRendererClientExtension {
+  // The Renderer's AVSampleBufferDisplayLayer is registered under
+  // `layer_token` in the GPU process's ui::ProtectedLayerRegistry. The client
+  // paints a video hole frame naming the token, sized `natural_size`, and the
+  // compositor places the layer where that frame is drawn.
+  OnLayerRegistered(mojo_base.mojom.UnguessableToken layer_token,
+                    gfx.mojom.Size natural_size);
+};
+
+// Parc: Safari's native HLS route. An AVPlayer in the GPU process's media
+// service, next to the frame's FairPlay CDMs, plays <video src="....m3u8"> on
+// pages that present Safari's identity; every load AVFoundation makes is
+// fetched by the render process through the element's loader. See
+// NATIVE_HLS.md beside third_party/parc_fairplay's sources in the Parc
+// repository.

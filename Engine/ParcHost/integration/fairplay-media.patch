+
+void MultiBufferDataSource::ParcLoadThroughUrlIndex(UrlIndex& url_index) {
+  int64_t position = kPositionNotSpecified;
+  {
+    base::AutoLock auto_lock(lock_);
+    if (stop_signal_received_) {
+      return;
+    }
+    if (read_op_) {
+      position = read_op_->position();
+    } else if (reader_) {
+      position = reader_->Tell();
+    }
+  }
+  scoped_refptr<UrlData> moved = url_index.GetByUrl(
+      url_data_->url(), url_data_->cors_mode(), UrlData::kCacheDisabled,
+      url_data_->security_origin(), url_data_->encoding_mode());
+  moved->ParcCopyResponseInfo(*url_data_);
+  moved->multibuffer()->MergeFrom(url_data_->multibuffer());
+  redirect_weak_factory_.InvalidateWeakPtrs();
+  if (parc_casting_) {
+    url_data_->ParcSetCasting(false);
+    moved->ParcSetCasting(true);
+  }
+  scoped_refptr<UrlData> old_url_data = std::move(url_data_);
+  url_data_ = std::move(moved);
+  url_data_->OnRedirect(blink::BindOnce(&MultiBufferDataSource::OnRedirected,
+                                        redirect_weak_factory_.GetWeakPtr()));
+
+  if (init_cb_) {
+    CreateResourceLoader(0, kPositionNotSpecified);
+    if (reader_->Available()) {
+      PostCrossThreadTask(
+          *render_task_runner_, FROM_HERE,
+          CrossThreadBindOnce(&MultiBufferDataSource::StartCallback,
+                              weak_ptr_));
+    } else {
+      reader_->Wait(1, blink::BindOnce(&MultiBufferDataSource::StartCallback,
+                                       weak_ptr_));
+    }
+    return;
+  }
+  if (position == kPositionNotSpecified) {
+    SetReader(nullptr);
+    return;
+  }
+  CreateResourceLoader(position, kPositionNotSpecified);
+  if (read_op_) {
+    if (reader_->Available()) {
+      PostCrossThreadTask(
+          *render_task_runner_, FROM_HERE,
+          CrossThreadBindOnce(&MultiBufferDataSource::ReadTask, weak_ptr_));
+    } else {
+      reader_->Wait(
+          1, blink::BindOnce(&MultiBufferDataSource::ReadTask, weak_ptr_));
+    }
+  }
+}

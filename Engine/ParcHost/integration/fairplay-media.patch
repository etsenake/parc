+      std::make_unique<FairPlayHlsPlayerLifetimeImpl>(
+          AudibilityBypassTracker::AddGrant(&render_frame_host())),
+      browser_lifetime.InitWithNewPipeAndPassReceiver());
+  factory->CreateFairPlayHlsPlayer(std::move(player), std::move(client),
+                                   std::move(browser_lifetime));

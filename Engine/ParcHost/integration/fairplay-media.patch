+
+void RemotePlayback::ParcMoveToElementContext() {
+  ExecutionContext* context = media_element_->GetExecutionContext();
+  if (!parc_follows_element_ || !context || context->IsContextDestroyed() ||
+      context == GetExecutionContext()) {
+    return;
+  }
+  // A context can't lose an observer while it tells them it went; this one's
+  // ContextDestroyed() moves on after.
+  if (GetExecutionContext() && GetExecutionContext()->IsContextDestroyed()) {
+    return;
+  }
+  // The old frame's controller may be gone already.
+  StopListeningForAvailability();
+  is_listening_ = false;
+  availability_ = mojom::ScreenAvailability::UNKNOWN;
+  SetExecutionContext(context);
+  MaybeStartListeningForAvailability();
+}

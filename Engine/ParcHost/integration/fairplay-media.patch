+      if (held_widevine_cdm_callbacks_.size() >= kMaxHeldWidevineCdmRequests) {
+        std::move(create_cdm_cb)
+            .Run(mojo::NullRemote(), nullptr,
+                 media::CreateCdmStatus::kCdmCreationAborted);
+        return;
+      }
+      DVLOG(1) << __func__ << ": Widevine CDM request held";

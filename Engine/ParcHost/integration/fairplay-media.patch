+// static
+std::optional<StreamParserFactory::ParcSafariType>
+StreamParserFactory::ParcSafariMediaSourceType(
+    std::string_view type,
+    base::span<const std::string> codecs) {
+  static constexpr auto kIsoBmffTypes = std::to_array<std::string_view>(
+      {"application/mp4", "audio/3gpp", "audio/3gpp2", "audio/mp4",
+       "audio/x-m4a", "audio/x-m4b", "audio/x-m4p", "audio/x-m4r",
+       "audio/x-quicktime", "video/3gpp", "video/3gpp2", "video/quicktime",
+       "video/x-m4v"});
+  static constexpr auto kMp3Types = std::to_array<std::string_view>(
+      {"audio/mp3", "audio/mpeg", "audio/mpeg3", "audio/mpg", "audio/x-mp3",
+       "audio/x-mpeg", "audio/x-mpeg3", "audio/x-mpg"});
+
+  ParcSafariType result{std::string(type),
+                        std::vector<std::string>(codecs.begin(), codecs.end())};
+#if BUILDFLAG(ENABLE_PLATFORM_IAMF_AUDIO) || BUILDFLAG(ENABLE_IAMF_TOOLS)
+  if (std::ranges::any_of(result.codecs, [](const std::string& codec_id) {
+        return base::MatchPattern(codec_id, kIAMFCodecInfo1.pattern) ||
+               base::MatchPattern(codec_id, kIAMFCodecInfo2.pattern);
+      })) {
+    return std::nullopt;
+  }
+#endif  // BUILDFLAG(ENABLE_PLATFORM_IAMF_AUDIO) || ...
+  if (std::ranges::find(kIsoBmffTypes, type) != kIsoBmffTypes.end()) {
+    result.type = "video/mp4";
+  } else if (std::ranges::find(kMp3Types, type) != kMp3Types.end()) {
+    result.type = "audio/mpeg";
+    std::erase(result.codecs, "mp3");
+  } else if (type == "audio/aacp") {
+    result.type = "audio/aac";
+#if BUILDFLAG(USE_PROPRIETARY_CODECS)
+  } else if (type == "audio/aac") {
+    NullMediaLog media_log;
+    std::erase_if(result.codecs, [&media_log](const std::string& codec_id) {
+      return base::MatchPattern(codec_id, kMPEG2AACLCCodecInfo.pattern) ||
+             (base::MatchPattern(codec_id, kMPEG4AACCodecInfo.pattern) &&
+              ValidateMP4ACodecID(codec_id, &media_log));
+    });

+void RendererImpl::ParcJoin(DemuxerStream* stream,
+                            base::OnceClosure join_completed_cb) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  raw_ptr<DemuxerStream>& awaiting_cdm =
+      stream->type() == DemuxerStream::AUDIO ? parc_audio_join_awaiting_cdm_
+                                             : parc_video_join_awaiting_cdm_;
+  if (ParcAwaitsCdm(stream) || ParcCannotDecrypt(stream)) {
+    const bool was_waiting = WaitingForEnoughData();
+    awaiting_cdm = ParcAwaitsCdm(stream) ? stream : nullptr;
+    if (awaiting_cdm) {
+      OnWaiting(WaitingReason::kNoCdm);
+    }
+    ParcUpdateWaiting(was_waiting, BUFFERING_CHANGE_REASON_UNKNOWN);
+    std::move(join_completed_cb).Run();
+    return;
+  }
+  if (awaiting_cdm != stream) {
+    awaiting_cdm = nullptr;
+  }
+  (stream->type() == DemuxerStream::AUDIO ? parc_audio_joining_
+                                          : parc_video_joining_) = true;
+  auto client = std::make_unique<RendererClientInternal>(stream->type(), this,
+                                                         media_resource_);
+  auto initialized_cb =
+      base::BindOnce(&RendererImpl::OnParcJoinInitialized, weak_this_, stream,
+                     std::move(join_completed_cb));
+  if (stream->type() == DemuxerStream::AUDIO) {
+    audio_renderer_client_ = std::move(client);
+    parc_audio_renderer_->Initialize(stream, cdm_context_,
+                                     audio_renderer_client_.get(),
+                                     std::move(initialized_cb));
+  } else {
+    video_renderer_client_ = std::move(client);
+    parc_video_renderer_->Initialize(
+        stream, cdm_context_, video_renderer_client_.get(),
+        base::BindRepeating(&RendererImpl::GetWallClockTimes,
+                            base::Unretained(this)),
+        std::move(initialized_cb));
+  }

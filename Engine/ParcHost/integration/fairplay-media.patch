 void MediaInterfaceProxy::CreateCdm(const media::CdmConfig& cdm_config,
                                     CreateCdmCallback create_cdm_cb) {
   CHECK(thread_checker_.CalledOnValidThread(), base::NotFatalUntil::M160);
   DVLOG(1) << __func__ << ": cdm_config=" << cdm_config;
+
+  // Parc: let the observer hold a Widevine CDM request. A copy, in case the
+  // observer replaces itself while it runs.
+  parc::fairplay::WidevineCdmRequestObserver widevine_observer =
+      WidevineCdmRequestObserverSlot();
+  if (widevine_observer && IsWidevineKeySystemName(cdm_config.key_system)) {
+    base::WeakPtr<MediaInterfaceProxy> weak_this = weak_factory_.GetWeakPtr();
+    const bool hold =
+        widevine_observer.Run(&render_frame_host(), cdm_config.key_system);
+    if (!weak_this) {
+      // The observer ended this document; its pipes are already closed.
+      return;
+    }
+    if (hold) {
+      if (held_widevine_cdm_callbacks_.size() >= kMaxHeldWidevineCdmRequests) {
+        std::move(create_cdm_cb)
+            .Run(mojo::NullRemote(), nullptr,
+                 media::CreateCdmStatus::kCdmCreationAborted);
+        return;
+      }
+      DVLOG(1) << __func__ << ": Widevine CDM request held";
+      held_widevine_cdm_callbacks_.push_back(std::move(create_cdm_cb));
+      return;
+    }
+  }
+
+#if BUILDFLAG(IS_MAC)
+  // Parc: FairPlay Streaming CDMs are created by the media service in the GPU
+  // process, which also hosts the FairPlay renderers that join the CDM's
+  // AVContentKeySession. They have no CDM library or CDM process.
+  // Everything the FairPlay CdmInfo matches (CdmRegistryImpl::MatchKeySystem
+  // takes any sub key system) stays on this path: the library path below
+  // would hit its empty-CDM-path NOTREACHED for a name like "com.apple.fps.".
+  if (cdm_config.key_system == parc::fairplay::kFairPlayKeySystem ||
+      media::IsSubKeySystemOf(cdm_config.key_system,
+                              parc::fairplay::kFairPlayKeySystem)) {
+    // Like every other CDM, only once registered (CdmRegistryImpl::Init), so
+    // a renderer can't create one that Blink never offered.

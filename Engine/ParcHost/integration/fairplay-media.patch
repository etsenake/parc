+
+bool WebMediaPlayerMS::ParcMoveToFrame(ParcFrameServices services) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (!parc_frame_task_runner_ ||
+      services.frame == internal_frame_->web_frame()) {
+    return false;
+  }
+  internal_frame_ =
+      std::make_unique<MediaStreamInternalFrameWrapper>(services.frame);
+  parc_frame_task_runner_->SetTarget(
+      services.frame->GetTaskRunner(TaskType::kInternalMedia));
+
+  delegate_->PlayerGone(delegate_id_);
+  delegate_->RemoveObserver(delegate_id_);
+  delegate_ = services.delegate;
+  delegate_id_ = delegate_->AddObserver(this);
+  delegate_->DidMediaMetadataChange(delegate_id_, HasAudio(), HasVideo(),
+                                    media::MediaContentType::kOneShot);
+  if (paused_) {
+    delegate_->SetIdle(delegate_id_, true);
+  } else {
+    delegate_->DidPlay(delegate_id_);
+    delegate_->SetIdle(delegate_id_, false);
+  }
+
+  if (audio_renderer_) {
+    audio_renderer_->Stop();
+    audio_renderer_ = renderer_factory_->GetAudioRenderer(
+        web_stream_, services.frame, parc_audio_output_device_id_,
+        blink::BindRepeating(&WebMediaPlayerMS::OnAudioRenderErrorCallback,
+                             weak_factory_.GetWeakPtr()));
+    if (audio_renderer_) {
+      audio_renderer_->SetVolume(volume_);
+      audio_renderer_->Start();
+      if (!paused_) {
+        audio_renderer_->Play();
+      }
+    }
+  }
+  std::move(services.move_media_log).Run(*media_log_);
+  return true;
+}
+
+void WebMediaPlayerMS::ParcReportStateToClient() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (ready_state_ >= kReadyStateHaveMetadata) {
+    if (auto* parc = client_->ParcClient()) {
+      parc->ParcReportMediaMetadata(HasAudio(), HasVideo(),
+                                    media::MediaContentType::kOneShot);
+    }
+    if (HasVideo()) {
+      client_->DidPlayerSizeChange(NaturalSize());
+    }
+  }
+  client_->DidPlayerMutedStatusChange(volume_ == 0.0);
+  if (!paused_) {
+    client_->DidPlayerStartPlaying();
+  }
+  client_->DidPlayerMediaPositionStateChange(
+      /*playback_rate=*/1.0, base::Seconds(Duration()),
+      base::Seconds(CurrentTime()), /*end_of_media=*/false);
+}

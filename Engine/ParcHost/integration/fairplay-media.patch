+      base::BindRepeating(&MojoCdmServiceContext::GetCdmContextRef,
+                          base::Unretained(&cdm_service_context_)),
+      std::move(client), std::move(lifetime));
+  if (!service) {
+    DLOG(ERROR) << "FairPlay HLS player creation failed.";
+    return;
+  }
+
+  fairplay_hls_player_receivers_.Add(std::move(service), std::move(player));
+}

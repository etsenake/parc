+std::unique_ptr<media::Demuxer> WebMediaPlayerImpl::CreateParcNativeHlsDemuxer(
+    media::ParcNativeHlsDemuxerParams params) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // The factory registered for the route makes its demuxer, so the renderers
+  // it makes later find their player there.
+  media::RendererFactory* factory =
+      renderer_factory_selector_->GetFactory(media::RendererType::kFairPlayHls);
+  if (!factory || !url_index_) {
+    return nullptr;
+  }
+  // AVFoundation's loads go out as this element's media requests: its
+  // cookies, referrer, CORS mode and DevTools entries (NATIVE_HLS.md,
+  // Network). A demuxer made again (an HLS restart) gets a fresh loader.
+  parc_hls_loader_ = std::make_unique<FairPlayHlsLoader>(
+      url_index_->fetch_context(), static_cast<UrlData::CorsMode>(cors_mode_),
+      client_->IsAudioElement());
+  params.start_load_cb = parc_hls_loader_->GetStartLoadCallback();
+  // A new player starts from HAVE_METADATA (an HLS restart).
+  parc_native_hls_ready_state_ = media::ParcNativeHlsReadyState::kHaveMetadata;
+  // WebKit's player makes its item only once the element prepares to play
+  // (WebKit's preload rules, not Chromium's); play and seek do it in the GPU
+  // player.
+  params.prepare_to_play = client_->ParcPreparesToPlay();
+  // The player's layer waits at the element's size, as WebKit's does, so
+  // AVFoundation picks the first variant for it (NATIVE_HLS.md).
+  client_->ParcVideoLayerSize(&params.video_layer_size,
+                              &params.video_layer_scale);
+  return factory->CreateParcNativeHlsDemuxer(std::move(params));
+}

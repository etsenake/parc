+// WebKit's MediaSource::monitorSourceBuffers over MediaSourcePrivate's
+// buffered checks, at the current time or a seek's target, run where WebKit
+// runs it: buffered ranges or duration changing, playback progressing, the
+// player stalling or resuming, a seek starting or ending. Then WebKit's
+// player rule (MediaPlayerPrivateMediaSourceAVFObjC::updateStateFromReadyState):
+// with video, HAVE_CURRENT_DATA or more waits for an available frame, which
+// here is the renderer's first HAVE_ENOUGH since the start or the seek (both
+// renderers report it only once a frame decoded there). Without a renderer
+// (an encrypted stream before its CDM) a video element stays at
+// HAVE_METADATA and an audio element follows its buffered ranges. A seek
+// finishes once the pipeline's is done and the renderer has its samples
+// (WebKit's seekTask), not at a readyState change; playback still stalls and
+// resumes on the renderer's own buffering.
+void WebMediaPlayerImpl::ParcMonitorSourceBuffers(bool seek_start) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!ParcMonitorsSourceBuffers() ||
+      ready_state_ < WebMediaPlayer::kReadyStateHaveMetadata) {
+    return;
+  }
+  const std::optional<media::ChunkDemuxer::ParcBufferedState> source =
+      parc_->chunk_demuxer_->ParcGetBufferedState();
+  if (!source) {
+    return;
+  }
+  const bool time_progressing = !paused_ && playback_rate_ != 0 &&
+                                !seeking_ && parc_->renderer_has_enough_;
+  ReadyState state = ParcSourceBufferReadyState(
+      *source, GetCurrentTimeInternal(), time_progressing);
+  // MediaSourcePrivate::waitForTarget runs the monitor only for a target
+  // with no data.
+  if (seek_start && state != WebMediaPlayer::kReadyStateHaveMetadata) {
+    return;
+  }
+  // Chromium's demuxer can complete a seek into a gap wider than WebKit's
+  // tolerance; the renderer then still has a frame at the current time.
+  if (should_notify_time_changed_ && !seeking_ && parc_->renderer_ready_) {
+    state = std::max(state, WebMediaPlayer::kReadyStateHaveCurrentData);
+  }
+  if (state != ready_state_ &&
+      (state < WebMediaPlayer::kReadyStateHaveCurrentData || !HasVideo() ||
+       parc_->renderer_ready_)) {
+    // Warning: This call may be re-entrant.
+    SetReadyState(state);
+  }
+  if (should_notify_time_changed_ && !seeking_ && parc_->renderer_ready_ &&
+      ready_state_ >= WebMediaPlayer::kReadyStateHaveCurrentData) {
+    should_notify_time_changed_ = false;
+    client_->TimeChanged();
+  }
+}

+void MultiBufferDataSource::ParcMoveToUrlIndex(UrlIndex& url_index) {
+  DCHECK(render_task_runner_->BelongsToCurrentThread());
+  if (!url_data_ || failed_) {
+    return;
+  }
+  // A resource read without ranges loads again from the start to go on from
+  // the middle; its load stays with the old frame while it can.
+  if (!init_cb_ && !url_data_->range_supported()) {
+    parc_url_index_for_failure_ = &url_index;
+    return;
+  }
+  parc_url_index_for_failure_ = nullptr;
+  ParcLoadThroughUrlIndex(url_index);
+}
+
+void MultiBufferDataSource::ParcLoadThroughUrlIndex(UrlIndex& url_index) {
+  int64_t position = kPositionNotSpecified;
+  {
+    base::AutoLock auto_lock(lock_);
+    if (stop_signal_received_) {
+      return;
+    }
+    if (read_op_) {
+      position = read_op_->position();
+    } else if (reader_) {
+      position = reader_->Tell();
+    }
+  }
+  // A fresh entry: a cached one of the new index may be another version.
+  scoped_refptr<UrlData> moved = url_index.GetByUrl(
+      url_data_->url(), url_data_->cors_mode(), UrlData::kCacheDisabled,

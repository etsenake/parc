+// Parc: the removals of SourceBufferState::ParcEvictCodedFrames.
+TEST_F(SourceBufferStreamTest, ParcFreeGOPsBefore_StopsAtTheReadPosition) {
+  NewCodedFrameGroupAppend("0K 30 60 90K 120 150 180K 210 240");
+  SeekToTimestampMs(180);
+
+  // Every GOP starting before 100ms goes whole, as WebKit's removal runs to
+  // the next keyframe.
+  EXPECT_GT(stream_->ParcFreeGOPsBefore(base::Milliseconds(100)), 0u);
+  CheckExpectedRangesByTimestamp("{ [180,270) }");
+
+  // Not the GOP holding the next buffer position.
+  EXPECT_EQ(0u, stream_->ParcFreeGOPsBefore(base::Milliseconds(1000)));
+  CheckExpectedRangesByTimestamp("{ [180,270) }");
 }
 
+TEST_F(SourceBufferStreamTest, ParcFreeGOPsFrom_KeepsTheLastAppendedGOP) {
+  NewCodedFrameGroupAppend("0K 30 60 90K 120 150");
+  NewCodedFrameGroupAppend("600K 630 660 690K 720 750");
+  NewCodedFrameGroupAppend("300K 330 360");
+  NewCodedFrameGroupAppend("390K 420 450");
+  CheckExpectedRangesByTimestamp("{ [0,180) [300,480) [600,780) }");
+  SeekToTimestampMs(0);
+
+  // Every GOP starting at or after 200ms goes but the one appended last, which
+  // stays as a range of its own; GarbageCollectIfNeeded() would stop at it.
+  EXPECT_GT(stream_->ParcFreeGOPsFrom(base::Milliseconds(200)), 0u);
+  CheckExpectedRangesByTimestamp("{ [0,180) [390,480) }");
+
+  // Appends continue that GOP.
+  AppendBuffers("480D30");
+  CheckExpectedRangesByTimestamp("{ [0,180) [390,510) }");
+
+  // Nor the GOP holding the next buffer position.
+  EXPECT_GT(stream_->ParcFreeGOPsFrom(base::TimeDelta()), 0u);
+  CheckExpectedRangesByTimestamp("{ [0,90) [390,510) }");
+}

+void PipelineImpl::RendererWrapper::ParcConfigureRenderer(Renderer& renderer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(shared_state_.media_sequence_checker);
+  if (cdm_context_ && !parc_cdm_detached_) {
+    renderer.SetCdm(cdm_context_, base::DoNothing());
+  }
+  if (latency_hint_) {
+    renderer.SetLatencyHint(latency_hint_);
+  }
+  if (render_muted_audio_) {
+    renderer.SetRenderMutedAudio(render_muted_audio_);
+  }
+  renderer.SetPreservesPitch(preserves_pitch_);
+  renderer.SetVolume(volume_);

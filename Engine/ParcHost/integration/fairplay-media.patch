+// Parc: WebKit's SourceBufferPrivate::evictCodedFrames. A SourceBuffer has
+// one budget for all its tracks, as for audio alone until it has video
+// (SourceBuffer::maximumBufferSize), and is full when what it holds plus
+// |new_data_size| reaches it (isBufferFullFor). evictFrames then removes,
+// until it isn't full, chunks of 30 s halved while at least 3 s: first from
+// the start of its data up to the earlier of a chunk before |media_time| and
+// the previous sync sample, then from the end of its data back to where
+// playback from |media_time| stalls (MediaSourcePrivate::nextStallTime), or
+// to a chunk after |media_time| when that isn't buffered. It removes whole
+// GOPs, as GarbageCollectIfNeeded() does (ParcFreeGOPsBefore/From).
+bool SourceBufferState::ParcEvictCodedFrames(
+    base::TimeDelta media_time,
+    size_t new_data_size,
+    base::TimeDelta duration,
+    const Ranges<base::TimeDelta>& buffered,
+    const Ranges<base::TimeDelta>& audio) {
+  const std::vector<ChunkDemuxerStream*> streams = ParcStreams();
+  const size_t maximum = ParcMaximumBufferSize(!video_streams_.empty());
+  const auto is_full = [&] {
+    base::CheckedNumeric<size_t> required = new_data_size;
+    for (ChunkDemuxerStream* stream : streams) {
+      required += stream->GetMemoryUsage();
+    }
+    return !required.IsValid() || required.ValueOrDie() >= maximum;
+  };
+
+  bool full = is_full();
+  if (!full || streams.empty()) {
+    return !full;
+  }
+  for (ChunkDemuxerStream* stream : streams) {
+    stream->ParcPrepareForEviction(media_time);
+  }
+
+  const base::TimeDelta kInitialTimeChunk = base::Seconds(30);
+  const base::TimeDelta kTimeChunkLowThreshold = base::Seconds(3);
+
+  // Each removal starts (from the front) or ends (from the back) where the
+  // previous one stopped, as WebKit's do: a GOP a removal keeps (the last
+  // appended one, which WebKit removes too) would otherwise hold the
+  // earliest or latest buffered time in place.
+  const base::TimeDelta previous_sync =
+      ParcPreviousSyncTime(media_time, streams);
+  base::TimeDelta front_removed_to = kNoTimestamp;
+  for (base::TimeDelta chunk = kInitialTimeChunk;
+       full && chunk >= kTimeChunkLowThreshold; chunk /= 2) {
+    const base::TimeDelta maximum_end =
+        std::min(media_time - chunk, previous_sync);
+    while (full) {
+      base::TimeDelta start = kInfiniteDuration;
+      for (ChunkDemuxerStream* stream : streams) {
+        const Ranges<base::TimeDelta> ranges =
+            stream->GetBufferedRanges(duration);
+        for (size_t i = 0; i < ranges.size(); ++i) {
+          if (ranges.end(i) > front_removed_to) {
+            start =
+                std::min(start, std::max(ranges.start(i), front_removed_to));
+            break;
+          }
+        }
+      }
+      const base::TimeDelta end = std::min(start + chunk, maximum_end);
+      if (start >= end) {
+        break;
+      }
+      for (ChunkDemuxerStream* stream : streams) {
+        stream->ParcFreeGOPsBefore(end);
+      }
+      front_removed_to = end;
+      full = is_full();
+    }
+  }
+
+  base::TimeDelta back_removed_from = kInfiniteDuration;
+  for (base::TimeDelta chunk = kInitialTimeChunk;
+       full && chunk >= kTimeChunkLowThreshold; chunk /= 2) {
+    while (full) {
+      const Ranges<base::TimeDelta> own = ParcOwnRanges(streams, duration);
+      base::TimeDelta end = media_time;
+      for (size_t i = 0; i < own.size() && own.start(i) < back_removed_from;
+           ++i) {
+        end = std::max(end, std::min(own.end(i), back_removed_from));
+      }
+      if (end <= media_time) {
+        break;
+      }
+      const base::TimeDelta playable_end =
+          ParcPlayableEnd(media_time, own, buffered, audio);
+      const base::TimeDelta start =
+          std::max(playable_end != kNoTimestamp ? playable_end
+                                                : media_time + chunk,
+                   end - chunk);
+      if (start >= end) {
+        break;
+      }
+      for (ChunkDemuxerStream* stream : streams) {
+        stream->ParcFreeGOPsFrom(start);
+      }
+      back_removed_from = start;
+      full = is_full();
+    }
+  }
+  return !full;
+}

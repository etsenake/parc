+void WebMediaPlayerImpl::ParcOnCdmEvent(media::CdmContext::Event event) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (event != media::CdmContext::Event::kHasAdditionalUsableKey &&
+      event != media::CdmContext::Event::kParcKeyStatusesChanged) {
+    return;
+  }
+  if (load_type_ == kLoadTypeMediaSource) {
+    ParcRecheckSourceKeys();
+    return;
+  }
+  // A stall that names no key (Chromium's decryptors and the FairPlay
+  // Renderer report none) ends with any newly usable key.
+  if (parc_waited_key_.empty()) {
+    ParcSetWaitingForKey(false);
+    return;
+  }
+  if (parc_waiting_for_key_ || parc_key_check_pending_) {
+    ParcCheckWaitedKey();
+  }

+std::vector<ChunkDemuxerStream*> SourceBufferState::ParcStreams() const {
+  std::vector<ChunkDemuxerStream*> streams;
+  for (const auto& it : audio_streams_) {
+    streams.push_back(it.second);
+  }
+  for (const auto& it : video_streams_) {
+    streams.push_back(it.second);

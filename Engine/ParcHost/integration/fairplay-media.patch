+      renderer_type_ == media::RendererType::kFairPlayHls) {
+    return;
+  }
+  const bool fairplay_cdm =
+      cdm_context_ref_ &&
+      cdm_context_ref_->GetCdmContext()->RequiresFairPlayRenderer();
+  if (renderer_type_ == media::RendererType::kFairPlay) {
+    // It takes FairPlay MediaKeys in place, however long it played without
+    // them or with others: new renderers join the key session and take over
+    // on the same clock (FairPlayRenderer::SetCdm), as Safari attaches keys
+    // to samples at any time.
+    if (fairplay_cdm) {
+      parc_->renderer_cdm_context_ = cdm_context_ref_->GetCdmContext();
+    }
+    return;
+  }
+  if ((!fairplay_cdm &&
+       !demuxer_manager_->ParcDemuxerPrefersFairPlayRenderer()) ||
+      !ParcFairPlayPlaysCurrentStreams()) {
+    return;
+  }
+  ParcHandOffOrRestart();

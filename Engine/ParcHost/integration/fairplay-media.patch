+  static constexpr char kWidevineKeySystemName[] = "com.widevine.alpha";
+  return key_system == kWidevineKeySystemName ||
+         media::IsSubKeySystemOf(key_system, kWidevineKeySystemName);
+}
+
+}  // namespace

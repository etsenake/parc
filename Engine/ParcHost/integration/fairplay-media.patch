+// WebKit's element takes its readyState from the AVFoundation player at every
+// change, up or down (MediaPlayerPrivateAVFoundation::updateStates):
+// HAVE_CURRENT_DATA at the first video frame or when the buffer empties,
+// HAVE_FUTURE_DATA once the item can play with media ahead, HAVE_ENOUGH_DATA
+// when it is likely to keep up or full. So does this element, from the
+// metadata on (a state that came first applies in OnMetadata). During a seek
+// it waits: Blink finishes a seek at any readyState change to
+// HAVE_CURRENT_DATA or more, while WebKit's seek finishes only with
+// AVPlayer's (OnPipelineSeeked applies it).
+void WebMediaPlayerImpl::ApplyParcNativeHlsReadyState() {
+  ReadyState target;
+  switch (parc_native_hls_ready_state_) {
+    case media::ParcNativeHlsReadyState::kHaveCurrentData:
+      target = WebMediaPlayer::kReadyStateHaveCurrentData;
+      break;
+    case media::ParcNativeHlsReadyState::kHaveFutureData:
+      target = WebMediaPlayer::kReadyStateHaveFutureData;
+      break;
+    case media::ParcNativeHlsReadyState::kHaveEnoughData:
+      target = WebMediaPlayer::kReadyStateHaveEnoughData;
+      break;
+    case media::ParcNativeHlsReadyState::kHaveMetadata:
+      // WebKit never lowers readyState to HAVE_METADATA once past it.
+      return;
+  }
+  if (seeking_ || ready_state_ < WebMediaPlayer::kReadyStateHaveMetadata ||
+      ready_state_ == target) {
+    return;
+  }
+  // Warning: This call may be re-entrant.
+  SetReadyState(target);
+  // A seek whose pipeline part is done finishes here when AVPlayer's
+  // readyState reaches HAVE_CURRENT_DATA; Blink checks for the end there too.
+  if (should_notify_time_changed_ && !seeking_ &&
+      ready_state_ >= WebMediaPlayer::kReadyStateHaveCurrentData) {
+    should_notify_time_changed_ = false;
+    client_->TimeChanged();
+  }
+  UpdatePlayState();
+}

+        widevine_observer.Run(&render_frame_host(), cdm_config.key_system);
+    if (!weak_this) {
+      // The observer ended this document; its pipes are already closed.
+      return;
+    }
+    if (hold) {
+      if (held_widevine_cdm_callbacks_.size() >= kMaxHeldWidevineCdmRequests) {
+        std::move(create_cdm_cb)

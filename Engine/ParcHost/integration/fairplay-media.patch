+
+void WebMediaPlayerImpl::ParcHandOffOrRestart() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // One on its way brings what this one would.
+  if (parc_->handing_off_) {
+    return;
+  }
+  // The resume makes the FairPlay Renderer.
+  if (pipeline_controller_->IsPipelineSuspended()) {
+    ScheduleRestart();
+    return;
+  }
+  // A seek on its way: the hand-off follows it (OnPipelineSeeked()), where a
+  // restart now would stop playback a second time. Other changes on their
+  // way end without that call, so the pipeline restarts after them.
+  if (!pipeline_controller_->IsStable()) {
+    if (seeking_) {
+      parc_->handoff_after_seek_ = true;
+    } else {
+      ScheduleRestart();
+    }
+    return;
+  }
+  parc_->handing_off_ = true;
+  pipeline_controller_->GetParcExtension()->ParcHandOffToFairPlay(
+      blink::BindOnce(&WebMediaPlayerImpl::ParcOnHandOff, weak_this_));
 }

+void ResourceLoader::ParcSetRunsWhileFrozen(bool runs_while_frozen) {
+  if (parc_runs_while_frozen_ == runs_while_frozen || !IsLoading()) {
+    return;
+  }
+  parc_runs_while_frozen_ = runs_while_frozen;
+
+  if (scheduler_client_id_ != ResourceLoadScheduler::kInvalidClientId &&
+      !scheduler_->IsRunning(scheduler_client_id_)) {
+    if (runs_while_frozen) {
+      const ResourceRequestHead& request = resource_->GetResourceRequest();
+      scheduler_->Release(
+          scheduler_client_id_,
+          ResourceLoadScheduler::ReleaseOption::kReleaseOnly,
+          ResourceLoadScheduler::TrafficReportHints::InvalidInstance());
+      scheduler_client_id_ = ResourceLoadScheduler::kInvalidClientId;
+      scheduler_->Request(
+          this,
+          ResourceLoadScheduler::ThrottleOption::kCanNotBeStoppedOrThrottled,
+          request.Priority(), request.IntraPriorityValue(),
+          &scheduler_client_id_);
+    }
+    return;
+  }
+
+  const LoaderFreezeMode frame_freeze_mode =
+      fetcher_->GetProperties().FreezeMode();
+  if (frame_freeze_mode != LoaderFreezeMode::kNone) {
+    SetDefersLoading(runs_while_frozen ? LoaderFreezeMode::kNone
+                                       : frame_freeze_mode);
   }

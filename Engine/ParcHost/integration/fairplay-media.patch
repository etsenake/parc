+void SourceBufferStream::ParcBridgeGap() {
+  if (!parc_state_->enabled() ||
+      GetType() != SourceBufferStreamType::kVideo || !track_buffer_.empty() ||
+      seek_pending_ ||
+      (selected_range_ ? selected_range_->HasNextBuffer()
+                       : parc_state_->highest_output_end() == kNoTimestamp)) {
+    return;
+  }
+  const base::TimeDelta gap_start =
+      selected_range_ ? selected_range_->GetBufferedEndTimestamp()
+                      : parc_state_->highest_output_end();
+  auto next = ranges_.begin();
+  if (selected_range_) {
+    while (next != ranges_.end() && next->get() != selected_range_) {
+      ++next;
+    }
+    CHECK(next != ranges_.end());
+    ++next;
+  } else {
+    while (next != ranges_.end() &&
+           (*next)->GetStartTimestamp() <= gap_start) {
+      ++next;
+    }
+  }
+  if (next == ranges_.end() || (*next)->GetStartTimestamp() - gap_start >
+                                   ParcGapToleranceAt(gap_start)) {
+    return;
+  }
+  (*next)->SeekToStart();
+  SetSelectedRange(next->get());
+}

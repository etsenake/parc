+// WebKit ends the seek with AVPlayer's (seekCompleted resolves it once
+// readyState is HAVE_CURRENT_DATA or more), which for video is once the frame
+// at the target is up. The pipeline posts its seek's end before the renderer
+// decodes anything, so the compositor's next frame is the target's; one
+// processed before the callback arrives leaves the seek to the renderer's
+// BUFFERING_HAVE_ENOUGH, as does a video with no first frame yet (its callback
+// is OnFirstFrame()'s).
+void WebMediaPlayerImpl::ParcFinishUrlSeekAtFrame() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!should_notify_time_changed_ ||
+      ready_state_ < WebMediaPlayer::kReadyStateHaveCurrentData) {
+    return;
+  }
+  if (!HasVideo()) {
+    should_notify_time_changed_ = false;
+    client_->TimeChanged();
+    return;
+  }
+  if (!has_first_frame_) {
+    return;
+  }
+  PostCrossThreadTask(
+      *vfc_task_runner_, FROM_HERE,
+      CrossThreadBindOnce(
+          &VideoFrameCompositor::SetOnNewProcessedFrameCallback,
+          CrossThreadUnretained(compositor_.get()),
+          CrossThreadBindOnce(base::BindPostTaskToCurrentDefault(
+              ConvertToBaseOnceCallback(CrossThreadBindOnce(
+                  &WebMediaPlayerImpl::ParcOnUrlSeekFrame, weak_this_,
+                  parc_->url_seek_id_))))));
+}

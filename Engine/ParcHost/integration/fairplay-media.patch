+bool SourceBufferState::ParcLeftOutOfMediaSource() const {
+  if (!parc_purged_while_inactive_ || ParcIsActive()) {
+    return false;
   }
+  for (const auto& it : audio_streams_) {
+    if (it.second->GetMemoryUsage()) {
+      return false;
+    }
+  }
+  for (const auto& it : video_streams_) {
+    if (it.second->GetMemoryUsage()) {
+      return false;
+    }
+  }
+  return true;
 }
 
+Ranges<base::TimeDelta> SourceBufferState::ParcAudioBufferedRanges(
+    base::TimeDelta duration) const {
+  Ranges<base::TimeDelta> ranges;
+  for (const auto& it : audio_streams_) {
+    const Ranges<base::TimeDelta> stream_ranges =
+        it.second->GetBufferedRanges(duration);
+    for (size_t i = 0; i < stream_ranges.size(); ++i) {
+      ranges.Add(stream_ranges.start(i), stream_ranges.end(i));
+    }
+  }
+  return ranges;
+}

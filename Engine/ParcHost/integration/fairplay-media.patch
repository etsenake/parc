+void RemotePlayback::ParcEndSessionOfGoneFrame() {
+  ParcMoveToElementContext();
+  if (parc_airplay_connection_) {
+    return;
+  }
+  StateChanged(mojom::blink::PresentationConnectionState::CLOSED);
+}

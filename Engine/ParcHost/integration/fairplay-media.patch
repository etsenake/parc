+  // The render process's handle, if any, is dropped: the GPU player holds the
+  // browser's, which carries the frame's audibility-bypass grant.
+  mojo::PendingRemote<media::mojom::FairPlayHlsPlayerLifetime>
+      browser_lifetime;

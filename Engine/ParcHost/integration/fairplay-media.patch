+
+bool WebMediaPlayerImpl::ParcFairPlayPlaysCurrentStreams() const {
+  if (pipeline_metadata_.has_video) {
+    const media::VideoDecoderConfig& video =
+        pipeline_metadata_.video_decoder_config;
+    switch (video.codec()) {
+      case media::VideoCodec::kH264:
+      case media::VideoCodec::kHEVC:
+      case media::VideoCodec::kAV1:
+        break;
+      case media::VideoCodec::kDolbyVision:
+        if (video.profile() != media::DOLBYVISION_PROFILE5 &&
+            video.profile() != media::DOLBYVISION_PROFILE8) {
+          return false;
+        }
+        break;
+      default:
+        return false;
+    }
+  }
+  if (pipeline_metadata_.has_audio) {
+    switch (pipeline_metadata_.audio_decoder_config.codec()) {
+      case media::AudioCodec::kAAC:
+      case media::AudioCodec::kAC3:
+      case media::AudioCodec::kEAC3:
+      case media::AudioCodec::kFLAC:
+      case media::AudioCodec::kOpus:
+      case media::AudioCodec::kALAC:
+        break;
+      default:
+        return false;
+    }
+  }
+  return true;
+}
+
+bool WebMediaPlayerImpl::ParcClearDolbyVisionAllowed() {
+  if (PresentsParcSafariIdentity()) {
+    return true;
+  }
+  media::CdmContextRef* ref = pending_cdm_context_ref_
+                                  ? pending_cdm_context_ref_.get()
+                                  : cdm_context_ref_.get();
+  return ref && ref->GetCdmContext()->RequiresFairPlayRenderer();
+}
+
+// WebKit adds a late SourceBuffer's tracks to the element and, with one
+// active, lowers readyState to HAVE_METADATA
+// (MediaSource::sourceBufferActiveTrackFlagChanged); its player plays them once
+// their data is buffered. A renderer made before them can't, so the pipeline
+// restarts into one made with every stream, which waits for their data at the
+// current time and keeps currentTime, paused and playbackRate; that
+// renderer's buffering raises readyState again.
+void WebMediaPlayerImpl::ParcOnSourceBufferStreamsAdded(
+    const media::PipelineMetadata& added) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // The pipeline read its metadata before they existed; its renderer is still
+  // to be made, with them (OnMetadata() adds them).
+  if (ready_state_ < WebMediaPlayer::kReadyStateHaveMetadata) {
+    if (!parc_streams_added_before_metadata_) {
+      parc_streams_added_before_metadata_.emplace();
+    }
+    ParcAddStreams(added, &*parc_streams_added_before_metadata_);
+    return;
+  }
+  const bool had_video = pipeline_metadata_.has_video;
+  ParcAddStreams(added, &pipeline_metadata_);
+  if (!had_video && pipeline_metadata_.has_video) {
+    ActivateSurfaceLayerForVideo();
+  }
+  if (observer_) {
+    observer_->OnMetadataChanged(pipeline_metadata_);
+  }
+  delegate_has_audio_ = HasUnmutedAudio();
+  DidMediaMetadataChange();
+  if (!parc_renderer_created_) {
+    UpdatePlayState();
+    return;
+  }
+  parc_awaits_added_streams_renderer_ = true;
+  // The renderer the restart makes has no samples or frame yet, as after a
+  // seek (ParcMonitorSourceBuffers).
+  parc_renderer_ready_ = false;
+  parc_renderer_has_enough_ = false;
+  delegate_->ClearStaleFlag(delegate_id_);
+  if (ready_state_ > WebMediaPlayer::kReadyStateHaveCurrentData) {
+    // Warning: This call may be re-entrant.
+    SetReadyState(WebMediaPlayer::kReadyStateHaveMetadata);
+  }
+  if (pipeline_controller_->IsPipelineSuspended()) {
+    UpdatePlayState();
+  } else {
+    ScheduleRestart();
+  }
+}
+
+// static
+void WebMediaPlayerImpl::ParcAddStreams(const media::PipelineMetadata& added,
+                                        media::PipelineMetadata* metadata) {
+  if (added.has_audio) {
+    metadata->has_audio = true;
+    metadata->audio_decoder_config = added.audio_decoder_config;
+  }
+  if (added.has_video) {
+    metadata->has_video = true;
+    metadata->video_decoder_config = added.video_decoder_config;
+  }
+}

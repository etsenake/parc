+void ChunkDemuxer::ParcMediaSourceRanges_Locked(
+    Ranges<base::TimeDelta>* buffered,
+    Ranges<base::TimeDelta>* audio) const {
+  lock_.AssertAcquired();
+  // What WebKit's MediaSourcePrivate consults: the media source's buffered
+  // ranges and the audio its active SourceBuffers hold, active meaning
+  // carrying an enabled track.
+  const bool ended = state_ == ENDED;
+  SourceBufferState::RangesList active_ranges;
+  for (const auto& entry : source_state_map_) {
+    const SourceBufferState* state = entry.second.get();
+    if (!state->ParcIsActive()) {
+      continue;
+    }
+    active_ranges.push_back(state->GetBufferedRanges(duration_, ended));
+    const Ranges<base::TimeDelta> state_audio =
+        state->ParcAudioBufferedRanges(duration_);
+    for (size_t i = 0; i < state_audio.size(); ++i) {
+      audio->Add(state_audio.start(i), state_audio.end(i));
+    }
+  }
+  *buffered =
+      SourceBufferState::ComputeRangesIntersection(active_ranges, ended);
+}

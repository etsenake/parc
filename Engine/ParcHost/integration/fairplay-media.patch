+base::RepeatingCallback<void(Args...)> DemuxerManager::ParcBindToClient(
+    void (C::*method)(Args...)) {
+  return base::BindPostTaskToCurrentDefault(base::BindRepeating(
+      [](base::WeakPtr<DemuxerManager> manager, void (C::*method)(Args...),
+         Args... args) {
+        if (manager && manager->client_) {
+          (manager->client_.get()->*method)(std::forward<Args>(args)...);
+        }
+      },
+      weak_factory_.GetWeakPtr(), method));
+}
+
+std::unique_ptr<Demuxer> DemuxerManager::MaybeCreateParcNativeHlsDemuxer() {
+  if (!client_->PresentsParcSafariIdentity()) {
+    return nullptr;
+  }
+  ParcNativeHlsDemuxerParams params;
+  params.url = loaded_url_;
+  if (parc_native_route_mime_type_) {
+    params.mime_type = *parc_native_route_mime_type_;
+  } else if (hls_fallback_) {
+    params.mime_type = "application/vnd.apple.mpegurl";
+  } else {
+    params.mime_type = ParcNativeHlsDataUrlMimeType();
+  }
+  params.media_task_runner = media_task_runner_;
+  params.media_log = media_log_.get();
+  params.encrypted_media_init_data_cb =
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &DemuxerManager::OnEncryptedMediaInitData,
+          weak_factory_.GetWeakPtr()));
+  params.inband_tracks = std::make_unique<ParcInbandTrackForwarder>(
+      ParcBindToClient(&ParcInbandTrackSink::ParcSetInbandTextTracks),
+      ParcBindToClient(&ParcInbandTrackSink::ParcAddInbandTextCues),
+      ParcBindToClient(&ParcInbandTrackSink::ParcAddInbandDataCues),
+      ParcBindToClient(&ParcInbandTrackSink::ParcSetInbandAudioTracks));
+  params.key_request_cb = ParcBindToClient(&Client::ParcWebKitKeyRequest);
+  params.ready_state_cb =
+      ParcBindToClient(&Client::ParcNativeHlsReadyStateChanged);
+  params.media_types_cb =
+      ParcBindToClient(&Client::ParcNativeHlsMediaTypesChanged);
+  params.time_jumped_cb = ParcBindToClient(&Client::ParcNativeHlsTimeJumped);
+  params.wireless_cb =
+      ParcBindToClient(&Client::ParcNativeHlsPlaybackTargetIsWirelessChanged);
+  return client_->CreateParcNativeHlsDemuxer(std::move(params));
+}

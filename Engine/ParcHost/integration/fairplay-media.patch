+
+void WebMediaPlayerImpl::ParcCheckSourceKey(const std::string& id) {
+  auto& key = parc_source_keys_.at(id);
+  const uint64_t check = key.check = ++parc_source_key_check_;
+  auto done = base::BindOnce(
+      [](base::WeakPtr<WebMediaPlayerImpl> player, std::string id,
+         uint64_t check, bool has_session) {
+        if (!player)
+          return;
+        auto it = player->parc_source_keys_.find(id);
+        if (it == player->parc_source_keys_.end() || it->second.check != check)
+          return;
+        auto& key = it->second;
+        const bool deliver_encrypted = std::exchange(key.deliver_encrypted, false);
+        if (deliver_encrypted || has_session)
+          key.waiting = !has_session;
+        if (!has_session && deliver_encrypted)
+          player->ParcDeliverEncryptedMediaInitData(
+              media::EmeInitDataType::SINF, key.init_data);
+        // WebKit's MediaSourcePrivateAVFObjC::waitingForKey aggregates every
+        // SourceBuffer, so another buffer's session cannot end this wait.
+        player->ParcSetWaitingForKey(std::ranges::any_of(
+            player->parc_source_keys_,
+            [](const auto& entry) { return entry.second.waiting; }));
+      }, weak_this_, id, check);
+  auto* ref = pending_cdm_context_ref_ ? pending_cdm_context_ref_.get()
+              : parc_cdm_detached_ ? nullptr : cdm_context_ref_.get();
+  if (!ref) {
+    std::move(done).Run(false);
+    return;
+  }
+  ref->GetCdmContext()->ParcHasSessionForInitData(
+      media::EmeInitDataType::SINF, key.init_data, std::move(done));
+}

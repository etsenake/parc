+bool MediaFactory::ParcAdoptMediaPlayer(
+    blink::WebMediaPlayer& player,
+    const blink::WebString& sink_id,
+    blink::MediaInspectorContext* inspector_context) {
+  EnsureDecoderFactory();
+  blink::ParcWebMediaPlayerExtension::ParcFrameServices services;
+  services.frame = render_frame_->GetWebFrame();
+  services.delegate = GetWebMediaPlayerDelegate();
+  services.url_index = GetMediaPlayerBuilder().url_index();
+  // As CreateMediaPlayer() makes it.
+  services.audio_sink = blink::AudioDeviceFactory::GetInstance()->NewMixableSink(
+      blink::WebAudioDeviceSourceType::kMediaElement,
+      render_frame_->GetWebFrame()->GetLocalFrameToken(),
+      render_frame_->GetWebView()->MainFrame()->GetFrameToken(),
+      media::AudioSinkParameters(/*session_id=*/base::UnguessableToken(),
+                                 sink_id.Utf8()));
+  // Unretained: the player runs it within ParcMoveToFrame().
+  services.move_factories = base::BindOnce(
+      &MediaFactory::ParcMoveRendererFactories, base::Unretained(this));
+  services.move_media_log = base::BindOnce(
+      [](scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+         blink::MediaInspectorContext* inspector_context,
+         media::MediaLog& media_log) {
+        static_cast<BatchingMediaLog&>(media_log).ParcMoveToFrame(
+            std::move(task_runner), inspector_context);
+      },
+      render_frame_->GetTaskRunner(blink::TaskType::kInternalInspector),
+      inspector_context);
+  blink::ParcWebMediaPlayerExtension* parc = player.GetParcExtension();
+  return parc && parc->ParcMoveToFrame(std::move(services));
+}
+
+// CreateRendererFactorySelector() made the factories with the other frame's
+// decoder, interface and remoter factories, which go with that frame.
+// Remoting goes through this frame's tab.
+void MediaFactory::ParcMoveRendererFactories(
+    media::RendererFactorySelector& selector) {
+  if (auto* factory = selector.GetFactory(media::RendererType::kRendererImpl)) {
+    static_cast<media::RendererImplFactory*>(factory)->ParcSetDecoderFactory(
+        decoder_factory_.get());
+  }
+#if BUILDFLAG(IS_MAC)
+  parc::fairplay::MoveRendererFactories(selector, render_frame_);
+#endif  // BUILDFLAG(IS_MAC)
+#if BUILDFLAG(ENABLE_MEDIA_REMOTING)
+  if (auto* factory = selector.GetFactory(media::RendererType::kCourier)) {
+    // As CreateRendererFactorySelector() connects it.
+    mojo::PendingRemote<media::mojom::RemotingSource> remoting_source;
+    auto remoting_source_receiver =
+        remoting_source.InitWithNewPipeAndPassReceiver();
+    mojo::PendingRemote<media::mojom::Remoter> remoter;
+    GetRemoterFactory()->Create(std::move(remoting_source),
+                                remoter.InitWithNewPipeAndPassReceiver());
+    static_cast<media::remoting::CourierRendererFactory*>(factory)
+        ->controller()
+        ->ParcMoveToRemoter(std::move(remoting_source_receiver),
+                            std::move(remoter));
+  }
+#endif  // BUILDFLAG(ENABLE_MEDIA_REMOTING)
+}

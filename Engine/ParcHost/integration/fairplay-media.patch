+// Parc: MediaSourcePrivate::nextStallTime over |own|: where playback from
+// |media_time| stalls, at the first gap MediaSourcePrivate::gapToleranceAtTime
+// doesn't bridge or the end of the last range; kNoTimestamp when |own|
+// doesn't hold |media_time|, as WebKit's [media_time, +inf) intersection
+// has it (a range ending there doesn't count).
+base::TimeDelta ParcPlayableEnd(base::TimeDelta media_time,
+                                const Ranges<base::TimeDelta>& own,
+                                const Ranges<base::TimeDelta>& buffered,
+                                const Ranges<base::TimeDelta>& audio) {
+  // MediaSourcePrivate::gapToleranceAtTime: 1 s before the media source's
+  // first range when that starts within the first second, 250 ms where audio
+  // covers the time, 125 ms otherwise.
+  const auto tolerance = [&](base::TimeDelta time) {
+    const base::TimeDelta kStartGapAllowance = base::Seconds(1);
+    if (time >= base::TimeDelta() && time < kStartGapAllowance &&
+        buffered.size() && buffered.start(0) <= kStartGapAllowance &&
+        time < buffered.start(0)) {
+      return kStartGapAllowance;
+    }
+    for (size_t i = 0; i < audio.size(); ++i) {
+      if (time >= audio.start(i) && time <= audio.end(i)) {
+        return base::Milliseconds(250);
+      }
+    }
+    return base::Milliseconds(125);
+  };
+
+  for (size_t i = 0; i < own.size(); ++i) {
+    if (media_time < own.start(i) || media_time >= own.end(i)) {
+      continue;
+    }
+    for (size_t j = i; j + 1 < own.size(); ++j) {
+      if (own.start(j + 1) - own.end(j) > tolerance(own.end(j))) {
+        return own.end(j);
+      }
+    }
+    return own.end(own.size() - 1);
+  }
+  return kNoTimestamp;
+}

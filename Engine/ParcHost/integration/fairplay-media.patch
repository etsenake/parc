+
+bool WebMediaPlayerImpl::ParcClearDolbyVisionAllowed() {
+  if (PresentsParcSafariIdentity()) {
+    return true;
+  }
+  media::CdmContextRef* ref = pending_cdm_context_ref_
+                                  ? pending_cdm_context_ref_.get()
+                                  : cdm_context_ref_.get();
+  return ref && ref->GetCdmContext()->RequiresFairPlayRenderer();
+}
+
+// WebKit adds a late SourceBuffer's tracks to the element and, with one
+// active, lowers readyState to HAVE_METADATA
+// (MediaSource::sourceBufferActiveTrackFlagChanged); its player adds a renderer
+// for each to the playing ones, every enabled audio track mixed
+// (AudioVideoRendererAVFObjC::addTrack), and waits for their data at the
+// current time. The pipeline's track change does that here: the FairPlay
+// Renderer and RendererImpl take the streams in place. Otherwise the pipeline
+// restarts into a renderer made with every stream. currentTime, paused and
+// playbackRate stay, and the renderer's buffering raises readyState again.
+void WebMediaPlayerImpl::ParcOnSourceBufferStreamsAdded(
+    const media::PipelineMetadata& added,
+    const std::vector<media::ChunkDemuxer::ParcAddedTrack>& tracks) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // The pipeline read its metadata before they existed; its renderer is still
+  // to be made, with them (OnMetadata() adds them).
+  if (ready_state_ < WebMediaPlayer::kReadyStateHaveMetadata) {
+    if (!parc_->streams_added_before_metadata_) {
+      parc_->streams_added_before_metadata_.emplace();
+    }
+    ParcAddStreams(added, &*parc_->streams_added_before_metadata_);
+    return;
+  }
+  const bool had_video = pipeline_metadata_.has_video;
+  ParcAddStreams(added, &pipeline_metadata_);
+  if (!had_video && pipeline_metadata_.has_video) {
+    ActivateSurfaceLayerForVideo();
+  }
+  if (observer_) {
+    observer_->OnMetadataChanged(pipeline_metadata_);
+  }
+  delegate_has_audio_ = HasUnmutedAudio();
+  DidMediaMetadataChange();
+  if (!parc_->renderer_created_) {
+    UpdatePlayState();
+    return;
+  }
+  // RendererImpl takes the CDM it has or waits for one; a stream that needs
+  // the FairPlay Renderer's CDM moves playback to that renderer.
+  media::CdmContextRef* cdm = pending_cdm_context_ref_
+                                  ? pending_cdm_context_ref_.get()
+                                  : cdm_context_ref_.get();
+  const bool fairplay_cdm =
+      cdm && cdm->GetCdmContext()->RequiresFairPlayRenderer();
+  const bool encrypted =
+      (added.has_audio && added.audio_decoder_config.is_encrypted()) ||
+      (added.has_video && added.video_decoder_config.is_encrypted());
+  const bool joins =
+      renderer_type_ == media::RendererType::kFairPlay ||
+      (renderer_type_ == media::RendererType::kRendererImpl &&
+       !(encrypted && fairplay_cdm));
+  parc_->awaits_added_streams_renderer_ = true;
+  // The renderer has no samples or frame of them yet, as after a seek
+  // (ParcMonitorSourceBuffers).
+  parc_->renderer_ready_ = false;
+  parc_->renderer_has_enough_ = false;
+  delegate_->ClearStaleFlag(delegate_id_);
+  if (ready_state_ > WebMediaPlayer::kReadyStateHaveCurrentData) {
+    // Warning: This call may be re-entrant.
+    SetReadyState(WebMediaPlayer::kReadyStateHaveMetadata);
+  }
+  if (joins) {
+    // Also while suspended: the renderer it resumes into is made with them.
+    // The demuxer starts every added stream of the type a change names.
+    std::optional<media::MediaTrack::Id> audio;
+    std::optional<media::MediaTrack::Id> video;
+    for (const media::ChunkDemuxer::ParcAddedTrack& track : tracks) {
+      auto& first = track.type == media::DemuxerStream::AUDIO ? audio : video;
+      if (!first) {
+        first = track.id;
+      }
+    }
+    if (audio) {
+      pipeline_controller_->OnEnabledAudioTracksChanged(audio);
+    }
+    if (video) {
+      pipeline_controller_->OnSelectedVideoTrackChanged(video);
+    }
+    UpdatePlayState();
+  } else if (pipeline_controller_->IsPipelineSuspended()) {
+    UpdatePlayState();
+  } else if (renderer_type_ == media::RendererType::kRendererImpl &&
+             ParcFairPlayPlaysCurrentStreams()) {
+    // The FairPlay Renderer takes over with the new stream too, which starts
+    // where it does.
+    ParcHandOffOrRestart();
+  } else {
+    ScheduleRestart();
+  }
+}

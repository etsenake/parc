+        *render_frame_->GetWebFrame()->Scheduler(), request_routing_token_cb_,
+        base::BindRepeating(&blink::WebLocalFrame::HasTransientUserActivation,
+                            base::Unretained(render_frame_->GetWebFrame())),
+        base::BindRepeating(&blink::WebLocalFrame::CreateAssociatedURLLoader,
+                            base::Unretained(render_frame_->GetWebFrame())));
+  }
+  return *media_player_builder_;
 }

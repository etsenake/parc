+
+void InterfaceFactoryImpl::CreateFairPlayHlsPlayer(
+    mojo::PendingReceiver<mojom::FairPlayHlsPlayer> player,
+    mojo::PendingRemote<mojom::FairPlayHlsPlayerClient> client,
+    mojo::PendingRemote<mojom::FairPlayHlsPlayerLifetime> lifetime) {
+  DVLOG(2) << __func__;
+  // Resolves SetCdm()'s ID among the CDMs this factory created. Unretained:
+  // the player is owned by |fairplay_hls_player_receivers_|, which this
+  // factory owns, so it never runs the getter after |cdm_service_context_|

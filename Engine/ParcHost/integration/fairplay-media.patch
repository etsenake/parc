+std::unique_ptr<Renderer> PipelineImpl::RendererWrapper::ParcReplaceRenderer(
+    std::unique_ptr<Renderer> renderer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(shared_state_.media_sequence_checker);
+  std::unique_ptr<Renderer> playing;
+  {
+    base::AutoLock auto_lock(shared_state_.lock());
+    playing = std::move(shared_state_.mutable_media().renderer);
+    shared_state_.mutable_media().renderer = std::move(renderer);
+  }
+  return playing;
+}

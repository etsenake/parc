+void ChunkDemuxer::ParcComputeEvictionData_Locked(SourceBufferState* state,
+                                                  base::TimeDelta media_time) {
+  lock_.AssertAcquired();
+  if (!parc_safari_eviction_) {
+    return;
+  }
+  Ranges<base::TimeDelta> buffered;
+  Ranges<base::TimeDelta> audio;
+  ParcMediaSourceRanges_Locked(&buffered, &audio);

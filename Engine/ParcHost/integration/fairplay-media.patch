+TEST_F(ChunkDemuxerTest, ParcSafariEviction_PastTheLastAppendedGOP) {
+  ASSERT_TRUE(InitDemuxer(HAS_AUDIO));
+  demuxer_->ParcSetSafariEviction(true);
+  block_size_ = 1000000;
+  ParcAppendFiveSecondAudioFrames(0, 4);
+  ParcAppendFiveSecondAudioFrames(50, 14);
+  CheckExpectedRanges("{ [0,20000) [50000,120000) }");
+  Seek(base::TimeDelta());
+
+  // Playback stalls at 20 s. 22 MB takes two 30 s chunks from the end of what
+  // follows, [90,120) and then [60,90), but for the last appended GOP, which
+  // stays as a range of its own.
+  EXPECT_TRUE(
+      demuxer_->EvictCodedFrames(kSourceId, base::TimeDelta(), 4000000));
+  CheckExpectedRanges("{ [0,20000) [50000,60000) [115000,120000) }");
+}
+
+TEST_F(ChunkDemuxerTest, ParcSafariEviction_KeepsThePlayableSegment) {
+  ASSERT_TRUE(InitDemuxer(HAS_AUDIO));
+  demuxer_->ParcSetSafariEviction(true);
+  block_size_ = 1000000;
+  ParcAppendFiveSecondAudioFrames(10, 13);
+  ParcAppendFiveSecondAudioFrames(0, 2);
+  Seek(base::TimeDelta());
+
+  // Everything after currentTime plays on without a stall, so WebKit evicts

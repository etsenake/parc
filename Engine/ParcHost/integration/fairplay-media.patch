+void WebAudioSourceProviderImpl::ParcOnSwitchSinkAuthorized(
+    scoped_refptr<media::SwitchableAudioRendererSink> sink,
+    media::OutputDeviceInfo device_info) {
+  base::AutoLock auto_lock(sink_lock_);
+  if (sink != parc_pending_sink_) {
+    return;
+  }
+  parc_pending_sink_ = nullptr;
+  if (client_ || !sink_ ||
+      device_info.device_status() != media::OUTPUT_DEVICE_STATUS_OK) {
+    return;
+  }
+  sink_->Stop();
+  sink_ = std::move(sink);
+  if (parc_requested_device_id_ &&
+      *parc_requested_device_id_ != device_info.device_id()) {
+    sink_->SwitchOutputDevice(*parc_requested_device_id_, base::DoNothing());
+  }
+  if (!params_.IsValid()) {
+    return;
+  }
+  sink_->Initialize(params_, tee_filter_.get());
+  sink_->SetVolume(volume_);
+  if (state_ != kStopped) {
+    sink_->Start();
+  }
+  if (state_ == kPlaying) {
+    sink_->Play();
+  }

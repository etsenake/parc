+
+// RemotePlayback::prompt()'s checks, in WebKit's order; a prompt while
+// another waits joins it.
+void RemotePlayback::ParcPromptAirPlay(ExceptionState& exception_state) {
+  if (ParcRemotePlaybackDisabled()) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidStateError,
+        "disableRemotePlayback attribute is present.");
+    return;
+  }
+  LocalDOMWindow* window = media_element_->DomWindow();
+  if (!window) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidAccessError,
+        "RemotePlayback::prompt() does not work in a detached window.");
+    return;
+  }
+  if (media_element_->getReadyState() < HTMLMediaElement::kHaveMetadata) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kNotSupportedError,
+                                      "The media element has no metadata.");
+    return;
+  }
+  if (!LocalFrame::HasTransientUserActivation(window->GetFrame())) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidAccessError,
+        "RemotePlayback::prompt() requires user gesture.");
+    return;
+  }
+  if (state_ == mojom::blink::PresentationConnectionState::CLOSED &&
+      !RemotePlaybackAvailable()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kNotSupportedError,
+                                      "No remote playback devices found.");
+  }
+}
+
+// A pick (or the route leaving) resolves the waiting prompts; a list closed
+// without a choice rejects them with NotAllowedError.
+void RemotePlayback::ParcSettlePrompts(bool resolve) {
+  HeapVector<Member<ScriptPromiseResolver<IDLUndefined>>> resolvers;
+  resolvers.swap(parc_prompt_resolvers_);
+  for (auto& resolver : resolvers) {
+    if (!IsInParallelAlgorithmRunnable(resolver->GetExecutionContext(),
+                                       resolver->GetScriptState())) {
+      continue;
+    }
+    ScriptState::Scope script_state_scope(resolver->GetScriptState());
+    if (resolve) {
+      resolver->Resolve();
+    } else {
+      resolver->Reject(V8ThrowDOMException::CreateOrDie(
+          resolver->GetScriptState()->GetIsolate(),
+          DOMExceptionCode::kNotAllowedError, "The prompt was dismissed."));
+    }
+  }
+}
+
+// setState: the event in a media element task.
+void RemotePlayback::ParcSetAirPlayState(
+    mojom::blink::PresentationConnectionState state) {
+  if (state_ == state) {
+    return;
+  }
+  state_ = state;
+  parc_airplay_connection_ =
+      state != mojom::blink::PresentationConnectionState::CLOSED;
+  const AtomicString& type =
+      state == mojom::blink::PresentationConnectionState::CONNECTING
+          ? event_type_names::kConnecting
+      : state == mojom::blink::PresentationConnectionState::CONNECTED
+          ? event_type_names::kConnect
+          : event_type_names::kDisconnect;
+  EnqueueEvent(*Event::Create(type), TaskType::kMediaElementEvent);
+  for (auto observer : observers_) {
+    observer->OnRemotePlaybackStateChanged(state_);
+  }
+  ParcMaybeMoveToElementContext();
+}
+
+ParcRemotePlaybackExtension& RemotePlayback::GetParcExtension() {
+  return *this;
+}
+
+// availabilityChanged.
+void RemotePlayback::ParcAirPlayAvailabilityChanged() {
+  // A new player that can't play to a target ends the wait for its list.
+  if (!ParcUsesAirPlay()) {
+    ParcSettlePrompts(/*resolve=*/false);
+  }
+  const bool available = RemotePlaybackAvailable();
+  if (available == parc_reported_availability_) {
+    return;
+  }
+  parc_reported_availability_ = available;
+  HeapVector<Member<AvailabilityCallbackWrapper>> callbacks(
+      availability_callbacks_.Values());
+  for (auto& callback : callbacks) {
+    callback->Run(this, available);
+  }
+}
+
+// shouldPlayToRemoteTargetChanged: a pick settles the prompt and connects;
+// leaving the route disconnects.
+void RemotePlayback::ParcShouldPlayToRemoteTargetChanged(bool should_play) {
+  if (!ParcUsesAirPlay() && !parc_airplay_connection_) {
+    return;
+  }
+  ParcSettlePrompts(/*resolve=*/true);
+  if (should_play) {
+    if (state_ == mojom::blink::PresentationConnectionState::CLOSED) {
+      ParcSetAirPlayState(
+          mojom::blink::PresentationConnectionState::CONNECTING);
+    }
+  } else if (parc_airplay_connection_) {
+    ParcSetAirPlayState(mojom::blink::PresentationConnectionState::CLOSED);
+  }
+}
+
+// isPlayingToRemoteTargetChanged.
+void RemotePlayback::ParcPlayingToRemoteTargetChanged(bool playing) {
+  if (!ParcUsesAirPlay() && !parc_airplay_connection_) {
+    return;
+  }
+  ParcSetAirPlayState(
+      playing ? mojom::blink::PresentationConnectionState::CONNECTED
+              : mojom::blink::PresentationConnectionState::CLOSED);
+}
+
+// playbackTargetPickerWasDismissed: NotAllowedError.
+void RemotePlayback::ParcPlaybackTargetPickerDismissed() {
+  ParcSettlePrompts(/*resolve=*/false);
+}

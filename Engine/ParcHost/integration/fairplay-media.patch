+// Parc: WebKit's SourceBufferPrivate::memoryPressure, which a
+// ManagedMediaSource's SourceBuffers run under memory pressure. An inactive
+// SourceBuffer is emptied. An active one keeps what WebKit's
+// evictFrames(maximumBufferSize, media_time) leaves: data before the earlier of
+// the keyframe at or before |media_time| and 3.75 s before it goes, the removal
+// ending at a keyframe so the GOP being played stays, and so does data after
+// the playable run holding |media_time| (ranges joined by gaps of up to
+// 125 ms), or after 3.75 s past it when it isn't buffered. An ended stream
+// keeps what follows the run: Chromium would end playback where it stops,
+// where WebKit waits for more data.
+void SourceBufferStream::ParcPurgeForMemoryPressure(base::TimeDelta media_time,
+                                                    bool active,
+                                                    base::TimeDelta duration) {
+  const base::TimeDelta kWindow = base::Milliseconds(3750);
+  const base::TimeDelta kGapTolerance = base::Milliseconds(125);
+
+  // Calls Remove() only when it has something to remove: it extends |end| to
+  // the next keyframe, or stops at |duration| when none follows.
+  const auto remove = [&](base::TimeDelta start, base::TimeDelta end) {
+    start = std::max(start, base::TimeDelta());
+    base::TimeDelta remove_end = FindKeyframeAfterTimestamp(end);
+    if (remove_end == kNoTimestamp) {
+      remove_end = std::min(end, duration);
+    }
+    if (start < end && start < remove_end) {
+      Remove(start, end, duration);
+    }
+  };
+
+  if (ranges_.empty()) {
+    return;
+  }
+  if (!active) {
+    remove(ranges_.front()->GetStartTimestamp(), kInfiniteDuration);
+    return;
+  }
+
+  // The keyframe at or before |media_time|, in the range holding it or the
+  // last one before it.
+  base::TimeDelta keyframe = kNoTimestamp;
+  for (auto itr = ranges_.rbegin(); itr != ranges_.rend(); ++itr) {
+    SourceBufferRange* range = itr->get();
+    if (range->GetStartTimestamp() > media_time) {
+      continue;
+    }
+    keyframe = range->KeyframeBeforeTimestamp(
+        std::min(media_time, range->GetEndTimestamp()));
+    break;
+  }
+  base::TimeDelta front_end = media_time - kWindow;
+  if (keyframe != kNoTimestamp) {
+    front_end = std::min(front_end, keyframe);
+  }
+  remove(ranges_.front()->GetStartTimestamp(), front_end);
+
+  if (end_of_stream_ || ranges_.empty()) {
+    return;
+  }
+  base::TimeDelta back_start = media_time + kWindow;
+  for (auto itr = ranges_.begin(); itr != ranges_.end(); ++itr) {
+    if ((*itr)->GetStartTimestamp() > media_time ||
+        media_time > (*itr)->GetBufferedEndTimestamp()) {
+      continue;
+    }
+    base::TimeDelta run_end = (*itr)->GetBufferedEndTimestamp();
+    for (auto next = std::next(itr);
+         next != ranges_.end() &&
+         (*next)->GetStartTimestamp() - run_end <= kGapTolerance;
+         ++next) {
+      run_end = std::max(run_end, (*next)->GetBufferedEndTimestamp());
+    }
+    back_start = run_end;
+    break;
+  }
+  remove(back_start, kInfiniteDuration);
+}

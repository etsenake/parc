+// static
+size_t SourceBufferState::ParcMaximumBufferSize(bool has_video) {
+  // WebKit's SettingsBase::defaultMaximumSourceBufferSize, split in float
+  // arithmetic as SourceBuffer::maximumBufferSize splits it.
+  constexpr size_t kMaximumSourceBufferSize = 318767104;
+  size_t maximum = static_cast<size_t>(kMaximumSourceBufferSize * .05f);
+  if (has_video) {
+    maximum += static_cast<size_t>(kMaximumSourceBufferSize * .95f);
+  }
+  return maximum;
+}

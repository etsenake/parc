+std::string DemuxerManager::ParcNativeHlsDataUrlMimeType() const {
+#if BUILDFLAG(ENABLE_HLS_DEMUXER)
+  std::string mime_type;
+  std::string charset;
+  if (!loaded_url_.SchemeIs(url::kDataScheme) || !client_ ||
+      !client_->PresentsParcSafariIdentity() ||
+      !net::DataURL::Parse(loaded_url_, &mime_type, &charset,
+                           /*data=*/nullptr)) {
+    return std::string();
+  }
+  std::string_view type = base::TrimWhitespaceASCII(
+      std::string_view(mime_type).substr(0, mime_type.find(';')),
+      base::TRIM_ALL);
+  for (std::string_view hls :
+       {"application/vnd.apple.mpegurl", "application/x-mpegurl",
+        "audio/mpegurl", "audio/x-mpegurl"}) {
+    if (type == hls) {
+      return std::string(type);
+    }
+  }
+#endif
+  return std::string();
+}
+
+void DemuxerManager::ParcSetNativeRoute(std::optional<std::string> mime_type,
+                                        base::OnceClosure done) {
+  parc_native_route_mime_type_ = std::move(mime_type);
+  if (data_source_) {
+    data_source_->Stop();
+  }
+  if (!parc_native_hls_demuxer_) {
+    FreeResourcesAfterMediaThreadWait(std::move(done));
+    return;
+  }
+  parc_native_hls_demuxer_ = false;
+  data_source_info_ = nullptr;
+  media_task_runner_->DeleteSoon(FROM_HERE, std::move(demuxer_));
+  media_task_runner_->PostTask(
+      FROM_HERE, base::BindPostTaskToCurrentDefault(std::move(done)));
+}

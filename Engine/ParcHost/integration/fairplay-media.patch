+// Parc: the observer installed by parc::fairplay::SetWidevineCdmRequestObserver
+// (content/browser/media/parc_fairplay_hooks.h). Set before the browser
+// threads start or on the UI thread, and read on the UI thread.
+parc::fairplay::WidevineCdmRequestObserver& WidevineCdmRequestObserverSlot() {
+  static base::NoDestructor<parc::fairplay::WidevineCdmRequestObserver>
+      observer;
+  return *observer;

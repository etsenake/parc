+void MediaInterfaceProxy::CreateFairPlayHlsPlayer(
+    mojo::PendingReceiver<media::mojom::FairPlayHlsPlayer> player,
+    mojo::PendingRemote<media::mojom::FairPlayHlsPlayerClient> client,
+    mojo::PendingRemote<media::mojom::FairPlayHlsPlayerLifetime> lifetime) {
+  CHECK(thread_checker_.CalledOnValidThread(), base::NotFatalUntil::M160);
+
+  // The player lives in the same media service as the frame's FairPlay CDMs
+  // (see CreateCdm), so its SetCdm() finds them.
+  InterfaceFactory* factory = media_interface_factory_ptr_->Get();
+  if (!factory) {
+    return;
+  }

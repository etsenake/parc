+
+void ChunkDemuxerStream::ParcPullToSplit_Locked() {
+  ParcHandOff& handoff = *parc_handoff_;
+  if (state_ == SHUTDOWN || handoff.split) {
+    return;
+  }
+  auto starts_after = [&](const StreamParserBuffer& buffer) {
+    return buffer.end_of_stream() ||
+           (buffer.timestamp() >= *handoff.target &&
+            (type_ != VIDEO || buffer.is_key_frame()));
+  };
+  bool pulled = false;
+  while (true) {
+    if (handoff.first) {
+      if (starts_after(*handoff.first)) {
+        break;
+      }
+      const StreamParserBuffer& taken = *handoff.first;
+      if (handoff.before_end == kNoTimestamp ||
+          taken.timestamp() + taken.duration() > handoff.before_end) {
+        handoff.before_end = taken.timestamp() + taken.duration();
+      }
+      handoff.before.push_back(std::move(handoff.first));
+      pulled = true;
+    }
+    // What an earlier hand-off gave back comes before |stream_|.
+    if (!parc_returned_.empty()) {
+      handoff.first = std::move(parc_returned_.front());
+      parc_returned_.pop_front();
+      continue;
+    }
+    if (stream_->IsNextBufferConfigChanged()) {
+      handoff.config_split = true;
+      break;
+    }
+    scoped_refptr<StreamParserBuffer> buffer;
+    switch (stream_->GetNextBuffer(&buffer)) {
+      case SourceBufferStreamStatus::kSuccess:
+        handoff.first = std::move(buffer);
+        break;
+      case SourceBufferStreamStatus::kNeedBuffer:
+        return;
+      case SourceBufferStreamStatus::kEndOfStream:
+        handoff.first = StreamParserBuffer::CreateEOSBuffer();
+        break;
+      case SourceBufferStreamStatus::kConfigChange:
+        NOTREACHED();  // IsNextBufferConfigChanged() said no.
+    }
+  }
+  handoff.split = true;
+  handoff.reader_there = !pulled && handoff.before.empty();
+  if (handoff.first && !handoff.first->end_of_stream()) {
+    handoff.split_time = handoff.first->timestamp();
+  } else if (handoff.before_end != kNoTimestamp) {
+    handoff.split_time = handoff.before_end;
+  } else {
+    handoff.split_time = *handoff.target;
+  }
+}
+
+void ChunkDemuxerStream::ParcHandOffRead(uint32_t count, ReadCB read_cb) {
+  base::AutoLock auto_lock(lock_);
+  DCHECK(parc_handoff_);
+  DCHECK(!parc_handoff_->read_cb);
+  parc_handoff_->read_cb =
+      base::BindPostTaskToCurrentDefault(std::move(read_cb));
+  parc_handoff_->count = count;
+  ParcCompleteHandOffRead_Locked();
+}
+
+void ChunkDemuxerStream::ParcCompleteHandOffRead_Locked() {
+  ParcHandOff& handoff = *parc_handoff_;
+  DCHECK(handoff.read_cb);
+  if (!is_enabled_ || state_ == SHUTDOWN) {
+    std::move(handoff.read_cb)
+        .Run(kOk, {StreamParserBuffer::CreateEOSBuffer()});
+    return;
+  }
+  if (state_ == RETURNING_ABORT_FOR_READS) {
+    std::move(handoff.read_cb).Run(kAborted, {});
+    return;
+  }
+  if (state_ != RETURNING_DATA_FOR_READS || !handoff.split) {
+    return;
+  }
+  if (handoff.first) {
+    std::move(handoff.read_cb).Run(kOk, {std::move(handoff.first)});
+    return;
+  }
+  if (!parc_returned_.empty()) {
+    std::move(handoff.read_cb).Run(kOk, {std::move(parc_returned_.front())});
+    parc_returned_.pop_front();
+    return;
+  }
+  auto [status, buffers] = GetPendingBuffers_Locked(handoff.count);
+  if (status == SourceBufferStreamStatus::kNeedBuffer && buffers.empty()) {
+    return;
+  }
+  if (status == SourceBufferStreamStatus::kConfigChange) {
+    std::move(handoff.read_cb).Run(kConfigChanged, {});
+    return;
+  }
+  std::move(handoff.read_cb).Run(kOk, std::move(buffers));
+}
+
+void ChunkDemuxerStream::ParcEndHandOff() {
+  base::AutoLock auto_lock(lock_);
+  if (parc_stream_hand_off_) {
+    parc_stream_hand_off_->End();
+  }
+  parc_stream_hand_off_.reset();
+}

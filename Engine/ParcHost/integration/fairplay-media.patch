+void WebMediaPlayerImpl::ParcWaitForStalledKey() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // WebKit's native HLS player waits for the key its last request made with
+  // no CDM attached named (MediaPlayerPrivateAVFoundationObjC's m_keyID).
+  if (!ParcPlaysNativeHls()) {
+    // WebKit's src= player never enters waiting-for-key with a CDM attached
+    // (MediaPlayerPrivateAVFoundationObjC::shouldWaitForLoadingOfResource).
+    if (cdm_context_ref_ && !parc_cdm_detached_) {
+      ParcSetWaitingForKey(false);
+      return;
+    }
+    parc_waited_key_.clear();
+  } else if (!parc_last_skd_init_data_.empty()) {
+    parc_waited_key_ = parc_last_skd_init_data_;
+  }
+  if (parc_waited_key_.empty() || !cdm_context_ref_ || parc_cdm_detached_) {
+    ParcSetWaitingForKey(true);
+    return;
+  }
+  // A CDM attached while the stall was on its way: wait only if no session
+  // has a request for the key, so a key that arrived first doesn't leave the
+  // element waiting while the player plays on.
+  ParcCheckWaitedKey();
+}
+
+void WebMediaPlayerImpl::ParcCheckWaitedKey() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (parc_waited_key_.empty() || !cdm_context_ref_ || parc_cdm_detached_) {
+    return;
+  }
+  // Only the latest check decides: it asked the current CDM after every
+  // earlier one.
+  const uint64_t check = ++parc_key_check_;
+  parc_key_check_pending_ = true;
+  cdm_context_ref_->GetCdmContext()->ParcHasSessionForInitData(
+      media::EmeInitDataType::SKD, parc_waited_key_,
+      base::BindOnce(
+          [](base::WeakPtr<WebMediaPlayerImpl> player, uint64_t check,
+             std::vector<uint8_t> key, bool has_session) {
+            if (!player || check != player->parc_key_check_ ||
+                key != player->parc_waited_key_) {

+; (com.apple.WebKit.GPUProcess.sb) and Chromium's audio service profile
+; (audio.sb). IPC shared memory for CoreAudio ("AudioIO") and preference reads
+; are already allowed above.
+(allow mach-lookup
+  ; FairPlay Streaming's key daemon, for SPCs and CKCs. AVContentKeySession
+  ; uses either name and falls back to the other; without both no request is
+  ; generated (WebKit GPUProcess.sb; also in the App Sandbox).
+  (global-name "com.apple.lskdd")
+  (global-name "com.apple.lskdd.xpc")
+  ; CoreAudio's HAL: without it AVSampleBufferAudioRenderer fails to render
+  ; (audio.sb).
+  (global-name "com.apple.audio.audiohald")
+  ; Without it AVSampleBufferAudioRenderer is invalid and the render
+  ; synchronizer rejects it (audio.sb).
+  (global-name "com.apple.coremedia.routingcontext.xpc")
+  ; Looked up while audio plays; built-in output plays without them, other
+  ; routes are unverified (audio.sb).
+  (global-name "com.apple.audio.AudioSession")
+  (xpc-service-name "com.apple.audio.SandboxHelper")

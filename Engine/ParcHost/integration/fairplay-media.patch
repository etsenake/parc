+                                          seek_demuxer);
+  base::RunLoop().RunUntilIdle();
+  std::move(seek_done).Run();
+  WaitForPendingDecode();
+  std::string frames;
+  for (int ms = 0; ms <= 690; ms += 10) {
+    frames += base::NumberToString(ms) + " ";
+  }
+  QueueFrames(frames);
+  SatisfyPendingDecode();
+  base::RunLoop().RunUntilIdle();

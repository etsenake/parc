+// Parc: Remove() extends |end| to the next keyframe, or stops at |duration|
+// when none follows; it is only called when that leaves something to remove.
+void SourceBufferStream::ParcRemove(base::TimeDelta start,
+                                    base::TimeDelta end,
+                                    base::TimeDelta duration) {
+  start = std::max(start, base::TimeDelta());
+  base::TimeDelta remove_end = FindKeyframeAfterTimestamp(end);
+  if (remove_end == kNoTimestamp) {
+    remove_end = std::min(end, duration);
+  }
+  if (start < end && start < remove_end) {
+    Remove(start, end, duration);
+  }
+}
+
+// Parc: WebKit's TrackBuffer sync-sample lookup: the keyframe at or before
+// |time| in the range holding it, or the last keyframe of the last range
+// before it.
+base::TimeDelta SourceBufferStream::ParcKeyframeAtOrBefore(
+    base::TimeDelta time) const {
+  for (auto itr = ranges_.rbegin(); itr != ranges_.rend(); ++itr) {
+    const SourceBufferRange* range = itr->get();
+    if (range->GetStartTimestamp() > time) {
+      continue;
+    }
+    return range->KeyframeBeforeTimestamp(
+        std::min(time, range->GetEndTimestamp()));
+  }
+  return kNoTimestamp;
+}
+
+void SourceBufferStream::ParcRemoveBefore(base::TimeDelta end,
+                                          base::TimeDelta duration) {
+  if (!ranges_.empty()) {
+    ParcRemove(ranges_.front()->GetStartTimestamp(), end, duration);
+  }
+}
+
+void SourceBufferStream::ParcRemoveFrom(base::TimeDelta start,
+                                        base::TimeDelta duration) {
+  if (ranges_.empty()) {
+    return;
+  }
+  const base::TimeDelta buffered_end = ranges_.back()->GetBufferedEndTimestamp();
+  ParcRemove(start, kInfiniteDuration, duration);
+  const base::TimeDelta end = ranges_.empty()
+                                  ? base::TimeDelta()
+                                  : ranges_.back()->GetBufferedEndTimestamp();
+  // An ended stream reports end of stream once playback reaches its last
+  // range; WebKit's waits for data where the purge stopped, until the page
+  // appends again (which reopens the source and unmarks the end of stream).
+  if (end_of_stream_ && end < buffered_end) {
+    end_of_stream_ = false;
+    parc_end_of_stream_suspended_ = true;
+  }
+}

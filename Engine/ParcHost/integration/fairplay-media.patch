+void WebMediaPlayerImpl::ParcNativeHlsReadyStateChanged(
+    media::ParcNativeHlsReadyState state) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  parc_native_hls_ready_state_ = state;

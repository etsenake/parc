+const ParcIntervals& SourceBufferStream::ParcFrames() const {
+  if (!parc_frames_) {
+    ParcIntervals intervals;
+    for (const auto& range : ranges_) {
+      range->ParcAppendPresentationIntervals(&intervals);
+    }
+    std::sort(intervals.begin(), intervals.end());
+    parc_frames_ = ParcCoalesce(intervals, base::Microseconds(1));
+  }
+  return *parc_frames_;
+}
+
+// Parc: TrackBuffer::removeSamples() erases a filled gap with the frame on
+// either side of it.
+ParcIntervals SourceBufferStream::ParcKeptFilledGaps() const {
+  const ParcIntervals& frames = ParcFrames();
+  ParcIntervals kept;
+  for (const ParcInterval& gap : ParcCoalesce(parc_filled_gaps_, {})) {
+    if (ParcHolds(frames, gap.first - base::Microseconds(1)) &&
+        ParcHolds(frames, gap.second)) {
+      kept.push_back(gap);
+    }
+  }
+  return kept;
+}
+
+// Parc: WebKit's TrackBuffer buffered ranges: every frame's presentation
+// interval and the gaps filled as frames were appended.
+Ranges<base::TimeDelta> SourceBufferStream::ParcBufferedTime() const {
+  const ParcIntervals& frames = ParcFrames();
+  const ParcIntervals kept = ParcKeptFilledGaps();
+  ParcIntervals intervals;
+  intervals.reserve(frames.size() + kept.size());
+  std::merge(frames.begin(), frames.end(), kept.begin(), kept.end(),
+             std::back_inserter(intervals));
+  Ranges<base::TimeDelta> buffered;
+  for (const ParcInterval& interval : ParcCoalesce(intervals, {})) {
+    buffered.Add(interval.first, interval.second);
+  }
+  return buffered;
+}
+
+// Parc: WebKit's TrackBuffer::addSample() adds each frame's presentation
+// interval with PlatformTimeRanges::add(EliminateSmallGaps), which moves its
+// start back, and its end forward, to the nearest range boundary that lies
+// strictly within timeFudgeFactor(). A hole of 1 microsecond is rounding
+// (ParcFrames()), not a gap to record.
+void SourceBufferStream::ParcFillSmallGaps(Ranges<base::TimeDelta>* buffered,
+                                           const BufferQueue& buffers) {
+  if (!parc_safari_media_source_) {
+    return;
+  }
+  const base::TimeDelta kRounding = base::Microseconds(1);
+  // Gaps this append fills, merged in once so that appending into the middle
+  // of the buffer doesn't shift every recorded gap for each frame.
+  ParcIntervals added;
+  for (const auto& buffer : buffers) {
+    const base::TimeDelta frame_start = buffer->timestamp();
+    const base::TimeDelta frame_end =
+        frame_start + std::max(buffer->duration(), kRounding);
+    base::TimeDelta start = frame_start;
+    base::TimeDelta end = frame_end;
+    const base::TimeDelta nearest_start = ParcNearest(*buffered, start);
+    const base::TimeDelta nearest_end = ParcNearest(*buffered, end);
+    if (nearest_start != kNoTimestamp &&
+        ParcWithinTimeFudgeFactor(start - nearest_start)) {
+      if (start - nearest_start > kRounding) {
+        ParcInsert(&added, nearest_start, start);
+      }
+      start = nearest_start;
+    }
+    if (nearest_end != kNoTimestamp &&
+        ParcWithinTimeFudgeFactor(nearest_end - end)) {
+      if (nearest_end - end > kRounding) {
+        ParcInsert(&added, end, nearest_end);
+      }
+      end = nearest_end;
+    }
+    ParcCut(&parc_filled_gaps_, frame_start, frame_end);
+    ParcCut(&added, frame_start, frame_end);
+    buffered->Add(start, end);
+  }
+  ParcIntervals gaps;
+  gaps.reserve(parc_filled_gaps_.size() + added.size());
+  std::merge(parc_filled_gaps_.begin(), parc_filled_gaps_.end(), added.begin(),
+             added.end(), std::back_inserter(gaps));
+  parc_filled_gaps_ = std::move(gaps);
+  parc_frames_.reset();
+}
+
+// Parc: 1 s before the media source's first range when that starts within
+// the first second, 250 ms where its audio covers |time|, 125 ms otherwise.
+base::TimeDelta SourceBufferStream::ParcGapToleranceAt(
+    base::TimeDelta time) const {
+  const base::TimeDelta kStartGapAllowance = base::Seconds(1);
+  if (time >= base::TimeDelta() && time < kStartGapAllowance &&
+      parc_media_source_start_ != kNoTimestamp &&
+      parc_media_source_start_ <= kStartGapAllowance &&
+      time < parc_media_source_start_) {
+    return kStartGapAllowance;
+  }
+  for (size_t i = 0; i < parc_audio_buffered_.size(); ++i) {
+    if (time >= parc_audio_buffered_.start(i) &&
+        time <= parc_audio_buffered_.end(i)) {
+      return base::Milliseconds(250);
+    }
+  }
+  return base::Milliseconds(125);
+}
+
+// Parc: WebKit's TrackBuffer::nextSample() enqueues across a gap no wider
+// than the tolerance at its start. Video only: Chromium's audio renderer
+// plays buffers back to back, so skipping an audio gap would shift audio
+// against video.
+void SourceBufferStream::ParcBridgeGap() {
+  if (!parc_safari_media_source_ ||
+      GetType() != SourceBufferStreamType::kVideo || !track_buffer_.empty() ||
+      seek_pending_ ||
+      (selected_range_ ? selected_range_->HasNextBuffer()
+                       : parc_highest_output_end_ == kNoTimestamp)) {
+    return;
+  }
+  // From the end of the selected range, or, with none selected (the track
+  // buffer ran out where nothing follows within Chromium's fudge room), from
+  // the end of the last buffer output, as WebKit measures from the end of the
+  // last sample it enqueued.
+  const base::TimeDelta gap_start =
+      selected_range_ ? selected_range_->GetBufferedEndTimestamp()
+                      : parc_highest_output_end_;
+  auto next = ranges_.begin();
+  if (selected_range_) {
+    while (next != ranges_.end() && next->get() != selected_range_) {
+      ++next;
+    }
+    CHECK(next != ranges_.end());
+    ++next;
+  } else {
+    while (next != ranges_.end() &&
+           (*next)->GetStartTimestamp() <= gap_start) {
+      ++next;
+    }
+  }
+  if (next == ranges_.end() || (*next)->GetStartTimestamp() - gap_start >
+                                   ParcGapToleranceAt(gap_start)) {
+    return;
+  }
+  (*next)->SeekToStart();
+  SetSelectedRange(next->get());
+}

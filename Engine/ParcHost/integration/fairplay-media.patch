+// restarts into one made with every stream, which waits for their data at the
+// current time and keeps currentTime, paused and playbackRate; that
+// renderer's buffering raises readyState again.
+void WebMediaPlayerImpl::ParcOnSourceBufferStreamsAdded(
+    const media::PipelineMetadata& added) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // The pipeline read its metadata before they existed; its renderer is still
+  // to be made, with them (OnMetadata() adds them).

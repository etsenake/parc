+
+// Parc: FreeBuffers() bounded by |limit| instead of a byte count. Unlike
+// FreeBuffers() from the back, it goes on past the last appended GOP, which
+// it keeps as a range of its own, as FreeBuffers() does from the front:
+// WebKit removes everything after the playable segment, a GOP appended there
+// with it.
+size_t SourceBufferStream::ParcFreeGOPs(base::TimeDelta limit,
+                                        bool reverse_direction) {
+  parc_frames_.reset();
+  size_t bytes_freed = 0;
+  std::unique_ptr<SourceBufferRange> new_range_for_append;
+
+  while (!ranges_.empty()) {
+    auto range_itr =
+        reverse_direction ? std::prev(ranges_.end()) : ranges_.begin();
+    SourceBufferRange* current_range = range_itr->get();
+    BufferQueue buffers;
+    size_t bytes_deleted = 0;
+
+    if (reverse_direction) {
+      if (current_range->LastGOPContainsNextBufferPosition() ||
+          current_range->KeyframeBeforeTimestamp(
+              current_range->GetEndTimestamp()) < limit) {
+        break;
+      }
+      bytes_deleted = current_range->DeleteGOPFromBack(&buffers);
+    } else {
+      if (current_range->FirstGOPContainsNextBufferPosition() ||
+          current_range->GetStartTimestamp() >= limit) {
+        break;
+      }
+      bytes_deleted = current_range->DeleteGOPFromFront(&buffers);
+    }
+
+    if (buffers.back()->timestamp() == last_appended_buffer_timestamp_) {
+      DCHECK(last_appended_buffer_timestamp_ != kNoTimestamp);
+      DCHECK(!new_range_for_append);
+      new_range_for_append = std::make_unique<SourceBufferRange>(
+          SourceBufferRange::NO_GAPS_ALLOWED, buffers, kNoTimestamp,
+          base::BindRepeating(&SourceBufferStream::GetMaxInterbufferDistance,
+                              base::Unretained(this)));
+      range_for_next_append_ = ranges_.end();
+    } else {
+      bytes_freed += bytes_deleted;
+    }
+
+    if (current_range->GetMemoryUsage() == 0) {
+      CHECK_NE(current_range, selected_range_);
+      DeleteAndRemoveRange(&range_itr);
+    }
+  }
+
+  if (new_range_for_append) {
+    range_for_next_append_ = AddToRanges(std::move(new_range_for_append));
+    DCHECK(range_for_next_append_ != ranges_.end());
+    if (range_for_next_append_ != ranges_.begin()) {
+      auto range_before_next = range_for_next_append_;
+      --range_before_next;
+      MergeWithNextRangeIfNecessary(range_before_next);
+    }
+    MergeWithNextRangeIfNecessary(range_for_next_append_);
+  }
+  return bytes_freed;
+}

+
+void AutoPictureInPictureTabHelper::CancelPendingAutoPictureInPicture() {
+  enter_when_hidden_ = false;
+  visibility_ack_pending_ = false;
+  visibility_weak_factory_.InvalidateWeakPtrs();
+}
+
+void AutoPictureInPictureTabHelper::EnterAutoPictureInPictureOnceHidden() {
+  if (!parc_hooks::auto_pip_visibility_sync) {
+    MaybeEnterAutoPictureInPicture();
+    MaybeScheduleAsyncTasks();
+    return;
+  }
+  enter_when_hidden_ = true;
+  if (web_contents()->GetVisibility() == content::Visibility::VISIBLE ||
+      visibility_ack_pending_) {
+    return;
+  }
+  visibility_ack_pending_ = true;
+  parc_hooks::auto_pip_visibility_sync(
+      web_contents(),
+      base::BindOnce(
+          &AutoPictureInPictureTabHelper::OnAutoPictureInPictureVisibilityReady,
+          visibility_weak_factory_.GetWeakPtr()));
+}
+
+void AutoPictureInPictureTabHelper::OnAutoPictureInPictureVisibilityReady(
+    bool hidden) {
+  CancelPendingAutoPictureInPicture();
+  const bool occluded =
+      host_occlusion_state_ == OcclusionState::kOccluded ||
+      (window_occlusion_helper_ &&
+       window_occlusion_helper_->GetOcclusionState() ==
+           OcclusionState::kOccluded);
+  if (!hidden || is_in_picture_in_picture_ ||
+      web_contents()->GetVisibility() == content::Visibility::VISIBLE ||
+      (tab_observer_helper_->IsTabActivated() && !occluded)) {
+    return;
+  }
+  MaybeEnterAutoPictureInPicture();
+  MaybeScheduleAsyncTasks();
+}
+
+void AutoPictureInPictureTabHelper::OnVisibilityChanged(
+    content::Visibility visibility) {
+  if (!enter_when_hidden_) {
+    return;
+  }
+  if (visibility == content::Visibility::VISIBLE) {
+    CancelPendingAutoPictureInPicture();
+    enter_when_hidden_ = true;
+    return;
+  }
+  EnterAutoPictureInPictureOnceHidden();
 }

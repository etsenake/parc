+    content::WebContents* inspected,
+    const DevToolsToggleAction& action,
+    base::RepeatingCallback<bool()> is_current) {
+  const auto inspected_owner = inspected ? inspected->GetWeakPtr() : nullptr;
+  if (!inspected_owner || !is_current || !is_current.Run() || !inspected_owner) {
+    return false;
+  }
+  auto* window = GetInstanceForInspectedWebContents(inspected);
+  if (!window) {
+    const auto initial = action.type() == DevToolsToggleAction::kShow
+                             ? DevToolsToggleAction::ShowNativePanel("elements")
+                             : action;
+    const auto weak_contents = inspected->GetWeakPtr();
+    OpenDevToolsWindow(inspected, initial,
+                       DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+    return weak_contents &&
+           GetInstanceForInspectedWebContents(weak_contents.get());
+  }
+  if (window->life_stage_ == kClosing) {
+    return false;
+  }
+  if (action.type() == DevToolsToggleAction::kShow) {
+    window->CloseWindow();
+    return true;
+  }
+  if (action.type() != DevToolsToggleAction::kShowNativePanel ||
+      window->life_stage_ != kLoadCompleted) {
+    window->ScheduleShow(action);

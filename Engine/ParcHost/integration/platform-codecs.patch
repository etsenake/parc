+// HE-AAC layers. It reports nothing until it has parsed about 128 bytes, so it
+// gets the access unit repeated as ADTS frames. Nullopt when the parser can't
+// judge the access unit, as for an empty, truncated or damaged one.
+std::optional<bool> CarriesSbr(
+    const std::vector<uint8_t>& audio_specific_config,
+    base::span<const uint8_t> access_unit) {

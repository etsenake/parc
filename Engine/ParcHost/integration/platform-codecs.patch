+      layers, [core_rate](const AudioFormatListItem& layer) {
+        return (layer.mASBD.mFormatID == kAudioFormatMPEG4AAC_HE ||
+                layer.mASBD.mFormatID == kAudioFormatMPEG4AAC_HE_V2) &&
+               layer.mASBD.mSampleRate == 2 * core_rate;

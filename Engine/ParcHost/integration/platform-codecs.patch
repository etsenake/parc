+  bool CurrentThreadIsRenderingThread() override { return false; }
+
+ private:
+  ~ParcMixedSink() override = default;
+
+  const AudioParameters params_;
+  base::Lock lock_;
+  raw_ptr<AudioRendererImpl> renderer_ = nullptr;
+  bool started_ = false;
+  bool playing_ = false;

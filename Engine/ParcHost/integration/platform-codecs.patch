+    base::AutoLock auto_lock(lock_);
+    started_ = true;
+  }
+  void Stop() override {
+    base::AutoLock auto_lock(lock_);
+    started_ = false;
+    playing_ = false;
+  }
+  void Pause() override {
+    base::AutoLock auto_lock(lock_);
+    playing_ = false;
+  }
+  void Play() override {
+    base::AutoLock auto_lock(lock_);
+    playing_ = true;
+  }
+  void Flush() override {}

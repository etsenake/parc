+             AudioFileStreamPropertyFlags*) {},
+          [](void*, UInt32, UInt32, const void*,
+             AudioStreamPacketDescription*) {},
+          kAudioFileAAC_ADTSType, &stream) != noErr) {
+    return std::nullopt;

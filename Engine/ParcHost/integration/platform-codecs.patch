+// The ADTS header size when `data` is exactly one ADTS frame with a payload,
+// as Chromium's MPEG-2 TS and ADTS stream parsers and WebCodecs chunks without
+// a description deliver AAC; zero otherwise, as for a raw access unit.
+// AudioToolbox rejects the header.
+size_t AdtsHeaderSize(base::span<const uint8_t> data) {
+  if (data.size() < kADTSHeaderMinSize || data[0] != 0xff ||
+      (data[1] & 0xf6) != 0xf0) {
+    return 0;
+  }
+  const size_t frame_size =
+      ((data[3] & 0x03) << 11) | (data[4] << 3) | (data[5] >> 5);
+  const size_t header_size =
+      (data[1] & 0x01) ? kADTSHeaderSizeNoCrc : kADTSHeaderSizeWithCrc;
+  if (frame_size != data.size() || frame_size <= header_size) {
+    return 0;
+  }
+  return header_size;

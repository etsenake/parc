+
+void MediaStreamCaptureIndicator::WebContentsDeviceUsage::SetCapturedSource(
+    int id, const std::optional<content::DesktopMediaID>& media_id) {
+  content::WebContents* source = nullptr;
+  if (media_id && media_id->type == content::DesktopMediaID::TYPE_WEB_CONTENTS) {
+    source = content::WebContents::FromRenderFrameHost(
+        content::RenderFrameHost::FromID(
+            media_id->web_contents_id.render_process_id,
+            media_id->web_contents_id.main_render_frame_id));
+  }
+  auto it = captured_sources_.find(id);
+  auto old = it == captured_sources_.end()
+                 ? base::WeakPtr<content::WebContents>()
+                 : it->second;
+  if (source == old.get()) {
+    if (!source) {
+      captured_sources_.erase(id);
+    }
+    return;
+  }
+  captured_sources_.erase(id);
+  auto next = source ? source->GetWeakPtr()
+                     : base::WeakPtr<content::WebContents>();
+  if (next) {
+    captured_sources_[id] = next;
+  }
+  // Observers defer UI work; the final state also accounts for other sessions.
+  for (Observer& observer : indicator_->observers_) {
+    if (old) {
+      observer.OnIsBeingSharedChanged(old.get(), indicator_->IsBeingShared(old.get()));
+    }
+    if (next) {
+      observer.OnIsBeingSharedChanged(next.get(), indicator_->IsBeingShared(next.get()));
+    }
+  }
+}
+
+bool MediaStreamCaptureIndicator::WebContentsDeviceUsage::IsCapturingSource(
+    content::WebContents* source) const {
+  for (const auto& [id, captured] : captured_sources_) {
+    if (captured.get() == source) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::OnceClosure MediaStreamCaptureIndicator::WebContentsDeviceUsage::
+    CreateStopCallbackForSource(content::WebContents* source) {
+  std::vector<base::OnceClosure> stops;
+  for (const auto& [id, captured] : captured_sources_) {
+    auto callback = display_media_stop_callbacks_.find(id);
+    if (captured.get() == source &&
+        callback != display_media_stop_callbacks_.end() && callback->second) {
+      stops.push_back(base::BindOnce(&WebContentsDeviceUsage::StopSourceStream,
+                                    weak_factory_.GetWeakPtr(), captured, id));
+    }
+  }
+  if (stops.empty()) {
+    return {};
+  }
+  return base::BindOnce([](std::vector<base::OnceClosure> stops) {
+    for (auto& stop : stops) {
+      std::move(stop).Run();
+    }
+  }, std::move(stops));
+}
+
+void MediaStreamCaptureIndicator::WebContentsDeviceUsage::StopSourceStream(
+    base::WeakPtr<content::WebContents> source, int id) {
+  auto it = captured_sources_.find(id);
+  if (!source || it == captured_sources_.end() || it->second.get() != source.get()) {
+    return;
+  }
+  // The same stream may have switched sources while a menu was open.
+  StopStream(kDisplayMedia, id);
+}
+
+base::OnceClosure MediaStreamCaptureIndicator::WebContentsDeviceUsage::
+    CreateStopCallbackForCurrentStreams(MediaType media_type) {
+  CHECK(media_type == kUserMedia || media_type == kDisplayMedia);
+  const auto& callbacks = media_type == kUserMedia
+                              ? user_media_stop_callbacks_
+                              : display_media_stop_callbacks_;
+  std::vector<base::OnceClosure> stops;
+  for (const auto& [id, callback] : callbacks) {
+    if (callback) {
+      stops.push_back(base::BindOnce(&WebContentsDeviceUsage::StopStream,
+                                    weak_factory_.GetWeakPtr(), media_type, id));
+    }
+  }
+  if (stops.empty()) {
+    return {};
+  }
+  return base::BindOnce([](std::vector<base::OnceClosure> stops) {
+    for (auto& stop : stops) {
+      std::move(stop).Run();
+    }
+  }, std::move(stops));
+}
+
+void MediaStreamCaptureIndicator::WebContentsDeviceUsage::StopStream(
+    MediaType media_type, int id) {
+  auto& callbacks = media_type == kUserMedia ? user_media_stop_callbacks_
+                                            : display_media_stop_callbacks_;
+  auto it = callbacks.find(id);
+  if (it == callbacks.end()) {
+    return;
+  }
+  // Remove before callback reentry. The real callback may destroy this usage;
+  // there is deliberately no access to members after Run().
+  auto callback = std::move(it->second);
+  callbacks.erase(it);
+  if (callback) {
+    std::move(callback).Run();
+  }
 }

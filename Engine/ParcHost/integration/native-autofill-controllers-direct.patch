+             web_contents(), CurrentPresentation()) &&
+         (!(ShouldRequestNameFromUser() ||
+            ShouldRequestExpirationDateFromUser()) ||
+          AutofillBubbleHandler::IsPresentationSupported(
+              web_contents(), AutofillUiPresentation::kCardFixFlow));

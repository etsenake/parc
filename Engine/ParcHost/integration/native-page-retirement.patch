+
+bool UnloadController::ValidateTabCloseRequest() const {
+  if (!tab_close_request_ || state_ != State::kIdle || is_delete_scheduled_ ||
+      IsUnclosableApp()) {
+    return false;
+  }
+  for (const auto& target : tab_close_request_->targets) {
+    auto* contents = target.contents.get();
+    if (!contents || contents->IsBeingDestroyed() || !target.tab ||
+        tabs::TabInterface::MaybeGetFromContents(contents) !=
+            target.tab.get() ||
+        target.tab->GetBrowserWindowInterface() != browser_ ||
+        target.document.AsRenderFrameHostIfValid() !=
+            contents->GetPrimaryMainFrame()) {
+      return false;
+    }
+    const int index =
+        browser_->tab_strip_model()->GetIndexOfWebContents(contents);
+    if (index == TabStripModel::kNoTab ||
+        !web_app::IsTabClosable(browser_->tab_strip_model(), index)) {
+      return false;
+    }
+#if BUILDFLAG(IS_CHROMEOS)
+    if (ash::boca::OnTaskLockedController::From(browser_)
+            ->is_locked_for_on_task()) {
+      return false;
+    }
+#endif
+  }
+  return true;
+}

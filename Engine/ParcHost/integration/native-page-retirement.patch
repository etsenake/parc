+  tab_close_request_->started = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&UnloadController::AdvanceTabClosePreflight,
+                                tab_close_weak_factory_.GetWeakPtr(), token));
+  return true;
+}

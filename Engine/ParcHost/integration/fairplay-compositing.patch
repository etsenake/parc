+    EXPECT_EQ(SkColors::kBlack,
+              SolidColorDrawQuad::MaterialCast(punch)->color);
+    EXPECT_EQ(SkBlendMode::kDstOut, punch->shared_quad_state->blend_mode);
+    EXPECT_FLOAT_EQ(0.5f, punch->shared_quad_state->opacity);

+void CARendererLayerTree::ContentLayer::CommitProtectedLayer(bool host_is_new) {
+  // Let go of a layer this host took for another token.
+  if (hosted_layer_ && hosted_layer_ != protected_layer_ &&
+      hosted_layer_.superlayer == ca_layer_) {
+    [hosted_layer_ removeFromSuperlayer];
+  }
+  const bool hosted_other_layer = hosted_layer_ != protected_layer_;
+  hosted_layer_ = protected_layer_;
+  if (!protected_layer_) {
+    return;
+  }
+
+  // A layer has one superlayer. Take it when this host is new or held
+  // another layer, or when no live tree holds it. Otherwise a newer host in
+  // another tree took it (the page moved to another window's compositor) and
+  // keeps it; this tree must not take it back on every commit.
+  if (protected_layer_.superlayer != ca_layer_) {
+    CALayer* current_host = protected_layer_.superlayer;
+    const bool held_by_live_tree =
+        current_host && current_host.superlayer != nil;
+    if (!host_is_new && !hosted_other_layer && held_by_live_tree) {
+      return;
+    }
+    [ca_layer_ addSublayer:protected_layer_];
+  }
+
+  // Fill the host. The host carries the quad's rect and opacity; its
+  // ancestors carry the transform, clip and rounded corners.
+  const CGRect bounds = ca_layer_.bounds;
+  if (!CGPointEqualToPoint(protected_layer_.anchorPoint, CGPointZero)) {
+    protected_layer_.anchorPoint = CGPointZero;
+  }
+  if (!CGPointEqualToPoint(protected_layer_.position, CGPointZero)) {
+    protected_layer_.position = CGPointZero;
+  }
+  if (!CGRectEqualToRect(protected_layer_.bounds, bounds)) {
+    protected_layer_.bounds = bounds;
+  }
+  if (!CATransform3DIsIdentity(protected_layer_.transform)) {
+    protected_layer_.transform = CATransform3DIdentity;
+  }
+  if (protected_layer_.opacity != 1) {
+    protected_layer_.opacity = 1;
+  }
+  if (protected_layer_.hidden) {
+    protected_layer_.hidden = NO;
+  }
+  if ([protected_layer_ isKindOfClass:[AVSampleBufferDisplayLayer class]]) {
+    AVSampleBufferDisplayLayer* av_layer =
+        static_cast<AVSampleBufferDisplayLayer*>(protected_layer_);
+    // Protected video is never captured: screenshots and screen sharing show
+    // black here, as in Safari.
+    if (!av_layer.preventsCapture) {
+      av_layer.preventsCapture = YES;
+    }
+    // cc laid the quad out at the video's display aspect ratio (object-fit is
+    // already applied), so the frame fills it, as Chromium's own video
+    // AVSampleBufferDisplayLayers do.
+    if (![av_layer.videoGravity isEqualToString:AVLayerVideoGravityResize]) {
+      av_layer.videoGravity = AVLayerVideoGravityResize;
+    }
+    // The workaround Chromium's video layers use for transformed HDR content,
+    // which is otherwise flipped vertically (https://crbug.com/398425794).
+    if (!av_layer.geometryFlipped) {
+      av_layer.geometryFlipped = YES;
+    }
+  }
+}

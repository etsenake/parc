+      parts.video_sqs->clip_rect = gfx::Rect(10, 10, 40, 40);
+      parts.video_sqs->mask_filter_info =
+          gfx::MaskFilterInfo(gfx::RRectF(gfx::RectF(10, 10, 80, 40), 4));
+    });

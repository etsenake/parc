+    EXPECT_EQ(gfx::Rect(50, 60, 100, 40), layer->clip_rect);
+    EXPECT_EQ(gfx::RRectF(gfx::RectF(20, 30, 200, 120), 12),
+              layer->rounded_corners);
+  }

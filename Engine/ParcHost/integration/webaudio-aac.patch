+void MojoAudioDecoderService::DecodePending() {
+  while (!decoding_ && !pending_decodes_.empty()) {
+    auto [buffer, callback] = std::move(pending_decodes_.front());
+    pending_decodes_.pop_front();
+    if (!buffer) {
+      std::move(callback).Run(DecoderStatus::Codes::kFailedToGetDecoderBuffer);
+      continue;
+    }
+    if (!decoder_) {
+      std::move(callback).Run(DecoderStatus::Codes::kNotInitialized);
+      continue;
+    }
+    decoding_ = true;
+    decoder_->Decode(std::move(buffer),
+                     base::BindOnce(&MojoAudioDecoderService::OnDecodeStatus,
+                                    weak_this_, std::move(callback)));
+  }
 }

+    bus = AudioBus::TryCreate(output->channels,
+                              static_cast<uint32_t>(output->frames));
+  }
+  if (bus) {
+    size_t offset = 0;
+    for (const auto& packet : output->packets) {
+      for (int channel = 0; channel < output->channels; ++channel) {

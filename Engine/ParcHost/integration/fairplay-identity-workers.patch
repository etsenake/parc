+// Parc: see content/public/browser/parc_worker_identity.h.
+ParcWorkerIdentityHook g_parc_worker_identity_hook = nullptr;
+
 }  // namespace
+
+// Installed on the main thread before content starts, so no thread check.
+void SetParcWorkerIdentityHook(ParcWorkerIdentityHook hook) {
+  g_parc_worker_identity_hook = hook;
+}
+
+void ApplyParcWorkerIdentity(BrowserContext* browser_context,
+                             const GURL& script_url,
+                             const GURL& top_level_site,
+                             std::string* user_agent,
+                             blink::UserAgentMetadata* metadata) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (g_parc_worker_identity_hook && browser_context) {
+    g_parc_worker_identity_hook(browser_context, script_url, top_level_site,
+                                user_agent, metadata);
+  }
+}
 

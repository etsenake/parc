+bool MediaStreamCaptureIndicator::IsBeingShared(
+    content::WebContents* source) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  for (const auto& [contents, usage] : usage_map_) {
+    if (usage->IsCapturingSource(source)) {
+      return true;
+    }
+  }
+  for (auto* inner : source->GetInnerWebContents()) {
+    if (IsBeingShared(inner)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::OnceClosure MediaStreamCaptureIndicator::CreateStopCallbackForSharedTab(
+    content::WebContents* source) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  std::vector<base::OnceClosure> stops;
+  for (const auto& [contents, usage] : usage_map_) {
+    auto stop = usage->CreateStopCallbackForSource(source);
+    if (stop) {
+      stops.push_back(std::move(stop));
+    }
+  }
+  for (auto* inner : source->GetInnerWebContents()) {
+    auto stop = CreateStopCallbackForSharedTab(inner);
+    if (stop) {
+      stops.push_back(base::BindOnce(
+          [](base::WeakPtr<content::WebContents> parent,
+             base::WeakPtr<content::WebContents> child,
+             base::OnceClosure stop) {
+            if (parent && child && child->GetOuterWebContents() == parent.get()) {
+              std::move(stop).Run();
+            }
+          }, source->GetWeakPtr(), inner->GetWeakPtr(), std::move(stop)));
+    }
+  }
+  if (stops.empty()) {
+    return {};
+  }
+  return base::BindOnce([](std::vector<base::OnceClosure> stops) {
+    for (auto& stop : stops) {
+      std::move(stop).Run();
+    }
+  }, std::move(stops));
+}
+
+base::OnceClosure MediaStreamCaptureIndicator::CreateStopCallbackForCurrentStreams(
+    content::WebContents* web_contents, MediaType media_type) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(media_type == kUserMedia || media_type == kDisplayMedia);
+  std::vector<base::OnceClosure> stops;
+  auto it = usage_map_.find(web_contents);
+  if (it != usage_map_.end()) {
+    auto stop = it->second->CreateStopCallbackForCurrentStreams(media_type);
+    if (stop) {
+      stops.push_back(std::move(stop));
+    }
+  }
+  for (auto* inner : web_contents->GetInnerWebContents()) {
+    auto stop = CreateStopCallbackForCurrentStreams(inner, media_type);
+    if (stop) {
+      stops.push_back(base::BindOnce(
+          [](base::WeakPtr<content::WebContents> parent,
+             base::WeakPtr<content::WebContents> child,
+             base::OnceClosure stop) {
+            // A menu owned by the old outer page cannot stop an inner page
+            // after that inner page has moved to another owner.
+            if (parent && child && child->GetOuterWebContents() == parent.get()) {
+              std::move(stop).Run();
+            }
+          }, web_contents->GetWeakPtr(), inner->GetWeakPtr(), std::move(stop)));
+    }
+  }
+  if (stops.empty()) {
+    return {};
+  }
+  return base::BindOnce([](std::vector<base::OnceClosure> stops) {
+    for (auto& stop : stops) {
+      std::move(stop).Run();
+    }
+  }, std::move(stops));
+}

+bool ProfileManager::IsNativeProfileLifecyclePending(
+    const base::FilePath& path) const {
+  return profiles_pending_destruction_.contains(path) ||
+         (GetProfileByPathInternal(path) && !GetProfileByPath(path));
+}
+
+bool ProfileManager::RunDeferredNativeProfileDiskCleanup(
+    const base::FilePath& path) {
+  auto it = native_profile_disk_cleanup_.find(path);
+  if (it == native_profile_disk_cleanup_.end())
+    return false;
+  if (GetProfileByPathInternal(path) || profiles_pending_destruction_.contains(path))
+    return true;
+  auto cleanup = std::move(it->second);
+  native_profile_disk_cleanup_.erase(it);
+  // The observer is a SupportsUserData destructor. Finish that destruction
+  // stack before the native owner starts any filesystem work.
+  content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, std::move(cleanup));
+  return true;
+}

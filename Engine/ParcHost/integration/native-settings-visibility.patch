+const parcHiddenRows = new Map<string, string>();
+if (loadTimeData.valueExists('parcHiddenRows')) {
+  const rows =
+      loadTimeData.getValue<Record<string, string[]>>('parcHiddenRows');
+  for (const [host, selectors] of Object.entries(rows)) {
+    parcHiddenRows.set(host, selectors.join(', '));
+  }
+}
+const parcHiddenRoots = new WeakSet<ShadowRoot>();
+
+export function hideParcRows(node: Node) {
+  const root = node.getRootNode();
+  if (!(root instanceof ShadowRoot) || parcHiddenRoots.has(root)) {
+    return;
+  }
+  const rows = parcHiddenRows.get(root.host.localName);
+  if (!rows) {
+    return;
+  }
+  parcHiddenRoots.add(root);
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(`${rows} { display: none !important; }`);
+  root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
+  for (const row of root.querySelectorAll<HTMLElement>(rows)) {
+    row.hidden = true;
+  }
+}
+
+export function isParcHiddenRow(element: Element): boolean {
+  if (!parcHiddenRows.size) {
+    return false;
+  }
+  const root = element.getRootNode();
+  const rows =
+      root instanceof ShadowRoot && parcHiddenRows.get(root.host.localName);
+  return !!rows && element.matches(rows);
+}

@@ -792,6 +792,13 @@
 
 void GCMClientImpl::Register(
     scoped_refptr<RegistrationInfo> registration_info) {
+  // Legacy sender-ID registration uses a retired endpoint. FCM Instance ID
+  // registration and the GCM transport remain available for website push.
+  if (GCMRegistrationInfo::FromRegistrationInfo(registration_info.get())) {
+    delegate_->OnRegisterFinished(registration_info, std::string(), GCM_DISABLED);
+    return;
+  }
+
   DCHECK_EQ(state_, READY);
   DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
 

+void MediaSessionImpl::SetUserVolumeMultiplier(double multiplier) {
+  // Reject NaN as well as infinities before sending a player multiplier.
+  if (!std::isfinite(multiplier))
+    return;
+  user_volume_multiplier_ = std::clamp(multiplier, 0.0, 1.0);
+  UpdateVolumeMultiplier();
+}

+void MediaSessionImpl::HandlePlaybackControlsAction(
+    media_session::mojom::PlaybackControlsAction action,
+    base::TimeDelta seek_time) {
+  using Action = media_session::mojom::PlaybackControlsAction;
+  std::erase_if(parc_playback_controls_players_,
+                [](const auto& player) { return !player.first; });
+  if (parc_playback_controls_players_.empty() &&
+      !parc::fairplay::FramePresentsSafariIdentity(GetRoutedFrame())) {
+    switch (action) {
+      case Action::kSeekTo: SeekTo(seek_time); break;
+      case Action::kPauseForDragging: Suspend(SuspendType::kUI); break;
+      case Action::kResumeForDragging: Resume(SuspendType::kUI); break;
+      case Action::kBeginScrubbing:
+      case Action::kEndScrubbing: break;
+    }
+    return;
+  }
+  if (parc_playback_controls_players_.empty() &&
+      (action == Action::kBeginScrubbing || action == Action::kPauseForDragging)) {
+    for (const auto& it : normal_players_) {
+      auto player = it.first.observer->GetPlaybackControlsWeakPtr();
+      if (player)
+        parc_playback_controls_players_.emplace_back(player, it.first.player_id);
+    }
+  }
+  if (!parc_playback_controls_players_.empty()) {
+    auto players = parc_playback_controls_players_;
+    if (action == Action::kEndScrubbing || action == Action::kResumeForDragging)
+      parc_playback_controls_players_.clear();
+    for (const auto& [player, id] : players) {
+      if (player)
+        player->OnHandlePlaybackControlsAction(id, action, seek_time);
+    }
+    return;
+  }
+  for (const auto& it : normal_players_)
+    it.first.observer->OnHandlePlaybackControlsAction(it.first.player_id, action,
+                                                    seek_time);
+}

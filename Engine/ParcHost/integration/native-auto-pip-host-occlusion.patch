+void AutoPictureInPictureTabHelper::SetHostOcclusionState(
+    OcclusionState occlusion_state) {
+  if (host_occlusion_state_ == occlusion_state) {
+    return;
+  }
+  host_occlusion_state_ = occlusion_state;
+  OnOcclusionStateChanged(occlusion_state);
+}
+
+void AutoPictureInPictureTabHelper::EnterAutoPictureInPictureOnceHidden() {
+  if (web_contents()->GetVisibility() == content::Visibility::VISIBLE) {
+    enter_when_hidden_ = true;
+    return;
+  }
+  enter_when_hidden_ = false;
+  MaybeEnterAutoPictureInPicture();
+  MaybeScheduleAsyncTasks();
+}
+
+void AutoPictureInPictureTabHelper::OnVisibilityChanged(
+    content::Visibility visibility) {
+  if (!enter_when_hidden_ || visibility == content::Visibility::VISIBLE) {
+    return;
+  }
+  enter_when_hidden_ = false;
+  const bool occluded =
+      host_occlusion_state_ == OcclusionState::kOccluded ||
+      (window_occlusion_helper_ &&
+       window_occlusion_helper_->GetOcclusionState() ==
+           OcclusionState::kOccluded);
+  if (is_in_picture_in_picture_ ||
+      (tab_observer_helper_->IsTabActivated() && !occluded)) {
+    return;
+  }
+  MaybeEnterAutoPictureInPicture();
+  MaybeScheduleAsyncTasks();
+}

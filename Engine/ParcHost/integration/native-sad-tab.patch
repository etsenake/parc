+// static
+std::unique_ptr<SadTab> SadTab::MaybeCreateNative(
+    content::WebContents* contents,
+    SadTabKind kind) {
+  auto* data = static_cast<NativeSadTabFactoryData*>(
+      contents->GetUserData(&kNativeSadTabFactoryKey));
+  if (!data) {
+    return nullptr;
+  }
+  // Copy the registered callback out of user-data storage. Its contract still
+  // forbids synchronous presentation callbacks while SadTabHelper constructs
+  // and assigns the returned model.
+  auto factory = data->factory;
+  auto result = factory.Run(contents, kind);
+  CHECK(result);
+  return result;
+}
 

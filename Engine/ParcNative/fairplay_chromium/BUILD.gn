import("//mojo/public/tools/bindings/mojom.gni")

assert(is_mac)

mojom("mojom") {
  sources = [ "chromium/fairplay_media.mojom" ]
  public_deps = [
    "//media/mojo/mojom",
    "//mojo/public/mojom/base",
    "//sandbox/policy/mojom",
    "//ui/gfx/geometry/mojom",
    "//url/mojom:url_mojom_gurl",
  ]
}

source_set("key_system") {
  public = [ "chromium/fairplay_key_system.h" ]
  sources = public
}

source_set("registration") {
  visibility = [ "//parc:*" ]
  sources = [
    "chromium/fairplay_cdm_info.cc",
    "chromium/fairplay_cdm_info.h",
    "chromium/fairplay_key_system_info.cc",
    "chromium/fairplay_key_system_info.h",
  ]
  public_deps = [
    "//content/public/common",
    "//media",
  ]
  deps = [
    ":key_system",
    "//base",
  ]
}

source_set("core") {
  visibility = [ ":*" ]
  public = [
    "core/fairplay_hls_keys.h",
    "core/fairplay_hls_media_selection.h",
    "core/fairplay_hls_media_selection_internal.h",
    "core/fairplay_hls_player.h",
    "core/fairplay_hls_player_internal.h",
    "core/fairplay_init_data.h",
    "core/fairplay_key_session.h",
    "core/fairplay_renderer.h",
    "core/fairplay_types.h",
  ]
  sources = [
    "core/fairplay_bitstream.cc",
    "core/fairplay_bitstream.h",
    "core/fairplay_hls_frame_stats.h",
    "core/fairplay_hls_frame_stats.mm",
    "core/fairplay_hls_keys.mm",
    "core/fairplay_hls_media_selection.mm",
    "core/fairplay_hls_player.mm",
    "core/fairplay_hls_player_layer.h",
    "core/fairplay_hls_player_layer.mm",
    "core/fairplay_hls_timeline.cc",
    "core/fairplay_hls_timeline.h",
    "core/fairplay_init_data.mm",
    "core/fairplay_key_session.mm",
    "core/fairplay_key_session_internal.h",
    "core/fairplay_renderer.mm",
  ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
  frameworks = [
    "AVFoundation.framework",
    "AudioToolbox.framework",
    "CoreAudio.framework",
    "CoreFoundation.framework",
    "CoreGraphics.framework",
    "CoreMedia.framework",
    "Foundation.framework",
    "MediaAccessibility.framework",
    "QuartzCore.framework",
    "VideoToolbox.framework",
  ]
}

source_set("gpu") {
  visibility = [ ":*" ]
  sources = [
    "chromium/fairplay_cdm_adapter.cc",
    "chromium/fairplay_cdm_adapter.h",
    "chromium/fairplay_cdm_factory.cc",
    "chromium/fairplay_cdm_factory.h",
    "chromium/fairplay_hls_player_service.h",
    "chromium/fairplay_hls_player_service.mm",
    "chromium/fairplay_hls_track_bridge.h",
    "chromium/fairplay_hls_track_bridge.mm",
    "chromium/fairplay_renderer_adapter.h",
    "chromium/fairplay_renderer_adapter.mm",
    "chromium/fairplay_task_runner.h",
  ]
  public_deps = [
    ":key_system",
    ":mojom",
  ]
  deps = [
    ":core",
    "//base",
    "//media",
    "//media/mojo/mojom",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//ui/accelerated_widget_mac",
    "//ui/gfx/geometry",
    "//url",
  ]
  frameworks = [
    "AVFoundation.framework",
    "QuartzCore.framework",
  ]
}

source_set("service") {
  visibility = [
    ":*",
    "//parc:*",
  ]
  sources = [
    "chromium/fairplay_media_service.cc",
    "chromium/fairplay_media_service.h",
    "chromium/fairplay_renderer_service.cc",
    "chromium/fairplay_renderer_service.h",
  ]
  public_deps = [
    ":gpu",
    ":mojom",
    "//media/mojo/services",
  ]
  deps = [
    "//base",
    "//media",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("unit_tests") {
  testonly = true
  visibility = [ "//content/test:*" ]
  sources = [ "chromium/fairplay_media_service_unittest.cc" ]
  deps = [
    ":service",
    "//base",
    "//base/test:test_support",
    "//media",
    "//media/mojo/services",
    "//mojo/public/cpp/bindings",
    "//testing/gtest",
  ]
}

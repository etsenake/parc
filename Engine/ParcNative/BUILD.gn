# Installed by the reviewed overlay at //parc/native.
# Shared native AppKit components and Chromium-backed native services. Other
# services and the full window/page adapters compile in //parc:browser.
import("//components/signin/features.gni")
import("//printing/buildflags/buildflags.gni")

assert(is_mac)

# Pure component conversion shared by original Chromium navigation and output.
source_set("native_internal_urls_api") {
  public = [ "native_internal_urls.h" ]
  sources = public
  public_deps = [ "//url" ]
}

# TabFeatures owns the genuine thumbnail helper for native browser profiles.
# The predicate implementation stays in //parc:browser; Chrome takes declarations.
source_set("native_tab_preview_api") {
  public = [ "native_tab_preview.h" ]
  sources = public
}

# Declaration-only seam for Chrome's real Cocoa context-menu presenter.
source_set("native_page_context_menu_api") {
  public = [ "native_page_context_menu.h" ]
  sources = public
}

# Chrome's windows.update preflight calls the engine without depending on
# //parc:browser or acquiring a Views window. Implementation stays in the real
# native_browser_window.mm owner.
source_set("native_window_state_api") {
  public = [ "native_window_state.h" ]
  sources = public
  public_deps = [ "//ui/base/mojom:ui_base_types" ]
}

# Chrome's picker can name the native dialog factory without a reverse
# dependency on //parc:browser or native_downloads. The used implementation
# stays in native_downloads' existing file_dialog.mm translation unit.
source_set("native_download_dialog_api") {
  public = [ "download_file_dialog.h" ]
  sources = public
  public_deps = [
    "//base",
    "//ui/shell_dialogs",
  ]
}

# Chrome callers use these declarations without acquiring //parc:browser (which
# already depends on Chrome). The implementation stays in the actual engine;
# the application owns and links its visible PiP presenter separately.
source_set("native_video_pip_api") {
  public = [
    "native_appkit_bridge.h",
    "video_overlay_window.h",
  ]
  sources = public
}

# Lifecycle acknowledgement is implemented in //parc:browser, without a dependency
# from Chrome back to //parc:browser.
source_set("native_background_picture_in_picture_api") {
  public = [
    "native_background_picture_in_picture.h",
    "native_background_picture_in_picture_api.h",
  ]
  sources = public
  public_deps = [ "//base" ]
}

# Chrome's BrowserWebContentsDelegate asks a Parc page's own alert sheet for

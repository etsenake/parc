---
import '../styles/global.css';
import { Font } from 'astro:assets';
import favicon from '../assets/images/favicon.png';
import og from '../assets/images/og.png';

interface Share {
  title: string;
  description: string;
  imageAlt: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  share?: Share;
}

const { title, description, canonical, robots, share } = Astro.props;
const shareImage = new URL(og.src, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}
{robots && <meta name="robots" content={robots}>}
<meta name="theme-color" content="#F4B79A">
{share && (
<Fragment>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Parc">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={share.title}>
<meta property="og:description" content={share.description}>
<meta property="og:image" content={shareImage}>
<meta property="og:image:width" content={String(og.width)}>
<meta property="og:image:height" content={String(og.height)}>
<meta property="og:image:alt" content={share.imageAlt}>
<meta name="twitter:card" content="summary_large_image">
</Fragment>
)}
<link rel="icon" href={favicon.src} sizes="64x64" type="image/png">
<Font cssVariable="--font-instrument-serif" preload />
<Font cssVariable="--font-instrument-sans" preload />
<Font cssVariable="--font-caveat" />
<Font cssVariable="--font-jetbrains-mono" />
</head>
<body>
<slot />
</body>
</html>

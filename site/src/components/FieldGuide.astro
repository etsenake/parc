---
import Card from './guide/Card.astro';
import Sketch from './guide/Sketch.astro';
import { specimens } from '../data/specimens';

const facts = [
  { title: 'Where it lives', id: 'plateHabitat' },
  { title: 'How to spot it', id: 'plateSpot' },
];

const steps = [
  { step: -1, label: 'Previous page', path: 'M15 6l-6 6 6 6' },
  { step: 1, label: 'Next page', path: 'M9 6l6 6-6 6' },
];
---
<section id="guide" class="guide sec">
<div class="wrap">
<div class="guide-head">
<div>
<p class="eyebrow">The little things</p>
<h2 class="h2">A field guide to what lives here.</h2>
</div>
<p class="hand note" aria-hidden="true">tap one</p>
</div>

<div class="guide-grid" id="guideGrid">
{specimens.map((specimen, index) => <Card specimen={specimen} index={index} />)}
</div>
<p class="hand guide-more">And more for you to discover.</p>
</div>

<div id="guideOverlay" class="g-overlay" hidden>
<div class="g-backdrop" id="gBackdrop"></div>
<div class="g-shell" id="gShell" aria-hidden="true"></div>
<div id="plate" class="plate" role="dialog" aria-modal="true" aria-labelledby="plateName">
<button class="plate-x" id="plateClose" type="button" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
<div class="plate-body">
<div id="plateL" class="plate-l plate-a">
<div class="plate-top">
<p class="mono">Plate <span id="plateNo">01</span></p>
<p class="hand" id="plateTag">spotted in the wild</p>
</div>
<div id="plateStage" class="stage"></div>
</div>
<div id="plateR" class="plate-r plate-a">
<div>
<h3 id="plateName" class="plate-name"></h3>
<p id="plateLatin" class="plate-latin"></p>
</div>
<p id="plateBehavior" class="plate-behavior"></p>
<div class="plate-facts">
{facts.map(({ title, id }) => <div><h4>{title}</h4><p id={id}></p></div>)}
</div>
<p id="plateNote" class="hand plate-note"></p>
<div class="plate-nav">
{steps.map(({ step, label, path }) => <button class="plate-step" type="button" data-step={step} aria-label={label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={path}/></svg></button>)}
</div>
</div>
</div>
</div>
</div>
</section>

{specimens.map((specimen, index) => <template id={`scene-${index}`}><Sketch id={specimen.id} kind="scene" /></template>)}

<script>
import { $, $$, el, reduced } from '../scripts/dom';
import { chime, sfx, whoosh } from '../scripts/sound';
import { specimens, type Clip } from '../data/specimens';

const plate = $('#plate'), plateL = $('#plateL'), plateR = $('#plateR'), stage = $('#plateStage');
const overlay = $('#guideOverlay'), shell = $('#gShell'), backdrop = $('#gBackdrop'), plateBody = $('.plate-body', plate);
const grid = $('#guideGrid'), closer = $('#plateClose');
const guideCards = $$('.card', grid);
const OPEN_EASE = 'cubic-bezier(.2,.9,.25,1)', SHUT_EASE = 'cubic-bezier(.4,0,.2,1)', CARD_RADIUS = '20px';
let current: number | null = null;
let plateFlip = false, busy = false;
let fade: Animation | null = null;
let swipe: [number, number] | null = null;

function flipPages() {
  plateFlip = !plateFlip;
  [plateL, plateR].forEach((p) => { p.classList.remove('plate-a', 'plate-b'); p.classList.add(plateFlip ? 'plate-b' : 'plate-a'); });
}

function fillPlate(i: number) {
  const sp = specimens[i];
  current = i;
  $('#plateNo').textContent = sp.no;
  $('#plateName').textContent = sp.name; $('#plateLatin').textContent = sp.latin; $('#plateBehavior').textContent = sp.behavior;
  $('#plateHabitat').textContent = sp.habitat; $('#plateSpot').textContent = sp.spot; $('#plateNote').textContent = 'field note: ' + sp.note;
  $('#plateTag').textContent = sp.clip ? 'spotted in the wild' : 'sketched from life';
  unmountPlateClip();
  plate.classList.toggle('wide', !!sp.clip);
  stage.classList.toggle('has-clip', !!sp.clip);
  if (sp.clip) mountPlateClip(sp.clip, sp.name + ' in Parc');
  else stage.replaceChildren($<HTMLTemplateElement>('#scene-' + i).content.cloneNode(true));
  plateBody.scrollTop = 0;
  flipPages();
}

function mountPlateClip(clip: Clip, label: string) {
  const frame = el('div', 'stage-window');
  const v = el('video');
  v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true; v.preload = 'auto';
  v.setAttribute('muted', ''); v.setAttribute('playsinline', '');
  v.poster = clip.poster; v.src = clip.video;
  v.setAttribute('aria-label', label);
  v.addEventListener('click', () => { if (v.paused) v.play().catch(() => {}); else v.pause(); });
  frame.appendChild(v);
  stage.replaceChildren(frame);
  if (!reduced) v.play().catch(() => {});
}

function unmountPlateClip() {
  const v = stage.querySelector('video');
  if (!v) return;
  v.pause(); v.removeAttribute('src'); v.load();
}

const rect = (r: DOMRect) => ({ left: r.left + 'px', top: r.top + 'px', width: r.width + 'px', height: r.height + 'px' });
const onScreen = (r: DOMRect) => r.bottom > 0 && r.top < innerHeight && r.width > 0;

function morph(from: DOMRect, to: DOMRect, r0: string, r1: string, duration: number, easing: string, o0 = 1, o1 = 1): Promise<Animation> {
  shell.style.display = 'block';
  const anim = shell.animate([{ ...rect(from), borderRadius: r0, opacity: o0 }, { ...rect(to), borderRadius: r1, opacity: o1 }], { duration, easing, fill: 'forwards' });
  return anim.finished.then(() => anim, () => anim);
}

function fadeBackdrop(show: boolean) {
  if (fade) fade.cancel();
  fade = backdrop.animate([{ opacity: show ? 0 : 1 }, { opacity: show ? 1 : 0 }], { duration: show ? 320 : 280, easing: show ? 'ease-out' : 'ease-in', fill: 'forwards' });
}

async function openPlate(i: number) {
  if (busy || current !== null) return;
  const card = guideCards[i];
  fillPlate(i);
  overlay.hidden = false;
  document.documentElement.classList.add('g-locked');
  sfx(() => { whoosh(true); chime([783.99, 1174.66], .1, .07); });
  if (reduced) { closer.focus({ preventScroll: true }); return; }
  busy = true;
  plate.classList.add('is-ghost');
  const from = card.getBoundingClientRect(), to = plate.getBoundingClientRect(), radius = getComputedStyle(plate).borderRadius;
  card.style.visibility = 'hidden';
  fadeBackdrop(true);
  const anim = await morph(from, to, CARD_RADIUS, radius, 480, OPEN_EASE);
  plate.classList.remove('is-ghost');
  flipPages();
  shell.style.display = 'none'; anim.cancel();
  busy = false;
  closer.focus({ preventScroll: true });
}

async function closePlate() {
  if (busy || current === null) return;
  const card = guideCards[current];
  current = null;
  sfx(() => whoosh(false));
  const finish = () => {
    overlay.hidden = true; plate.classList.remove('is-ghost'); shell.style.display = 'none';
    unmountPlateClip();
    if (fade) { fade.cancel(); fade = null; }
    guideCards.forEach((c) => { c.style.visibility = ''; });
    document.documentElement.classList.remove('g-locked');
    $('[data-open]', card).focus({ preventScroll: true });
    busy = false;
  };
  if (reduced) { finish(); return; }
  busy = true;
  const from = plate.getBoundingClientRect(), to = card.getBoundingClientRect(), radius = getComputedStyle(plate).borderRadius;
  plate.classList.add('is-ghost');
  fadeBackdrop(false);
  const anim = onScreen(to) ? await morph(from, to, radius, CARD_RADIUS, 400, SHUT_EASE) : await morph(from, from, radius, radius, 240, 'ease-in', 1, 0);
  anim.cancel();
  finish();
}

function step(dir: number) {
  if (busy || current === null) return;
  const n = (current + dir + specimens.length) % specimens.length;
  guideCards[current].style.visibility = '';
  fillPlate(n);
  if (!reduced) guideCards[n].style.visibility = 'hidden';
  sfx(() => whoosh(dir > 0));
}

$$('[data-open]', grid).forEach((b) => b.addEventListener('click', () => openPlate(Number(b.dataset.open))));
$$('[data-step]', plate).forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));
closer.addEventListener('click', closePlate);
overlay.addEventListener('click', (e) => { if (e.target === overlay || e.target === backdrop) closePlate(); });
document.addEventListener('keydown', (e) => {
  if (current === null) return;
  if (e.key === 'Escape') closePlate();
  else if (e.key === 'ArrowRight') step(1);
  else if (e.key === 'ArrowLeft') step(-1);
  else if (e.key === 'Tab') {
    const focusable = $$('button', plate).filter((b) => b.offsetParent !== null);
    const first = focusable[0], last = focusable[focusable.length - 1];
    if (!plate.contains(document.activeElement)) { e.preventDefault(); first.focus(); return; }
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
});
plate.addEventListener('pointerdown', (e) => { swipe = e.pointerType === 'mouse' ? null : [e.clientX, e.clientY]; });
plate.addEventListener('pointercancel', () => { swipe = null; });
plate.addEventListener('pointerup', (e) => {
  if (!swipe) return;
  const dx = e.clientX - swipe[0], dy = e.clientY - swipe[1];
  swipe = null;
  if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
});
</script>

<style>
.stage.has-clip{aspect-ratio:auto;padding:14px;background:var(--paper-deep)}
:global(.stage-window){aspect-ratio:1280/840;border-radius:1.25%/1.905%;overflow:hidden;background:#DCE3F2;box-shadow:0 0 0 .5px rgba(24,32,58,.18),0 8px 22px rgba(24,32,58,.16)}
:global(.stage-window video){display:block;width:100%;height:100%;object-fit:cover;cursor:pointer}
.plate.wide{width:min(1180px,100%)}
.plate.wide .plate-body{grid-template-columns:minmax(0,1.7fr) minmax(0,1fr)}
.guide{position:relative;padding-block:128px;background-color:#EFE5D2;background-image:radial-gradient(rgba(24,32,58,.09) 1.2px,transparent 1.6px);background-size:22px 22px}
.guide::before,.guide::after{content:"";position:absolute;left:0;right:0;top:-18px;height:18px;pointer-events:none}

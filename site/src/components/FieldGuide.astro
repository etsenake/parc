.guide-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:56px}
.guide-head > div{max-width:680px}
.guide-head .note{margin-top:10px}
.guide-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
.guide-more{margin-top:56px;text-align:center;font-size:32px;color:var(--umber);transform:rotate(-1.5deg)}

.g-overlay{position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;padding:24px}
.g-backdrop{position:absolute;inset:0;background:rgba(24,32,58,.42);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.g-shell{position:fixed;z-index:1;display:none;border:1.5px solid #CDBB9C;border-radius:26px;background:var(--paper);box-shadow:0 50px 100px rgba(24,32,58,.25);pointer-events:none}
.plate{position:relative;z-index:2;display:flex;width:min(1040px,100%);max-height:calc(100vh - 48px);max-height:calc(100dvh - 48px);overflow:hidden;border:1.5px solid #CDBB9C;border-radius:26px;background:var(--paper);box-shadow:0 50px 100px rgba(24,32,58,.25);touch-action:pan-y}
.plate.is-ghost{visibility:hidden}
.plate-body{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);width:100%;perspective:1800px}
.plate-l{position:relative;min-width:0;padding:24px 26px 26px;border-right:1.5px dashed #CDBB9C;background:var(--paper-deep);transform-origin:right center}
.plate-r{display:flex;flex-direction:column;gap:14px;min-width:0;padding:34px 38px 30px;transform-origin:left center}
.plate-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:16px}
.plate-top .mono{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--tan)}
.plate-top .hand{font-size:24px;color:var(--umber)}
.stage{position:relative;width:100%;aspect-ratio:520/340;overflow:hidden;border:1.5px solid var(--paper-line);border-radius:16px;background:#FFFDF6}
.stage svg{display:block;width:100%;height:100%}
.plate-r > div:first-child{padding-right:44px}
.plate-name{font:400 clamp(38px,3.6vw,54px)/.95 var(--serif)}
.plate-latin{margin-top:6px;font:italic 24px var(--serif);color:var(--latin)}
.plate-behavior{font-size:17px;line-height:1.55;color:#2E2A38}
.plate-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px;padding-top:16px;border-top:1.5px dashed var(--paper-line)}
.plate-facts h4{margin:0;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--tan)}
.plate-facts p{margin-top:6px;font-size:15px;line-height:1.5;color:var(--text)}
.plate-note{font-size:25px;line-height:1.15;transform:rotate(-1.5deg)}
.plate-nav{display:flex;gap:8px;margin-top:auto}
.plate-step{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:1.5px solid #CDBB9C;border-radius:50%;background:#FFFDF6;transition:transform .3s var(--spring),background-color .2s}
.plate-step:hover{background:#FFFFFF;transform:scale(1.06)}
.plate-step svg,.plate-x svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.plate-x{position:absolute;top:14px;right:14px;z-index:4;display:flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:1.5px solid #CDBB9C;border-radius:50%;background:#FFFDF6;transition:transform .3s var(--spring),background-color .2s}
.plate-x:hover{transform:rotate(90deg);background:#FFFFFF}
:global(html.g-locked){overflow:hidden}
@keyframes openL{from{opacity:0;transform:rotateY(70deg)}to{opacity:1;transform:none}}
@keyframes openL2{from{opacity:0;transform:rotateY(70deg)}to{opacity:1;transform:none}}
@keyframes openR{from{opacity:0;transform:rotateY(-70deg)}to{opacity:1;transform:none}}
@keyframes openR2{from{opacity:0;transform:rotateY(-70deg)}to{opacity:1;transform:none}}
.plate-l.plate-a{animation:openL .95s cubic-bezier(.2,.9,.25,1) both}
.plate-l.plate-b{animation:openL2 .95s cubic-bezier(.2,.9,.25,1) both}
.plate-r.plate-a{animation:openR .95s cubic-bezier(.2,.9,.25,1) .08s both}
.plate-r.plate-b{animation:openR2 .95s cubic-bezier(.2,.9,.25,1) .08s both}
@media (max-width:1100px){.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.guide-grid{grid-template-columns:minmax(0,1fr)}}
@media (max-height:600px) and (min-width:761px){.plate-body{overflow-y:auto;overscroll-behavior:contain}}
@media (max-width:760px){.plate-body{display:block;overflow-y:auto;overscroll-behavior:contain}.plate-l{border-right:0;border-bottom:1.5px dashed #CDBB9C;padding:18px 16px 20px}.plate-l .plate-top{padding-right:48px}.plate-r{padding:22px 20px 26px}.plate-r > div:first-child{padding-right:0}.plate-name{font-size:40px}}
@media (max-width:640px){
  .guide{padding-top:88px;padding-bottom:88px}
  .g-overlay{padding:0;align-items:flex-end}
  .plate{width:100%;max-height:92vh;max-height:92dvh;border-bottom:0;border-radius:24px 24px 0 0}
  .g-shell{border-radius:24px 24px 0 0}
  .plate-l{padding-bottom:24px}
  .plate-r{padding:26px 22px}
}
</style>

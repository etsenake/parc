---
import { DOWNLOAD, SOURCE } from '../lib/links';

const links = [
  { href: 'whats-new/', text: 'What’s new' },
  { href: SOURCE, text: 'Source' },
  { href: DOWNLOAD, text: 'Download' },
  { href: '#top', text: 'Back to the top' },
];
---
<footer class="foot sec">
<div class="wrap foot-top">
<div class="foot-def">
<p>parc <span>/pärk/</span> noun</p>
<p>1. A browser one guy built instead of sleeping. 2. A nice place to sit.</p>
</div>
<nav class="foot-links" aria-label="Footer">
{links.map((link) => <a href={link.href}>{link.text}</a>)}
</nav>
</div>
<p class="foot-word" aria-hidden="true">parc</p>
</footer>


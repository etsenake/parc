<script>
import { $, $$ } from '../scripts/dom';
import { chime, sfx } from '../scripts/sound';

$$<HTMLButtonElement>('.copy-btn', $('#download')).forEach((b) => {
  let timer = 0;
  b.addEventListener('click', () => {
    const text = b.dataset.copy ?? '';
    const done = () => { b.textContent = 'Copied'; clearTimeout(timer); timer = window.setTimeout(() => { b.textContent = 'Copy'; }, 1600); };
    const select = () => { const code = b.parentElement?.querySelector('code'); if (!code) return; const r = document.createRange(); r.selectNodeContents(code); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); };
    try {
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, () => { select(); done(); });
      else { select(); done(); }
    } catch { select(); done(); }
    sfx(() => chime([1046.5, 1318.51], .06, .08));
  });
});
</script>

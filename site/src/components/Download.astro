.download > img{display:block;width:64px;height:auto;margin:0 auto 30px}
.download h2{font:400 clamp(56px,7.4vw,116px)/.94 var(--serif);letter-spacing:-.02em}
.download h2 em{font-style:italic}
.download .lede{max-width:560px;margin:28px auto 0;font-size:19px;line-height:1.55;color:#3A2240}
.download-row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px;margin-top:38px}
.download .btn-ink{background:#2A1838;color:#FCE3B6}
.download a.btn-ink:hover{color:#FCE3B6}
.download-meta{margin-top:26px;font-size:14px;font-weight:500;color:#3A2240}
.download-meta a{color:#2A1838;font-weight:600}

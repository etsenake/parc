---
import { Image } from 'astro:assets';
import mark from '../assets/images/p-mark.png';
import { BREW, DOWNLOAD, SOURCE } from '../lib/links';
import { latestRelease } from '../lib/releases';

const release = await latestRelease();
---
<section id="download" class="download sec">
<Image class="kite" src={mark} alt="" width={64} height={95} densities={[1, 2]} format="png" loading="eager" decoding="auto" />
<h2>You don’t have<br><em>to let go.</em></h2>
<p class="lede">Bring all 100+ tabs. There’s room.</p>
<div class="download-row">
<a class="btn-ink" href={DOWNLOAD}>
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>
Download for Mac
</a>
<div class="brew">
<code>{BREW}</code>
<button class="copy-btn" type="button" data-copy={BREW}>Copy</button>
</div>
</div>
<p class="download-meta">{release && <span>Parc {release.version} · </span>}macOS 13+ on Apple Silicon. Updates itself, security fixes included. <a href={SOURCE}>Source on GitHub</a></p>
</section>


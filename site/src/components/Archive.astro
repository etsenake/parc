---
interface Row {
  top: string;
  color: string;
  title: string;
  age: string;
  fall?: 'l1' | 'l2' | 'l3';
}

const rows: Row[] = [
  { top: '0', color: '#3D63F0', title: 'Team calendar', age: 'now' },
  { top: '62px', color: '#F0A35E', title: 'A newsletter from March', age: '13 h', fall: 'l1' },
  { top: '124px', color: '#237A51', title: 'Pull request #212', age: '2 min' },
  { top: '186px', color: '#E86A5A', title: 'That recipe you might make', age: '14 h', fall: 'l2' },
  { top: '248px', color: '#7550E6', title: 'Standup notes', age: '1 h' },
  { top: '310px', color: '#3AA0C8', title: 'Weather in Lisbon', age: '16 h', fall: 'l3' },
];
---
<section class="arch sec">
<svg class="scribble" viewBox="0 0 1000 110" aria-hidden="true"><defs><linearGradient id="scribbleInk" x1="0" x2="1"><stop offset="0" stop-color="#FF4A57"/><stop offset=".5" stop-color="#B0408F"/><stop offset="1" stop-color="#2D5BFF"/></linearGradient></defs><path pathLength="1" d="M20 64C70 34 120 34 170 60S270 88 320 62S420 34 470 58C520 82 590 92 628 66C660 44 650 14 616 16C584 18 576 50 604 66C640 86 700 84 740 62S840 36 890 58S960 74 984 52"/></svg>
<div class="wrap split">
<div class="arch-art">
<div class="arch-box" aria-hidden="true">
{rows.map((row) => <div class:list={['arow', row.fall]} style={`top:${row.top}`}><span style={`background:${row.color}`}></span><b>{row.title}</b><em>{row.age}</em></div>)}
<div class="archive-bin">
<svg viewBox="0 0 24 24"><path d="M3 7h18v4H3z"/><path d="M5 11v9h14v-9"/><path d="M10 15h4"/></svg>
<p>Archive<small>Still here.</small></p>
</div>
</div>
</div>
<div class="copy">
<p class="eyebrow">Auto-archive</p>
<h2 class="h2">Hi, I’m a tab hoarder.</h2>
<p class="body">100+ tabs across 10 windows, one very tired Mac. Arc got me clean, and Parc keeps me that way: untouched tabs tuck themselves away after 12 hours.</p>
<p class="hand note" aria-hidden="true">relax, hoarders. nothing’s gone.</p>
</div>
</div>
</section>


x 61px repeat-x}
.scribble{position:absolute;left:50%;top:8px;width:min(1000px,88%);height:auto;transform:translateX(-50%);overflow:visible;pointer-events:none}
.scribble path{fill:none;stroke:url(#scribbleInk);stroke-width:5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:0;transition:stroke-dashoffset 2.4s cubic-bezier(.65,0,.25,1)}
.scribble.is-waiting path{stroke-dashoffset:1}
.arch .split{flex-wrap:wrap-reverse;gap:72px}
.arch-art{flex:1 1 380px;display:flex;justify-content:center}
.arch-box{position:relative;width:340px;height:570px}
.arch .copy{flex:1 1 360px;max-width:500px}
.arow{position:absolute;left:0;right:0;z-index:2;height:52px;display:flex;align-items:center;gap:12px;padding:0 16px;border-radius:14px;background:#FFFFFF;box-shadow:0 1px 0 rgba(24,32,58,.06),0 8px 20px rgba(24,32,58,.06)}
.arow span{flex:none;width:20px;height:20px;border-radius:6px}
.arow b{flex:1;min-width:0;font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.arow em{font-style:normal;font-size:12px;color:#6F6452}
.archive-bin{position:absolute;left:18px;right:18px;top:470px;z-index:3;height:96px;display:flex;align-items:center;gap:18px;padding:0 24px;border-radius:22px;background:var(--navy);color:var(--page);box-shadow:0 24px 44px rgba(24,32,58,.28)}
.archive-bin svg{flex:none;width:34px;height:34px;fill:none;stroke:#FFE7A0;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.archive-bin p{font:30px/1 var(--serif)}
.archive-bin small{display:block;margin-top:4px;font:13px var(--sans);color:#D9D2C3}
@keyframes fall1{0%{opacity:0;transform:translateY(-10px)}6%{opacity:1;transform:none}46%{opacity:1;transform:none}54%{transform:translate(10px,18px) rotate(-7deg)}66%{transform:translate(-30px,150px) rotate(12deg)}78%{transform:translate(20px,290px) rotate(-10deg);opacity:1}90%{transform:translate(-6px,410px) rotate(4deg) scale(.82);opacity:0}100%{transform:translate(-6px,410px) scale(.82);opacity:0}}
@keyframes fall2{0%{opacity:0;transform:translateY(-10px)}6%{opacity:1;transform:none}46%{opacity:1;transform:none}54%{transform:translate(-10px,16px) rotate(6deg)}66%{transform:translate(26px,110px) rotate(-12deg)}78%{transform:translate(-16px,210px) rotate(9deg);opacity:1}90%{transform:translate(4px,300px) rotate(-3deg) scale(.82);opacity:0}100%{transform:translate(4px,300px) scale(.82);opacity:0}}
@keyframes fall3{0%{opacity:0;transform:translateY(-10px)}6%{opacity:1;transform:none}46%{opacity:1;transform:none}54%{transform:translate(8px,14px) rotate(-5deg)}66%{transform:translate(-20px,64px) rotate(10deg)}78%{transform:translate(14px,122px) rotate(-8deg);opacity:1}90%{transform:translate(0,176px) rotate(3deg) scale(.82);opacity:0}100%{transform:translate(0,176px) scale(.82);opacity:0}}
.l1{animation:fall1 10s ease-in-out infinite}
.l2{animation:fall2 10s ease-in-out infinite;animation-delay:3.3s}
.l3{animation:fall3 10s ease-in-out infinite;animation-delay:6.6s}
@media (max-width:640px){
  .arch{padding-top:88px;padding-bottom:88px}
  .arch-box{width:min(340px,100%)}
  .arch::after{height:43px;-webkit-mask-size:760px 43px;mask-size:760px 43px}
  .scribble path{stroke-width:11}
}
</style>

<script>
import { $, reduced } from '../scripts/dom';

const scribble = $<SVGSVGElement>('.arch .scribble');
if (!reduced && 'IntersectionObserver' in window) {
  scribble.classList.add('is-waiting');
  new IntersectionObserver((entries, seen) => entries.forEach((e) => { if (e.isIntersecting) { scribble.classList.remove('is-waiting'); seen.disconnect(); } }), { threshold: .6 }).observe(scribble);
}
</script>

@keyframes sway{0%,100%{transform:rotate(-1.2deg)}50%{transform:rotate(1.2deg)}}
.sign{position:relative;max-width:740px;margin:0 auto;transform-origin:50% 0;animation:sway 8s ease-in-out infinite}
.sign-aside{position:absolute;right:-150px;top:30px;font-size:30px;transform:rotate(8deg)}
.sign-board{padding:14px;border-radius:24px;background:#1F4D36;box-shadow:0 30px 60px rgba(20,50,35,.3)}
.sign-inner{padding:44px 48px 48px;border:3px solid #F3EAD6;border-radius:15px;color:#F3EAD6}
.sign-inner > p{font-size:13px;font-weight:700;letter-spacing:.24em;text-transform:uppercase}
.sign-inner h2{margin-top:14px;font:400 clamp(42px,5vw,64px)/1 var(--serif)}
.sign-inner ol{display:flex;flex-direction:column;gap:14px;margin-top:30px;padding:0;list-style:none;font:clamp(22px,2.4vw,28px)/1.2 var(--serif)}
.sign-inner li{display:flex;gap:18px}
.sign-inner li span:first-child{min-width:22px;font-style:italic;color:#F7C08A}
.sign-posts{display:flex;justify-content:space-around;padding:0 120px}
.sign-posts i{width:26px;height:150px;border-radius:0 0 4px 4px;background:#6B4A2E}
@media (max-width:900px){.sign-aside{display:none}}
@media (max-width:640px){
  .rules{padding-top:88px}
  .rules::before{height:42px;background-size:1080px 42px}
  .sign-inner{padding:28px 22px 30px}
  .sign-posts{padding:0 56px}
}

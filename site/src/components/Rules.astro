---
const rules = [
  'Walk right in. No account.',
  'Nobody’s counting visitors.',
  'Notes and Easels stay on your Mac.',
  'The code’s on GitHub.',
  'Leave your tabs wherever. Parc tidies up.',
];
---
<section id="rules" class="rules sec">
<div class="sign">
<p class="hand sign-aside" aria-hidden="true">(dogs welcome)</p>
<div class="sign-board">
<div class="sign-inner">
<p>Official Parc rules</p>
<h2>Please enjoy the internet.</h2>
<ol>
{rules.map((rule, i) => <li><span>{i + 1}</span><span>{rule}</span></li>)}
</ol>
</div>
</div>
<div class="sign-posts" aria-hidden="true"><i></i><i></i></div>
</div>
</section>


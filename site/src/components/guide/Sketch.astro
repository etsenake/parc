---
import mark from '../../assets/images/p-mark.png';
import type { SketchId } from '../../data/specimens';

interface Props {
  id: SketchId;
  kind: 'card' | 'scene';
  class?: string;
}

const { id, kind, class: className } = Astro.props;
---
{id === 'split' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="16" y="14" width="168" height="92" rx="12" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5"/><rect class="bob" x="28" y="28" width="68" height="66" rx="7" fill="#DCE5FF" stroke="#18203A" stroke-width="2"/><rect x="104" y="28" width="68" height="66" rx="7" fill="#FFE0DE" stroke="#18203A" stroke-width="2"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A tab is dragged into the window and the page splits in two"><rect x="20" y="20" width="480" height="300" rx="16" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><rect x="32" y="32" width="88" height="276" rx="10" fill="#E3E8FC"/><rect x="44" y="84" width="64" height="20" rx="6" fill="#FFFFFF"/><rect x="44" y="112" width="64" height="20" rx="6" fill="#FFFFFF"/><rect x="44" y="140" width="64" height="20" rx="6" fill="#FFFFFF"/><rect class="s0a" x="132" y="32" width="356" height="276" rx="10" fill="#DCE5FF"/><rect class="s0b" x="314" y="32" width="174" height="276" rx="10" fill="#FFE0DE"/><rect class="s0t" x="44" y="168" width="64" height="20" rx="6" fill="#FF4A57"/><text class="ann" x="330" y="296" font-size="26">drag a tab in</text><path class="draw" d="M330 280 C 300 262, 250 230, 200 190" fill="none" stroke="#18203A" stroke-width="2.4" stroke-linecap="round"/></svg>)
: id === 'peek' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="16" y="24" width="140" height="84" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5"/><path d="M30 46 H110 M30 60 H96 M30 74 H104" stroke="#CFC4B0" stroke-width="5" stroke-linecap="round"/><rect class="pop" x="92" y="10" width="92" height="70" rx="10" fill="#DCE5FF" stroke="#18203A" stroke-width="2.5"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A link floats over the page, the page steps back, then the Peek is flung away"><g class="s1back"><rect x="20" y="20" width="480" height="300" rx="16" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><path d="M60 70 H300 M60 100 H260 M60 130 H280" stroke="#E2D9C8" stroke-width="10" stroke-linecap="round"/><path d="M60 170 H190" stroke="#2D5BFF" stroke-width="4" stroke-linecap="round"/><path d="M60 205 H300 M60 235 H240" stroke="#E2D9C8" stroke-width="10" stroke-linecap="round"/></g><rect class="s1scrim" x="20" y="20" width="480" height="300" rx="16" fill="#3D63F0"/><g class="s1card"><rect x="150" y="48" width="320" height="244" rx="14" fill="#FBF7EF" stroke="#18203A" stroke-width="3"/><circle cx="490" cy="64" r="11" fill="#3D63F0"/><path d="M486 60 L494 68 M494 60 L486 68" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/><circle cx="490" cy="94" r="11" fill="#3D63F0"/><path d="M486 98 L494 90 M489 90 H494 V95" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M176 112 H420 M176 140 H380 M176 168 H400" stroke="#E2D9C8" stroke-width="9" stroke-linecap="round"/><rect x="176" y="194" width="140" height="74" rx="8" fill="#FFE0DE"/></g><text class="ann" x="36" y="306" font-size="24">yours takes a polite step back</text></svg>)
: id === 'commandbar' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="14" y="40" width="172" height="42" rx="21" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5"/><circle cx="38" cy="60" r="7" fill="none" stroke="#18203A" stroke-width="2.5"/><path d="M43 65 L48 70" stroke="#18203A" stroke-width="2.5" stroke-linecap="round"/><path class="bob" d="M60 61 H116" stroke="#CFC4B0" stroke-width="5" stroke-linecap="round"/><rect x="130" y="49" width="44" height="23" rx="6" fill="#F5EFE4" stroke="#18203A" stroke-width="2"/><text class="lbl" x="152" y="65" font-size="12">⌘T</text></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="The command bar types New Easel and shows results"><rect x="20" y="20" width="480" height="300" rx="16" fill="#F3EBDC"/><rect x="70" y="56" width="380" height="228" rx="16" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><circle cx="100" cy="94" r="9" fill="none" stroke="#18203A" stroke-width="2.6"/><path d="M106 100 L112 106" stroke="#18203A" stroke-width="2.6" stroke-linecap="round"/><text x="124" y="102" font-family="'Instrument Sans',sans-serif" font-size="22" font-weight="600" fill="#18203A">New Easel</text><rect class="s2cover" x="122" y="78" width="130" height="32" fill="#FFFFFF"/><rect x="392" y="82" width="42" height="24" rx="6" fill="#F5EFE4" stroke="#18203A" stroke-width="1.8"/><text class="lbl" x="413" y="99" font-size="12">⌘T</text><path d="M70 124 H450" stroke="#ECE6DA" stroke-width="2"/><g class="s2r"><rect x="84" y="136" width="352" height="38" rx="10" fill="#E3E8FC"/><text x="104" y="161" font-family="'Instrument Sans',sans-serif" font-size="16" font-weight="600" fill="#18203A">New Easel</text></g><g class="s2r s2r2"><text x="104" y="203" font-family="'Instrument Sans',sans-serif" font-size="16" fill="#3A3546">New Note</text></g><g class="s2r s2r3"><text x="104" y="243" font-family="'Instrument Sans',sans-serif" font-size="16" fill="#3A3546">Easels and Notes in your Library</text></g><text class="ann" x="300" y="318" font-size="24">⌘T, then just type</text></svg>)
: id === 'easel' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="18" y="12" width="164" height="96" rx="10" fill="#FFFDF6" stroke="#18203A" stroke-width="2.5"/><rect x="32" y="26" width="52" height="40" rx="4" transform="rotate(-6 58 46)" fill="#FFE7A0" stroke="#18203A" stroke-width="2"/><rect x="100" y="24" width="66" height="48" rx="6" fill="#DCE5FF" stroke="#18203A" stroke-width="2"/><path d="M104 66 L122 48 L136 60 L148 50 L162 66" fill="none" stroke="#2D5BFF" stroke-width="2"/><path class="bob" d="M36 90 C 56 74, 76 100, 96 86 S 136 78, 160 92" fill="none" stroke="#FF4A57" stroke-width="3" stroke-linecap="round"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A sticky note, an image and a live page land on an Easel and get connected"><rect x="20" y="20" width="480" height="300" rx="16" fill="#FFFDF6" stroke="#18203A" stroke-width="3"/><g class="in-drop"><rect x="56" y="54" width="140" height="110" rx="6" transform="rotate(-5 126 109)" fill="#FFE7A0" stroke="#18203A" stroke-width="2.4"/><path d="M76 92 H170 M76 114 H156 M76 136 H164" transform="rotate(-5 126 109)" stroke="#C9A84F" stroke-width="6" stroke-linecap="round"/></g><g class="in-slide"><rect x="304" y="56" width="164" height="118" rx="8" fill="#DCE5FF" stroke="#18203A" stroke-width="2.4"/><path d="M312 160 L350 112 L384 146 L414 118 L460 160 Z" fill="#2D5BFF" opacity=".55"/><circle cx="438" cy="84" r="12" fill="#FFE7A0"/></g><g class="in-pop"><rect x="186" y="200" width="196" height="100" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><rect x="188" y="202" width="192" height="22" rx="8" fill="#E3E8FC"/><path d="M204 246 H340 M204 268 H310" stroke="#E2D9C8" stroke-width="8" stroke-linecap="round"/></g><path class="draw d4" d="M200 112 C 240 92, 268 98, 298 112" fill="none" stroke="#FF4A57" stroke-width="3" stroke-linecap="round"/><path class="draw d5" d="M384 182 C 380 196, 370 204, 356 210" fill="none" stroke="#FF4A57" stroke-width="3" stroke-linecap="round"/><path class="draw d6" d="M58 282 C 80 262, 100 300, 124 278 S 160 266, 170 290" fill="none" stroke="#2D5BFF" stroke-width="3" stroke-linecap="round"/><text class="ann" x="52" y="250" font-size="24">live, still clickable</text></svg>)
: id === 'notes' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><path d="M54 10 H130 L150 30 V110 H54 Z" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5" stroke-linejoin="round"/><path d="M130 10 V30 H150" fill="#F5EFE4" stroke="#18203A" stroke-width="2.5" stroke-linejoin="round"/><path d="M68 30 H108" stroke="#18203A" stroke-width="5" stroke-linecap="round"/><path d="M68 46 H134 M68 60 H128 M68 74 H136 M68 88 H110" stroke="#CFC4B0" stroke-width="4" stroke-linecap="round"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A note writes itself"><rect x="20" y="20" width="480" height="300" rx="16" fill="#F3EBDC"/><path d="M140 30 H340 L380 70 V312 H140 Z" fill="#FFFFFF" stroke="#18203A" stroke-width="3" stroke-linejoin="round"/><path d="M340 30 V70 H380" fill="#F5EFE4" stroke="#18203A" stroke-width="3" stroke-linejoin="round"/><path class="draw d1" d="M166 76 H290" fill="none" stroke="#18203A" stroke-width="10" stroke-linecap="round"/><path class="draw d2" d="M166 118 H350" fill="none" stroke="#CFC4B0" stroke-width="6" stroke-linecap="round"/><path class="draw d3" d="M166 146 H330" fill="none" stroke="#CFC4B0" stroke-width="6" stroke-linecap="round"/><circle cx="175" cy="187" r="4.5" fill="#18203A"/><path class="draw d4" d="M196 187 H320" fill="none" stroke="#CFC4B0" stroke-width="6" stroke-linecap="round"/><circle cx="175" cy="223" r="4.5" fill="#18203A"/><path class="draw d5" d="M196 223 H296" fill="none" stroke="#CFC4B0" stroke-width="6" stroke-linecap="round"/><path class="draw d6" d="M166 262 H340" fill="none" stroke="#CFC4B0" stroke-width="6" stroke-linecap="round"/><text class="ann" x="392" y="150" font-size="24">stays on</text><text class="ann" x="392" y="176" font-size="24">your Mac</text></svg>)
: id === 'capture' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="14" y="12" width="172" height="96" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5"/><path d="M28 30 H112 M28 44 H96" stroke="#CFC4B0" stroke-width="5" stroke-linecap="round"/><rect x="28" y="56" width="74" height="40" rx="5" fill="#DCE5FF"/><rect x="24" y="52" width="82" height="48" rx="4" fill="none" stroke="#2D5BFF" stroke-width="2" stroke-dasharray="5 4"/><g class="bob"><rect x="118" y="36" width="60" height="52" rx="4" fill="#FFFFFF" stroke="#18203A" stroke-width="2.2"/><rect x="124" y="42" width="48" height="32" rx="2" fill="#DCE5FF"/><path d="M128 72 L138 60 L146 67 L153 60 L168 72 Z" fill="#7DB36B"/></g></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A dashed selection is dragged across a page and the capture lands in a white frame"><rect x="20" y="20" width="480" height="300" rx="16" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><path d="M60 64 H300 M60 92 H260" stroke="#E2D9C8" stroke-width="10" stroke-linecap="round"/><rect x="60" y="120" width="220" height="130" rx="10" fill="#DCE5FF"/><path d="M68 240 L130 170 L180 214 L222 176 L272 240 Z" fill="#7DB36B"/><rect class="draw" x="48" y="108" width="244" height="154" rx="6" fill="none" stroke="#2D5BFF" stroke-width="3" stroke-dasharray="10 8"/><g class="in-pop"><rect x="320" y="96" width="160" height="136" rx="6" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><rect x="332" y="108" width="136" height="88" rx="4" fill="#DCE5FF"/><path d="M336 192 L380 150 L410 176 L434 156 L464 192 Z" fill="#7DB36B"/></g><text class="ann" x="320" y="276" font-size="24">framed, ready to share</text></svg>)
: id === 'mini' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="14" y="10" width="172" height="100" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.5"/><path d="M28 30 H120 M28 44 H104 M28 58 H112" stroke="#CFC4B0" stroke-width="5" stroke-linecap="round"/><g class="bob"><rect x="104" y="60" width="72" height="42" rx="8" fill="#18203A"/><path d="M134 72 L148 81 L134 90 Z" fill="#FFE7A0"/></g></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A playing video shrinks into the sidebar, then pops out into picture in picture"><rect x="20" y="20" width="480" height="300" rx="16" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><rect x="32" y="32" width="100" height="276" rx="10" fill="#E3E8FC"/><rect x="40" y="250" width="84" height="48" rx="8" fill="none" stroke="#18203A" stroke-width="1.5" stroke-dasharray="4 4"/><g class="s6page"><path d="M150 252 H460 M150 280 H400" stroke="#E2D9C8" stroke-width="10" stroke-linecap="round"/></g><g class="s6v"><rect x="150" y="50" width="320" height="180" rx="12" fill="#18203A"/><path d="M296 116 L336 140 L296 164 Z" fill="#FFE7A0"/></g><g class="s6pip"><rect x="360" y="226" width="124" height="74" rx="10" fill="#18203A" stroke="#FFE7A0" stroke-width="2"/><path d="M414 252 L432 263 L414 274 Z" fill="#FFE7A0"/></g><text class="ann" x="150" y="320" font-size="22">follows you to the sidebar</text></svg>)
: id === 'crank' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="16" y="10" width="168" height="100" rx="12" fill="#B9C8F2" stroke="#18203A" stroke-width="2.5"/><rect x="24" y="20" width="24" height="80" rx="4" fill="#DCE5FF"/><rect class="frame-pulse" x="54" y="20" width="120" height="80" rx="6" fill="#FFFFFF" stroke="#18203A" stroke-width="2"/><g class="crank-turn"><path d="M48 84 L70 68" stroke="#18203A" stroke-width="5" stroke-linecap="round"/><circle cx="70" cy="68" r="5.5" fill="#FF4A57" stroke="#18203A" stroke-width="2"/><circle cx="48" cy="84" r="9" fill="#FFE7A0" stroke="#18203A" stroke-width="2.2"/></g></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A crank turns and the coloured frame around the page thickens"><rect x="20" y="20" width="480" height="300" rx="18" fill="#B9C8F2" stroke="#18203A" stroke-width="3"/><rect x="34" y="34" width="96" height="272" rx="8" fill="#DCE5FF"/><rect class="frame-pulse" x="144" y="34" width="342" height="272" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><g class="crank-turn" style="transform-origin:130px 250px"><path d="M130 250 L188 212" stroke="#18203A" stroke-width="12" stroke-linecap="round"/><circle cx="188" cy="212" r="12" fill="#FF4A57" stroke="#18203A" stroke-width="3"/><circle cx="130" cy="250" r="22" fill="#FFE7A0" stroke="#18203A" stroke-width="3"/></g><text class="ann" x="250" y="170" font-size="26">3 · Hairline to 13 · Gallery</text></svg>)
: id === 'archive' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><g class="rise-up"><rect x="58" y="14" width="84" height="22" rx="6" fill="#FFFFFF" stroke="#18203A" stroke-width="2"/><rect x="64" y="20" width="10" height="10" rx="3" fill="#E86A5A"/><path d="M80 25 H130" stroke="#CFC4B0" stroke-width="4" stroke-linecap="round"/></g><rect x="40" y="48" width="120" height="22" rx="5" fill="#18203A"/><path d="M48 70 V102 H152 V70" fill="#2A3352" stroke="#18203A" stroke-width="2.2"/><path d="M88 84 H112" stroke="#FFE7A0" stroke-width="4" stroke-linecap="round"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="An archived tab rises out of the Archive and goes back into the sidebar"><rect x="20" y="20" width="480" height="300" rx="16" fill="#F3EBDC"/><g class="rise-up"><rect x="160" y="60" width="200" height="44" rx="10" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><rect x="174" y="74" width="16" height="16" rx="4" fill="#E86A5A"/><path d="M202 82 H330" stroke="#CFC4B0" stroke-width="7" stroke-linecap="round"/></g><rect x="120" y="150" width="280" height="44" rx="10" fill="#18203A"/><path d="M136 194 V270 H384 V194" fill="#2A3352" stroke="#18203A" stroke-width="3"/><path d="M230 228 H290" stroke="#FFE7A0" stroke-width="7" stroke-linecap="round"/><text class="ann" x="300" y="306" font-size="24">nothing’s ever really gone</text></svg>)
: id === 'shortcuts' ? (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="30" y="44" width="42" height="40" rx="8" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="51" y="70" font-size="16">⌘</text><rect x="80" y="44" width="42" height="40" rx="8" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="101" y="70" font-size="16">⇧</text><g class="bob"><rect x="130" y="44" width="42" height="40" rx="8" fill="#FFE7A0" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="151" y="70" font-size="16">J</text></g></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="A keycap lifts and gets a new shortcut while a priority switch flips"><rect x="20" y="20" width="480" height="300" rx="16" fill="#F3EBDC"/><rect x="96" y="120" width="64" height="58" rx="12" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="128" y="157" font-size="22">⌘</text><rect x="172" y="120" width="64" height="58" rx="12" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="204" y="157" font-size="22">⇧</text><g class="s10lift"><rect x="248" y="120" width="64" height="58" rx="12" fill="#FFE7A0" stroke="#18203A" stroke-width="2.4"/><text class="lbl s10old" x="280" y="158" font-size="22">K</text><text class="lbl s10new" x="280" y="158" font-size="22" fill="#2D5BFF" style="fill:#2D5BFF">J</text></g><rect x="324" y="120" width="96" height="58" rx="12" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><rect x="150" y="232" width="200" height="48" rx="24" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><text class="lbl" x="200" y="262" font-size="14" style="fill:#3A3546">Website</text><text class="lbl" x="300" y="262" font-size="14" style="fill:#3A3546">Parc</text><g class="s10knob"><rect x="156" y="238" width="96" height="36" rx="18" fill="#18203A" opacity=".12"/></g><text class="ann" x="100" y="94" font-size="26">your keys, your rules</text></svg>)
: (kind === 'card'
  ? <svg class={className} viewBox="0 0 200 120"><rect x="22" y="60" width="52" height="40" rx="4" fill="#E9C9A0" stroke="#18203A" stroke-width="2.2"/><path d="M22 74 H74" stroke="#18203A" stroke-width="1.6"/><rect class="bob" x="34" y="30" width="34" height="28" rx="4" fill="#F2D9B5" stroke="#18203A" stroke-width="2"/><path d="M84 74 C 100 50, 112 50, 124 66" fill="none" stroke="#18203A" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/><rect x="128" y="34" width="56" height="70" rx="8" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4"/><circle cx="152" cy="80" r="5" fill="#FF4A57"/><path d="M157 80 V60 L166 63" fill="none" stroke="#FF4A57" stroke-width="2.2" stroke-linecap="round"/></svg>
  : <svg class={className} viewBox="0 0 520 340" role="img" aria-label="Bookmarks, passwords, history and extensions move into Parc, then a music note floats up"><rect x="20" y="20" width="480" height="300" rx="16" fill="#F3EBDC"/><rect x="40" y="110" width="120" height="150" rx="14" fill="#FFFFFF" stroke="#18203A" stroke-width="2.4" stroke-dasharray="6 5"/><text class="lbl" x="100" y="286" font-size="13" style="fill:#5A4E3B;font-weight:600">your old browser</text><rect x="352" y="90" width="140" height="180" rx="14" fill="#FFFFFF" stroke="#18203A" stroke-width="3"/><rect x="352" y="90" width="44" height="180" rx="14" fill="#E3E8FC"/><image href={mark.src} x="430" y="140" width="40" height="59"/><g class="trip trip1"><rect x="60" y="126" width="80" height="26" rx="6" fill="#FFE7A0" stroke="#18203A" stroke-width="1.8"/><text class="lbl" x="100" y="144" font-size="11">Bookmarks</text></g><g class="trip trip2"><rect x="60" y="158" width="80" height="26" rx="6" fill="#FFE0DE" stroke="#18203A" stroke-width="1.8"/><text class="lbl" x="100" y="176" font-size="11">Passwords</text></g><g class="trip trip3"><rect x="60" y="190" width="80" height="26" rx="6" fill="#DCE5FF" stroke="#18203A" stroke-width="1.8"/><text class="lbl" x="100" y="208" font-size="11">History</text></g><g class="trip trip4"><rect x="60" y="222" width="80" height="26" rx="6" fill="#DCEFE3" stroke="#18203A" stroke-width="1.8"/><text class="lbl" x="100" y="240" font-size="11">Extensions</text></g><g class="note-up"><circle cx="452" cy="80" r="7" fill="#18203A"/><path d="M459 80 V52 L472 56" fill="none" stroke="#18203A" stroke-width="2.6" stroke-linecap="round"/></g><text class="ann" x="300" y="314" font-size="24">then it plays you a song</text></svg>)}

<style>
@keyframes crankTurn{0%,100%{transform:rotate(0)}50%{transform:rotate(320deg)}}
@keyframes framePulse{0%,100%{transform:scale(1)}50%{transform:scale(.9)}}
@keyframes riseUp{0%,12%{transform:translateY(34px);opacity:0}35%,78%{transform:none;opacity:1}100%{transform:translateY(34px);opacity:0}}
.crank-turn{transform-box:view-box;transform-origin:48px 84px;animation:crankTurn 4s cubic-bezier(.45,0,.25,1) infinite}
.frame-pulse{transform-box:fill-box;transform-origin:center;animation:framePulse 4s cubic-bezier(.45,0,.25,1) infinite}
.rise-up{animation:riseUp 3.6s cubic-bezier(.3,1.2,.5,1) infinite}
@keyframes draw{to{stroke-dashoffset:0}}
.draw{stroke-dasharray:700;stroke-dashoffset:700;animation:draw 1.5s ease .9s forwards}
.d1{animation-delay:.5s}.d2{animation-delay:.8s}.d3{animation-delay:1.1s}.d4{animation-delay:1.4s}.d5{animation-delay:1.7s}.d6{animation-delay:2s}
@keyframes annIn{to{opacity:1}}
.ann{opacity:0;font-family:var(--hand);fill:var(--navy);animation:annIn .6s ease 1.6s forwards}
.lbl{font-family:var(--sans);font-weight:700;fill:var(--navy);text-anchor:middle}

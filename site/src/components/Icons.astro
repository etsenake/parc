---
import { Image } from 'astro:assets';
import mono from '../assets/images/p-mono.png';
import { ICONS } from '../data/icons';

const menus = [
  { label: 'File', more: false },
  { label: 'Edit', more: false },
  { label: 'View', more: false },
  { label: 'History', more: true },
  { label: 'Bookmarks', more: true },
  { label: 'Window', more: true },
  { label: 'Help', more: true },
];
const [dockIcon] = ICONS;
---
<section id="desktop" class="desk sec">
<div class="menubar" aria-hidden="true"><span><Image src={mono} alt="" width={26} height={38} densities={[1, 2]} format="png" loading="eager" decoding="auto" /><b>Parc</b>{menus.map((menu) => <span class:list={{ 'mb-more': menu.more }}>{menu.label}</span>)}</span><span id="mbClock">Mon 9:41 AM</span></div>
<div class="wrap icons-row">
<div class="copy">
<p class="eyebrow">Icons</p>
<h2 class="h2">Ten icons for your Dock.</h2>
<p class="body">Settings → Icon. Try one on here; this tab wears it too.</p>
</div>
<div class="icons-picker">
<div class="icons" id="icons" role="radiogroup" aria-label="Parc icon">{ICONS.map((icon, i) => <button class="icon-pick" type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-icon={icon.file} data-src={icon.image.src}><Image src={icon.image} alt="" width={84} height={84} densities={[1, 2]} format="png" loading="lazy" decoding="async" /><span>{icon.label}</span></button>)}</div>
<div class="dock" aria-hidden="true"><i></i><i></i><span class="dock-app" id="dockApp"><Image src={dockIcon.image} alt="" width={64} height={64} densities={[1, 2]} format="png" loading="eager" decoding="auto" /></span><i></i><i></i></div>
</div>
</div>
</section>

<style>
.desk{position:relative;padding-block:150px 136px;background:radial-gradient(70% 85% at 88% 0%,rgba(80,112,230,.6) 0,rgba(80,112,230,0) 70%),radial-gradient(48% 55% at 6% 45%,rgba(176,64,143,.42) 0,rgba(176,64,143,0) 100%),#151A3E;color:#F4EFE4}
.desk::after{content:"";position:absolute;left:0;right:0;bottom:-11px;height:12px;background:url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2024%2012%27%20preserveAspectRatio=%27none%27%3E%3Cpath%20fill=%27%23151A3E%27%20d=%27M0%200H24L12%2012Z%27/%3E%3C/svg%3E") left top/24px 12px repeat-x;pointer-events:none}
.menubar{position:absolute;left:0;right:0;top:0;display:flex;justify-content:space-between;align-items:center;gap:20px;height:30px;padding:0 max(18px,env(safe-area-inset-right,0px)) 0 max(18px,env(safe-area-inset-left,0px));background:rgba(255,255,255,.12);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);font:500 13px/1 var(--sans);color:rgba(255,255,255,.92);white-space:nowrap;overflow:hidden}
.menubar > span{display:flex;align-items:center;gap:20px}
.menubar img{display:block;width:10px;height:auto;filter:brightness(0) invert(1)}
.menubar b{font-weight:700}
.desk .eyebrow{color:#A9B7FF}
.desk .body{color:#C9CCE0}
.desk .icon-pick{color:#DDE1F2}
.desk .icon-pick img{filter:drop-shadow(0 10px 16px rgba(0,0,0,.35))}
.desk .icon-pick[aria-checked="true"]{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.12)}
.desk .dock{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.12)}
.desk .dock-app::after{background:#F4EFE4}
.icons-row{display:flex;flex-wrap:wrap;align-items:center;gap:40px 64px}
.icons-row .copy{flex:1 1 300px;max-width:420px}
.icons-row .h2{font-size:clamp(38px,4vw,54px)}
.icons-picker{flex:999 1 520px;min-width:0}
.icons{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px 10px}
.icon-pick{display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 6px 10px;border:1.5px solid transparent;border-radius:18px;background:transparent;font-size:13px;font-weight:600;color:var(--text);transition:transform .35s var(--spring),border-color .25s,background-color .25s}
.icon-pick img{display:block;width:84px;height:84px;filter:drop-shadow(0 8px 14px rgba(24,32,58,.16))}
.icon-pick:hover{transform:translateY(-3px)}
.icon-pick[aria-checked="true"]{border-color:var(--navy);background:#FFFFFF}
.dock{display:flex;align-items:flex-end;justify-content:center;gap:12px;width:max-content;max-width:100%;margin:26px auto 0;padding:10px 14px;border:1px solid rgba(255,255,255,.7);border-radius:24px;background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:0 18px 40px rgba(24,32,58,.12),inset 0 0 0 .5px rgba(24,32,58,.08)}
.dock i{display:block;width:52px;height:52px;border-radius:13px;background:linear-gradient(160deg,#E8E2D6,#D4CCBD)}
.dock i:nth-child(2){background:linear-gradient(160deg,#CFE0F5,#A9C3E8)}
.dock i:nth-child(4){background:linear-gradient(160deg,#F5D9C8,#E9B79C)}
.dock-app{position:relative;width:64px;height:64px;margin:-6px -2px 0}
.dock-app img{display:block;width:64px;height:64px}
.dock-app::after{content:"";position:absolute;left:50%;bottom:-7px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--navy)}
@keyframes launch{0%,100%{transform:none}20%{transform:translateY(-26px)}40%{transform:none}58%{transform:translateY(-12px)}74%{transform:none}}
.dock-app.is-bouncing img{animation:launch 1s cubic-bezier(.3,.7,.4,1)}
@media (max-width:900px){.icons{grid-template-columns:repeat(5,minmax(0,1fr))}.icon-pick img{width:64px;height:64px}}
@media (max-width:640px){
  .desk{padding-block:118px 104px}
  .menubar .mb-more{display:none}
  .icons{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 4px}
  .icon-pick{padding:8px 2px}
  .icon-pick img{width:56px;height:56px}
  .dock i{width:40px;height:40px;border-radius:10px}
}
</style>

<script>
import { $, $$, reduced, remember } from '../scripts/dom';
import { chime, sfx } from '../scripts/sound';

const STEPS: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
const iconBox = $('#icons'), dockApp = $('#dockApp'), dockImg = $<HTMLImageElement>('img', dockApp), favicon = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
const iconButtons = $$<HTMLButtonElement>('.icon-pick', iconBox);
const icons = iconButtons.map((b) => ({ file: b.dataset.icon ?? '', src: b.dataset.src ?? '' }));

function pickIcon(i: number, chosen: boolean) {
  const { file, src } = icons[i];
  iconButtons.forEach((b, j) => { b.setAttribute('aria-checked', String(j === i)); b.tabIndex = j === i ? 0 : -1; });
  dockImg.removeAttribute('srcset');
  dockImg.src = src;
  if (favicon) favicon.href = src;
  if (!chosen) return;
  remember('parc-icon', file);
  sfx(() => chime([659.25, 987.77], .07, .08));
  if (!reduced) { dockApp.classList.remove('is-bouncing'); void dockApp.offsetWidth; dockApp.classList.add('is-bouncing'); }
}

iconButtons.forEach((b, i) => b.addEventListener('click', () => pickIcon(i, true)));
iconBox.addEventListener('keydown', (e) => {
  const i = iconButtons.findIndex((b) => b === document.activeElement); if (i < 0) return;
  const d = STEPS[e.key]; if (!d) return;
  e.preventDefault(); const n = (i + d + icons.length) % icons.length; pickIcon(n, true); iconButtons[n].focus();
});
const saved = remember('parc-icon');
pickIcon(Math.max(0, icons.findIndex(({ file }) => file === saved)), false);

const clock = document.getElementById('mbClock');
if (clock) {
  const tick = () => { clock.textContent = new Date().toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit' }); };
  tick(); setInterval(tick, 30000);
}
</script>

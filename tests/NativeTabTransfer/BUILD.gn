# Install at //cef/tests/parc_native_tab_transfer and add its unit_tests target
# to //chrome/test:unit_tests only on macOS with enable_cef.
assert(is_mac)

source_set("unit_tests") {
  testonly = true
  sources = [ "tab_transfer_unittest.cc" ]
  include_dirs = [ "//cef/libcef/browser/parc_native" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//cef/libcef/browser/parc_native:tab_transfer",
    "//chrome/browser/ui:unload_controller",
    "//chrome/browser/ui:unload_controller_impl",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test/base:browser_with_test_window_test",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

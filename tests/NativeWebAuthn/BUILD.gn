# Map to //parc/tests/parc_native_webauthn. Actual request/model/UI tests share
# the production native service, without linking libcef_static into Chrome tests.
assert(is_mac)
source_set("unit_tests") {
  testonly = true
  sources = [ "request_unittest.mm" ]
  include_dirs = [ "//parc/native" ]
  frameworks = [ "AppKit.framework" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//parc/native:native_components",
    "//parc/native:native_webauthn",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/webauthn",
    "//chrome/browser/webauthn",
    "//chrome/browser/webauthn:impl",
    "//chrome/test/base:browser_with_test_window_test",
    "//components/web_modal",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/views",
    "//url",
  ]
}

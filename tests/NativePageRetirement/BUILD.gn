# Installed at //parc/tests/parc_native_page_retirement.
# Add to //chrome/test:unit_tests only for macOS builds with enable_parc.
assert(is_mac)

source_set("unit_tests") {
  testonly = true
  sources = [ "unload_preflight_unittest.cc" ]
  include_dirs = [ "//parc/native" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//parc/native:tab_retirement",
    "//chrome/browser/ui:unload_controller",
    "//chrome/browser/ui:unload_controller_impl",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test/base:browser_with_test_window_test",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

# Installed by the reviewed overlay at //parc/tests/parc_native_extensions.
# Native extension tests, consumed by //chrome/test:browser_tests on macOS.
assert(is_mac)

source_set("popup_browser_tests") {
  testonly = true

  # The consuming browser_tests binary isolates each case in a child process.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "extension_popup_browsertest.mm" ]
  include_dirs = [ "//parc/native" ]
  frameworks = [ "AppKit.framework" ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//parc/native:native_extensions",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//extensions:test_support",
    "//extensions/common",
    "//testing/gtest",
  ]
}


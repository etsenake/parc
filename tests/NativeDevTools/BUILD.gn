# Map to //parc/tests/parc_native_devtools; consume in chrome/test:browser_tests.
assert(is_mac)

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "devtools_browsertest.mm", "auxiliary_browsertest.mm" ]
  include_dirs = [ "//parc/native" ]
  frameworks = [ "AppKit.framework" ]
  deps = [
    "//parc/native:native_auxiliary_page",
    "//parc/native:native_auxiliary_services",
    "//parc/native:native_downloads",
    "//chrome/browser/ui:browser_window_header",
    "//components/javascript_dialogs",
    "//components/tabs:public",
    "//ui/shell_dialogs",
    "//base",
    "//base/test:test_support",
    "//parc/native:native_components",
    "//parc/native:native_devtools",
    "//chrome/browser/devtools",
    "//chrome/browser/devtools:test_support",
    "//chrome/browser/ui/browser_web_contents_delegate",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window/internal",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/web_modal:browser_window_modal_dialog_delegate",
    "//chrome/test:test_support",
    "//components/web_modal",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base/unowned_user_data",
  ]
}

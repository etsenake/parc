# Installed at //cef/tests/parc_native_permissions and linked into genuine
# //chrome/test:unit_tests on macOS CEF builds. No libcef_static dependency.
assert(is_mac)

source_set("unit_tests") {
  testonly = true
  sources = [ "permission_prompt_unittest.mm" ]
  include_dirs = [ "//cef/libcef/browser/parc_native" ]
  frameworks = [ "AppKit.framework" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//cef/libcef/browser/parc_native:native_components",
    "//cef/libcef/browser/parc_native:native_permissions",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/content_settings:content_settings_factory_impl",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test/base:browser_with_test_window_test",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/permissions",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
